@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Earthland

id:world-earthland a oa:Place, oa:World ;
    skos:prefLabel "Earthland" ;
    oa:article <https://www.orionsarm.com/eg-article/50c7400a01dfc> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-earthland a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/50c7400a01dfc> ;
    oa:about id:world-earthland ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Taurus" ;
    oa:distance value:location-world-earthland-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-earthland-distance a oa:QuantityValue ;
    qudt:numericValue 732.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-earthland-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/50c7400a01dfc> ;
    oa:about id:world-earthland ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-earthland-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/50c7400a01dfc> ;
    oa:about id:world-earthland ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Circa ;
    oa:recordOrder 0 ;
    oa:yearAT 3501 .
