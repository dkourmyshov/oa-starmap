@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Locality of Wolfra

id:world-locality-of-wolfra a oa:Place, oa:World ;
    skos:prefLabel "Locality of Wolfra" ;
    oa:article <https://www.orionsarm.com/eg-article/464ba71b5823e> ;
    oa:kind "polity_marker" ;
    oa:labelsSystem false ;
    oa:note "The largest organised polity within the Disarchy, and with no article of its own — the Disarchy's is what describes it." ;
    oa:uncertain false .

claim:location-world-locality-of-wolfra a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464ba71b5823e> ;
    oa:about id:world-locality-of-wolfra ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -58.0 ;
    oa:distance value:location-world-locality-of-wolfra-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "Was an interpolation from the transcription of Anders Sandberg's maps, at 3114 ly with a wide error. The position is now from the Orion's Arm Celestia add-ons' location catalogues (OAAddons9, OALocationsv4; extracted to sources/derived/oa_dsc_locations.tsv), which the star importer never read because it takes only .stc files. The add-on catalogues are the preferred source for a volume of this kind whatever the two happen to agree on: the Anders map is known to be unreliable about where an individual system or world sits, and only somewhat better about polities. That they fall 3 degrees apart here is a comfort rather than an argument — the same interpolation was 41 degrees and a factor of seven out for Aries Vector, and one agreement does not make a method." ;
    oa:rightAscensionDeg 205.5 .

value:location-world-locality-of-wolfra-distance a oa:QuantityValue ;
    qudt:numericValue 3200.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-locality-of-wolfra-disarchy a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464ba71b5823e> ;
    oa:about id:world-locality-of-wolfra ;
    oa:canonical true ;
    oa:polity id:polity-disarchy ;
    oa:recordOrder 0 .
