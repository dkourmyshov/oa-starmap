# Galrecon

id:world-galrecon a oa:Place, oa:World ;
    skos:prefLabel "Galrecon" ;
    oa:article <https://www.orionsarm.com/eg-article/53a6cc7e2c0f4> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Auriga at 245 ly." ;
    oa:uncertain false .

claim:location-world-galrecon a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/53a6cc7e2c0f4> ;
    oa:about id:world-galrecon ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 33503 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-galrecon-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/53a6cc7e2c0f4> ;
    oa:about id:world-galrecon ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-galrecon-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/53a6cc7e2c0f4> ;
    oa:about id:world-galrecon ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2598 .
