claim:event-world-gordelpus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f96acd05bb3> ;
    oa:about id:world-gordelpus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Central MPA system, colonized by the Kathelian Confederacy in the 2700's.\" The Confederacy is an MPA polity, per the timeline." ;
