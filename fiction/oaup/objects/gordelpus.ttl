claim:event-world-gordelpus-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-gordelpus ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The new STC-aligned Erniac government came into conflict with pro- Negentropic and pro-Keterist influences, weakening the political market and allowing the Sonato system to buy the polityship in 6433.\" New against the header, which records only 'settled 2700' and 'settled 2790'. 'The Sonato system' is not a roster polity (see unplaced), so polity is left blank. To the Sonato system, no polity of this file, after the STC-aligned Erniac government's conflicts." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Establishment" ;
    oa:yearAT 2790 .
