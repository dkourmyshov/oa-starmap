# Abruzzen

id:world-abruzzen a oa:Place, oa:World ;
    skos:prefLabel "Abruzzen" ;
    oa:article <https://www.orionsarm.com/eg-article/45e399a00e9e7> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Pisces at 744 ly." ;
    oa:uncertain false .

claim:location-world-abruzzen a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e399a00e9e7> ;
    oa:about id:world-abruzzen ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 2914 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-abruzzen-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e399a00e9e7> ;
    oa:about id:world-abruzzen ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-abruzzen-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e399a00e9e7> ;
    oa:about id:world-abruzzen ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 3644 .
