claim:location-world-amaterasu a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0caf586812> ;
    oa:about id:world-amaterasu ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 31292 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-amaterasu-solar-dominion a prov:Entity, oa:AffiliationClaim ;
