# Barawatten

id:world-barawatten a oa:Place, oa:World ;
    skos:prefLabel "Barawatten" ;
    oa:article <https://www.orionsarm.com/eg-article/4609c7a409fbf> ;
    oa:kind "moon" ;
    oa:labelsSystem false ;
    oa:note "A moon of the gas giant Garell, at 70 Ophiuchi, 17 ly." ;
    oa:parentName "Garell" ;
    oa:uncertain false .

claim:location-world-barawatten a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c7a409fbf> ;
    oa:about id:world-barawatten ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "70 Ophiuchi" .

claim:affiliation-world-barawatten-keter-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c7a409fbf> ;
    oa:about id:world-barawatten ;
    oa:canonical true ;
    oa:polity id:polity-keter-dominion ;
    oa:recordOrder 0 .

claim:event-world-barawatten-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c7a409fbf> ;
    oa:about id:world-barawatten ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 1644 .

claim:event-world-barawatten-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c7a409fbf> ;
    oa:about id:world-barawatten ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "\"In 1644 AT the Klarawappen habitat mysteriously vanished ; the most likely explanation is that the colonists decided to suddenly migrate to the Oort Cloud to become Hiders , but no evidence for this move has ever been found.\" The header records this year as 'settled 1644', but the only sentence carrying that year describes a habitat vanishing, not a settlement. 'Abandoned' is a best-fit label for a speculative, unconfirmed departure — see contradictions and doubts. No settlement year is given anywhere in the article. The Klarawappen habitat 'mysteriously vanished'; the map's older 'settled 1644' is this same sentence read the other way, and the article gives no settlement year." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1644 .
