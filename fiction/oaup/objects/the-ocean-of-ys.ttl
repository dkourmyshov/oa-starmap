    oa:recordOrder 0 .

claim:event-world-the-ocean-of-ys-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/591f39b037a27> ;
    oa:about id:world-the-ocean-of-ys ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3500 .

claim:event-world-the-ocean-of-ys-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/591f39b037a27> ;
    oa:about id:world-the-ocean-of-ys ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The next big change came in 5453, when, after a period of negotiation with the current inhabitants, a siblinghood of young Amphisapien colonists from the Zoeific Biopolity arrived in system.\" Not in the header. A second wave of colonists, explicitly said to be 'from the Zoeific Biopolity', who stayed and founded a lasting new culture ('For the next centuries a new culture blossomed'); recorded as settled rather than visited on that basis. Consistent with the data panel's undated 'Allegiance Zoefic Biopolity'. Amphisapien colonists from the Biopolity, after negotiation with the inhabitants; the earlier colonists of 3500 were Madi from the Deeper Covenant." ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 5453 .
