# The Ocean of Ys

id:world-the-ocean-of-ys a oa:Place, oa:World ;
    skos:prefLabel "The Ocean of Ys" ;
    oa:article <https://www.orionsarm.com/eg-article/591f39b037a27> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "HD 181144 in Sagitta, the article's 119 ly against the catalogue's 118." ;
    oa:uncertain false .

claim:location-world-the-ocean-of-ys a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/591f39b037a27> ;
    oa:about id:world-the-ocean-of-ys ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-the-ocean-of-ys-distance ;
    oa:hdId 181144 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-the-ocean-of-ys-distance a oa:QuantityValue ;
    qudt:numericValue 119.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-the-ocean-of-ys-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/591f39b037a27> ;
    oa:about id:world-the-ocean-of-ys ;
    oa:canonical true ;
