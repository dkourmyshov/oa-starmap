# Kuranaba

id:world-kuranaba a oa:Place, oa:World ;
    skos:prefLabel "Kuranaba" ;
    oa:article <https://www.orionsarm.com/eg-article/46749a8d00410> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-kuranaba a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46749a8d00410> ;
    oa:about id:world-kuranaba ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -31.212711389 ;
    oa:distance value:location-world-kuranaba-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "The direction is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from the archived Wormhole Gazetteer (https://www.orionsarm.com/eg-article/4e297b0884b1a); the distance is the article's own 209 ly. The two sources do not otherwise agree, and neither is bound to: the article gives the star as TYC 5978-3659-1, the add-on gives TYC 7074-1427-1, and the add-on puts the system at 409 ly rather than 209. Both spell it Kurabana, where the article and this file spell it Kuranaba. Taken as one place under two spellings, with the Encyclopaedia keeping the distance and the add-on supplying the direction it never had — though that direction is 3.1 degrees from Big Tor, the system Kuranaba's first gate was opened from, which is close enough that the add-on may have derived it from the link rather than known it. See questions.md." ;
    oa:rightAscensionDeg 98.966461667 .

value:location-world-kuranaba-distance a oa:QuantityValue ;
    qudt:numericValue 209.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-kuranaba-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46749a8d00410> ;
    oa:about id:world-kuranaba ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 0 .

claim:event-world-kuranaba-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46749a8d00410> ;
    oa:about id:world-kuranaba ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2589 .
