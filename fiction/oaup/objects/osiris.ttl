@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Osiris

id:world-osiris a oa:Place, oa:World ;
    skos:prefLabel "Osiris" ;
    oa:article <https://www.orionsarm.com/eg-article/4910dfd470715> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "HD 209458 in Pegasus, 157 ly out — the star of the first exoplanet whose atmosphere was ever measured, and the Panvirtuality's now." ;
    oa:uncertain false .

claim:location-world-osiris a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910dfd470715> ;
    oa:about id:world-osiris ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 209458" .

claim:affiliation-world-osiris-solipsist-panvirtuality a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910dfd470715> ;
    oa:about id:world-osiris ;
    oa:canonical true ;
    oa:polity id:polity-solipsist-panvirtuality ;
    oa:recordOrder 0 .
