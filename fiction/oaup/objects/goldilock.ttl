@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Goldilock

id:world-goldilock a oa:Place, oa:World ;
    skos:altLabel "Goldilocks" ;
    skos:prefLabel "Goldilock" ;
    oa:article <https://www.orionsarm.com/eg-article/48fa71d44bc7a> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "70 Virginis, and the catalogue agrees with the article to two decimals at 59.03 ly. No colonisation date given. Not the Solar Dominion's Goldilocks ISO, which is a different place." ;
    oa:uncertain false .

claim:location-world-goldilock a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa71d44bc7a> ;
    oa:about id:world-goldilock ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-goldilock-distance ;
    oa:hipparcosId 65721 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-goldilock-distance a oa:QuantityValue ;
    qudt:numericValue 59.03 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-goldilock-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa71d44bc7a> ;
    oa:about id:world-goldilock ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .
