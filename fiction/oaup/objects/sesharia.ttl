# Sesharia

id:world-sesharia a oa:Place, oa:World ;
    skos:prefLabel "Sesharia" ;
    oa:article <https://www.orionsarm.com/eg-article/48f94f1a7f8db> ;
    oa:kind "moon" ;
    oa:labelsSystem false ;
    oa:note "A moon of the gas giant Thraub. The article gives GL 86 and HR 637 while the colony table resolves the same colony to Gliese 54 A at 27 ly; the two designations disagree and the table's is the one bound here. A former Doran Empire world and its frontier with the Eridanus League; the article gives no date for its passing to the Non-Coercive Zone, only that the Doran Empire fragmented over the following two millennia." ;
    oa:parentName "Thraub" ;
    oa:uncertain false .

claim:location-world-sesharia a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f94f1a7f8db> ;
    oa:about id:world-sesharia ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 54" .

claim:affiliation-world-sesharia-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f94f1a7f8db> ;
    oa:about id:world-sesharia ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-sesharia-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f94f1a7f8db> ;
    oa:about id:world-sesharia ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "The data panel: \"1102 AT by the Doran empire colony ship Zschorn\". The article's own history section has the Dorans \"arriving at HR 637 in 1133 AT\" instead; the panel's date is the one recorded." ;
    oa:polity id:polity-doran-empire ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1102 .

claim:event-world-sesharia-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f94f1a7f8db> ;
    oa:about id:world-sesharia ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "A second arrival, not the first: a Novamedia/Birnam Ecotech-sponsored ship brought the Bluesky sect, who built the first worldhouses." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1599 .
