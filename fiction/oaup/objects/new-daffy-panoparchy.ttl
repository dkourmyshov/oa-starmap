@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# New Daffy Panoparchy

id:world-new-daffy-panoparchy a oa:Place, oa:World ;
    skos:prefLabel "New Daffy Panoparchy" ;
    oa:article <https://www.orionsarm.com/eg-article/46d4c2fc470c7> ;
    oa:kind "polity_marker" ;
    oa:labelsSystem false ;
    oa:note "A superpolity of heterodox Negentropists, and a volume rather than a point — but no extent is given, so it is drawn as a marker." ;
    oa:uncertain false .

claim:location-world-new-daffy-panoparchy a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d4c2fc470c7> ;
    oa:about id:world-new-daffy-panoparchy ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Circinus" ;
    oa:distance value:location-world-new-daffy-panoparchy-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-new-daffy-panoparchy-distance a oa:QuantityValue ;
    qudt:numericValue 2234.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-new-daffy-panoparchy-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d4c2fc470c7> ;
    oa:about id:world-new-daffy-panoparchy ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .

claim:event-world-new-daffy-panoparchy-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d4c2fc470c7> ;
    oa:about id:world-new-daffy-panoparchy ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 6230 .
