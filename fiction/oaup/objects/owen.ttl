@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Owen

id:world-owen a oa:Place, oa:World ;
    skos:prefLabel "Owen" ;
    oa:article <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Named as HD 160519, which is in Ara as the article says, but at 287 ly rather than the 387 given — too wide a gap to bind across, so the star supplies the direction and the article the distance. An honorary part of the Archosaurian Empire while remaining Utopian." ;
    oa:uncertain false .

claim:location-world-owen a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:about id:world-owen ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -55.629 ;
    oa:distance value:location-world-owen-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "HD 160519" ;
    oa:rightAscensionDeg 265.8848 .

value:location-world-owen-distance a oa:QuantityValue ;
    qudt:numericValue 387.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-owen-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:about id:world-owen ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-owen-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:about id:world-owen ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4296 .

claim:event-world-owen-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:about id:world-owen ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The Jurassica Institute's expedition ship, at a speed just under 0.7c, reached HD 160519 on 3937 AT.\" The very next sentence says the arriving uploads, aioids, and hyperturings 'had no trouble setting up infrastructure' on the fourth planet, so this reads as the actual colonists staying, not a mere visit. The Jurassica Institute is not a roster polity, see unplaced. The Jurassica Institute's expedition; the panel's 'Colonized: 4296' is kept beside it, and neither the 4195 oxygen milestone nor the 4384 completion of terraforming matches either." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 3937 .

claim:event-world-owen-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:about id:world-owen ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "\"Evacuated: 4853 AT\" See doubts: the body suggests this was the departure of the neosaurian provolve population specifically, not a full depopulation of the system. The neosaurians' fleet departed for Ruprecht 108; the body implies caretakers stayed and repopulation followed." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 4853 .

claim:event-world-owen-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/475d8f392ccca> ;
    oa:about id:world-owen ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"During the Version War , Owen officially aligned itself with the Utopia Sphere, one of the neutral Sephirotic empires which were non- combatants in that conflict.\" No exact year is given for the alignment itself; it is bounded by the following sentence, 'In 4699 AT, after the war, a Utopian linelayer reached the system', so not_later_than 4699 is used. Matches the header's 'filed under: Utopia Sphere'. During the Version War; the 5687 declaration of the system as 'an honorary part of the Archosaurian Empire' is left to the readings, honorary affiliation being a marker this map does not draw." ;
    oa:polity id:polity-utopia-sphere ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 3 ;
    oa:yearAT 4699 .
