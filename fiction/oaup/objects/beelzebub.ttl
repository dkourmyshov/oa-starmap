@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Beelzebub

id:world-beelzebub a oa:Place, oa:World ;
    skos:prefLabel "Beelzebub" ;
    oa:article <https://www.orionsarm.com/eg-article/461707a3ab1e3> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-beelzebub a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/461707a3ab1e3> ;
    oa:about id:world-beelzebub ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Canis Major" ;
    oa:distance value:location-world-beelzebub-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-beelzebub-distance a oa:QuantityValue ;
    qudt:numericValue 805.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-beelzebub-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/461707a3ab1e3> ;
    oa:about id:world-beelzebub ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .

claim:event-world-beelzebub-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/461707a3ab1e3> ;
    oa:about id:world-beelzebub ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3709 .

claim:event-world-beelzebub-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/461707a3ab1e3> ;
    oa:about id:world-beelzebub ;
    oa:canonical true ;
    oa:eventKind oa:Stewardship ;
    oa:note "\"Many wars were fought in this system, until a tribunal of Caretaker God transapients declared the world off-limits to outsiders in 7909AT.\" Not present in the header's already-dated list (which only has settled 3709); this is a new dated claim for the reviewer." ;
    oa:polity id:polity-caretaker-gods ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 7909 .
