@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Dashwood

id:world-dashwood a oa:Place, oa:World ;
    skos:prefLabel "Dashwood" ;
    oa:article <https://www.orionsarm.com/eg-article/4637c48b18ab6> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-dashwood a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4637c48b18ab6> ;
    oa:about id:world-dashwood ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Centaurus" ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In the Centauri sector — a sector being the volume behind that constellation as seen from Earth. Near the borders with the Paradigm and the Utopia Sphere, which are volumes rather than directions. No distance is given, so the direction is all there is: a cone from Sol, not a point." .

claim:affiliation-world-dashwood-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4637c48b18ab6> ;
    oa:about id:world-dashwood ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .
