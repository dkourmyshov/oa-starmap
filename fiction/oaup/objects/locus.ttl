@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Locus

id:world-locus a oa:Place, oa:World ;
    skos:prefLabel "Locus" ;
    oa:article <https://www.orionsarm.com/eg-article/4eb9314768886> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-locus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4eb9314768886> ;
    oa:about id:world-locus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Cancer" ;
    oa:distance value:location-world-locus-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-locus-distance a oa:QuantityValue ;
    qudt:numericValue 2221.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-locus-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4eb9314768886> ;
    oa:about id:world-locus ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-locus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4eb9314768886> ;
    oa:about id:world-locus ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 6207 .

claim:event-world-locus-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-locus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Locus colonised." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Separate Empires" ;
    oa:yearAT 6207 .
