@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Hyvixnym

id:world-hyvixnym a oa:Place, oa:World ;
    skos:prefLabel "Hyvixnym" ;
    oa:article <https://www.orionsarm.com/eg-article/692a119117331> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "A rogue planet, bound to no star." ;
    oa:uncertain false .

claim:location-world-hyvixnym a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/692a119117331> ;
    oa:about id:world-hyvixnym ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Taurus" ;
    oa:distance value:location-world-hyvixnym-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-hyvixnym-distance a oa:QuantityValue ;
    qudt:numericValue 3876.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-hyvixnym-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/692a119117331> ;
    oa:about id:world-hyvixnym ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .

claim:event-world-hyvixnym-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/692a119117331> ;
    oa:about id:world-hyvixnym ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Explored and sampled by a probe." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7950 .

claim:event-world-hyvixnym-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/692a119117331> ;
    oa:about id:world-hyvixnym ;
    oa:canonical true ;
    oa:eventKind oa:Stewardship ;
    oa:note "A Caretaker God assumed stewardship." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 8002 .
