# Zhang Qian

id:world-zhang-qian a oa:Place, oa:World ;
    skos:prefLabel "Zhang Qian" ;
    oa:article <https://www.orionsarm.com/eg-article/4f85f3c217bbd> ;
    oa:editorialNote "---- Solar Dominion ------------------------------------------------------\n\nSeveral of these are systems already on the map under another empire, and\nstay so: Macrystis is a Caretaker world the Dominion reached in 5393, and\nZeta-1 Reticuli now carries three named places belonging to three\nmeta-empires." ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-zhang-qian a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f85f3c217bbd> ;
    oa:about id:world-zhang-qian ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "571 ly from Sol, with no direction given." .

claim:affiliation-world-zhang-qian-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f85f3c217bbd> ;
    oa:about id:world-zhang-qian ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:affiliation-world-zhang-qian-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f85f3c217bbd> ;
    oa:about id:world-zhang-qian ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 1 .

claim:event-world-zhang-qian-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f85f3c217bbd> ;
    oa:about id:world-zhang-qian ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
