@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Oia

id:world-oia a oa:Place, oa:World ;
    skos:prefLabel "Oia" ;
    oa:article <https://www.orionsarm.com/eg-article/48f952ba9a1f9> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Originally a Sophic League colony and possibly still tied to it, so both are recorded. The name descends from a word meaning \"here\"." ;
    oa:uncertain false .

claim:location-world-oia a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f952ba9a1f9> ;
    oa:about id:world-oia ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Puppis" ;
    oa:distance value:location-world-oia-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-oia-distance a oa:QuantityValue ;
    qudt:numericValue 2101.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-oia-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f952ba9a1f9> ;
    oa:about id:world-oia ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:affiliation-world-oia-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f952ba9a1f9> ;
    oa:about id:world-oia ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 1 .

claim:event-world-oia-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f952ba9a1f9> ;
    oa:about id:world-oia ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:polity id:polity-sophic-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5411 .
