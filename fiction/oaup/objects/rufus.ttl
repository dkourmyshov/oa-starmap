@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Rufus

id:world-rufus a oa:Place, oa:World ;
    skos:prefLabel "Rufus" ;
    oa:article <https://www.orionsarm.com/eg-article/4a3bb4ef0f54d> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Centaurus at 82 ly." ;
    oa:uncertain false .

claim:location-world-rufus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a3bb4ef0f54d> ;
    oa:about id:world-rufus ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 114853 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-rufus-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a3bb4ef0f54d> ;
    oa:about id:world-rufus ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-rufus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a3bb4ef0f54d> ;
    oa:about id:world-rufus ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1899 .

claim:event-world-rufus-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a3bb4ef0f54d> ;
    oa:about id:world-rufus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The First Federation colony ship Actaeon, funded by Hantec Inc. from Caneshe Habitat in the Earth's Trojan Point, arrived at HD 114853 in 1899 AT.\" Header already records this as 'visited 1899'; the prose describes colonists who stayed and began terraforming, which reads as a settlement rather than a mere visit. Written as settled and flagged for review, not resolved. The Actaeon, funded by Hantec Inc.; the map's older 'visited 1899' is this arrival." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1899 .
