@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Webistics

id:world-webistics a oa:Place, oa:World ;
    skos:prefLabel "Webistics" ;
    oa:article <https://www.orionsarm.com/eg-article/47000688d2cf2> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-webistics a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47000688d2cf2> ;
    oa:about id:world-webistics ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "No position given." .

claim:affiliation-world-webistics-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47000688d2cf2> ;
    oa:about id:world-webistics ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .
