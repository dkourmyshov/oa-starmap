@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Manyanga

id:world-manyanga a oa:Place, oa:World ;
    skos:prefLabel "Manyanga" ;
    oa:article <https://www.orionsarm.com/eg-article/46afd40377e48> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Vela, from coordinates and a distance both." ;
    oa:uncertain false .

claim:location-world-manyanga a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46afd40377e48> ;
    oa:about id:world-manyanga ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -49.415 ;
    oa:distance value:location-world-manyanga-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 161.6583 .

value:location-world-manyanga-distance a oa:QuantityValue ;
    qudt:numericValue 2108.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-manyanga-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46afd40377e48> ;
    oa:about id:world-manyanga ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .
