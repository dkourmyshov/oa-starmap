# Pereira

id:world-pereira a oa:Place, oa:World ;
    skos:prefLabel "Pereira" ;
    oa:article <https://www.orionsarm.com/eg-article/47bf772c4ab92> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Galactic coordinates given outright — 995, 1016, -180 ly — which return 1,433 ly in Aquila, the distance and constellation the article also states. Three holders are recorded because three are named, but the article gives a share to none of them: a good part of the world answers to nobody, and this file has no way to draw that." ;
    oa:uncertain false .

claim:location-world-pereira a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47bf772c4ab92> ;
    oa:about id:world-pereira ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 7.8365 ;
    oa:distance value:location-world-pereira-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 295.1543 .

value:location-world-pereira-distance a oa:QuantityValue ;
    qudt:numericValue 1433.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

