    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Norma at 192 ly." ;
    oa:uncertain false .

claim:location-world-greylag a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f96df6b0a13> ;
    oa:about id:world-greylag ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 147436 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-greylag-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f96df6b0a13> ;
    oa:about id:world-greylag ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .

claim:event-world-greylag-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f96df6b0a13> ;
    oa:about id:world-greylag ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:polity id:polity-negentropy-alliance ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
