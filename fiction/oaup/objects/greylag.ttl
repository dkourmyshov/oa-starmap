claim:event-world-greylag-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-greylag ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "The Ken Ferjik Museum Ship reaches Irrmorella, a small system about 15 LY Solward of Greylag." ;
