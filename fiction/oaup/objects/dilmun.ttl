@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Dilmun

id:world-dilmun a oa:Place, oa:World ;
    skos:prefLabel "Dilmun" ;
    oa:article <https://www.orionsarm.com/eg-article/5492c26f88619> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-dilmun a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5492c26f88619> ;
    oa:about id:world-dilmun ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 24.211 ;
    oa:distance value:location-world-dilmun-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "Was Gemini and a distance, which is a cone 2101.8 ly deep. The direction is from the Orion's Arm Celestia add-ons' location catalogues (OAAddons9, OALocationsv4; extracted to sources/derived/oa_dsc_locations.tsv), which the star importer never read because it takes only .stc files. It falls 3 degrees from the centre of Gemini against that constellation's radius of 16, so it agrees with the cone it replaces, and the catalogue's own distance of 2101.8 ly agrees with the article's." ;
    oa:rightAscensionDeg 110.85 .

value:location-world-dilmun-distance a oa:QuantityValue ;
    qudt:numericValue 2101.8 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-dilmun-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5492c26f88619> ;
    oa:about id:world-dilmun ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-dilmun-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5492c26f88619> ;
    oa:about id:world-dilmun ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:polity id:polity-metasoft ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5390 .
