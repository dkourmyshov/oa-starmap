@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Jhairrn

id:world-jhairrn a oa:Place, oa:World ;
    skos:prefLabel "Jhairrn" ;
    oa:article <https://www.orionsarm.com/eg-article/4682f0a28416c> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Near the Negentropy Alliance border." ;
    oa:uncertain false .

claim:location-world-jhairrn a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4682f0a28416c> ;
    oa:about id:world-jhairrn ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Circinus" ;
    oa:distance value:location-world-jhairrn-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-jhairrn-distance a oa:QuantityValue ;
    qudt:numericValue 720.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-jhairrn-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4682f0a28416c> ;
    oa:about id:world-jhairrn ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-jhairrn-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4682f0a28416c> ;
    oa:about id:world-jhairrn ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3444 .
