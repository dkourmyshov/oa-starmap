# Valdern Megastructure

id:world-valdern-megastructure a oa:Place, oa:World ;
    skos:prefLabel "Valdern Megastructure" ;
    oa:article <https://www.orionsarm.com/eg-article/6929fe0e1f632> ;
    oa:editorialNote "---- The Seams -----------------------------------------------------------" ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "Around the star Erythail. The article's coordinates fall in Monoceros, as it says." ;
    oa:uncertain false .

claim:location-world-valdern-megastructure a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/6929fe0e1f632> ;
    oa:about id:world-valdern-megastructure ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -4.1194 ;
    oa:distance value:location-world-valdern-megastructure-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "Erythail" ;
    oa:rightAscensionDeg 91.1375 .

value:location-world-valdern-megastructure-distance a oa:QuantityValue ;
    qudt:numericValue 1210.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-valdern-megastructure-orion-federation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/6929fe0e1f632> ;
    oa:about id:world-valdern-megastructure ;
    oa:canonical true ;
    oa:polity id:polity-orion-federation ;
    oa:recordOrder 0 .

claim:event-world-valdern-megastructure-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/6929fe0e1f632> ;
    oa:about id:world-valdern-megastructure ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4879 .

claim:event-world-valdern-megastructure-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/6929fe0e1f632> ;
    oa:about id:world-valdern-megastructure ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The Erythail system was colonised by the newly emerging Orion Federation in 4879 AT , during the ComEmp period .\" 'The newly emerging Orion Federation'; the map's older 'visited 4879' is the panel's 'Reached'." ;
    oa:polity id:polity-orion-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 4879 .
