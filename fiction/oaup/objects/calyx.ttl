@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Calyx

id:world-calyx a oa:Place, oa:World ;
    skos:prefLabel "Calyx" ;
    oa:article <https://www.orionsarm.com/eg-article/4f438057ece53> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Lyra at 985 ly." ;
    oa:uncertain false .

claim:location-world-calyx a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f438057ece53> ;
    oa:about id:world-calyx ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Lyra" ;
    oa:distance value:location-world-calyx-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-calyx-distance a oa:QuantityValue ;
    qudt:numericValue 985.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-calyx-cygexpa a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f438057ece53> ;
    oa:about id:world-calyx ;
    oa:canonical true ;
    oa:polity id:polity-cygexpa ;
    oa:recordOrder 0 .

claim:event-world-calyx-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f438057ece53> ;
    oa:about id:world-calyx ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Settled by a minor franchise of Cygexpa." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4285 .
