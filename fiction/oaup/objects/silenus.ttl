@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Silenus

id:world-silenus a oa:Place, oa:World ;
    skos:prefLabel "Silenus" ;
    oa:article <https://www.orionsarm.com/eg-article/4ac1fabd2c3c0> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Cassiopeia at 391 ly." ;
    oa:uncertain false .

claim:location-world-silenus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ac1fabd2c3c0> ;
    oa:about id:world-silenus ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 12820 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-silenus-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ac1fabd2c3c0> ;
    oa:about id:world-silenus ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-silenus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ac1fabd2c3c0> ;
    oa:about id:world-silenus ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3190 .

claim:event-world-silenus-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-silenus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Silenus colonised by the Solar Dominion." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Consolidation" ;
    oa:yearAT 3575 .
