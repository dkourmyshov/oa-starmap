claim:event-world-republic-of-bethsyngaria-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52d6a4ff29392> ;
    oa:about id:world-republic-of-bethsyngaria ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
