# Republic of Bethsyngaria

id:world-republic-of-bethsyngaria a oa:Place, oa:World ;
    skos:prefLabel "Republic of Bethsyngaria" ;
    oa:article <https://www.orionsarm.com/eg-article/52d6a4ff29392> ;
    oa:kind "polity_marker" ;
    oa:labelsSystem false ;
    oa:note "A polity of four systems." ;
    oa:uncertain false .

claim:location-world-republic-of-bethsyngaria a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52d6a4ff29392> ;
    oa:about id:world-republic-of-bethsyngaria ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Carina" ;
    oa:distance value:location-world-republic-of-bethsyngaria-distance ;
    oa:knownDistanceConflict false ;
