# Schaiffer's World

id:world-schaiffer-s-world a oa:Place, oa:World ;
    skos:prefLabel "Schaiffer's World" ;
    oa:article <https://www.orionsarm.com/eg-article/4782f7e4b314a> ;
    oa:kind "moon" ;
    oa:labelsSystem false ;
    oa:note "A moon of a superterrestrial planet. The article names the star four ways — Gl 830, HD 204587, BD -13 5945 and HIP 106147 — and all four are the same red dwarf in Capricornus, 58 ly out." ;
    oa:uncertain false .

claim:location-world-schaiffer-s-world a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4782f7e4b314a> ;
    oa:about id:world-schaiffer-s-world ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gl 830" .

claim:affiliation-world-schaiffer-s-world-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4782f7e4b314a> ;
    oa:about id:world-schaiffer-s-world ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-schaiffer-s-world-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4782f7e4b314a> ;
    oa:about id:world-schaiffer-s-world ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"First Federation scientific outpost, later settled by rianth refugees, now a mixed population Utopia Sphere world and center of 'Splice Church' Universalism.\" The article's only sentence of history; the bounds are the Federation's own years. The rianth settlement and the Utopia Sphere's accession are undated." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
    oa:untilAT 2099 ;
    oa:yearAT 933 .
