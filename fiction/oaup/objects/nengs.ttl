@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Nengs

id:world-nengs a oa:Place, oa:World ;
    skos:prefLabel "Nengs" ;
    oa:article <https://www.orionsarm.com/eg-article/46cf859e07951> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Given as TYC 6419-481-1. The Tycho catalogue is not one we carry, so the star cannot be bound and the position falls back to the constellation." ;
    oa:uncertain false .

claim:location-world-nengs a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46cf859e07951> ;
    oa:about id:world-nengs ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Sculptor" ;
    oa:distance value:location-world-nengs-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-nengs-distance a oa:QuantityValue ;
    qudt:numericValue 834.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-nengs-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46cf859e07951> ;
    oa:about id:world-nengs ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .

claim:event-world-nengs-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46cf859e07951> ;
    oa:about id:world-nengs ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3989 .
