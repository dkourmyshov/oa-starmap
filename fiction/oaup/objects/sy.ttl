@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Sy

id:world-sy a oa:Place, oa:World ;
    skos:prefLabel "Sy" ;
    oa:article <https://www.orionsarm.com/eg-article/478c171e73982> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "HD 196954 A in Cygnus, 1,191 ly out. Recorded as Cygexpa's, which is the one holder in this file that is not a present one: the Cygnus Expansion Corporation no longer exists, and no world tagged with it answers to anything by that name. The label is kept because most of what was theirs joined nobody afterwards, so it still says where a world came from and that it went nowhere else." ;
    oa:uncertain false .

claim:location-world-sy a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478c171e73982> ;
    oa:about id:world-sy ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 196954" .

claim:affiliation-world-sy-cygexpa a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478c171e73982> ;
    oa:about id:world-sy ;
    oa:canonical true ;
    oa:polity id:polity-cygexpa ;
    oa:recordOrder 0 .

claim:event-world-sy-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478c171e73982> ;
    oa:about id:world-sy ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3910 .
