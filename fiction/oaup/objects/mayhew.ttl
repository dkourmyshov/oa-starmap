@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Mayhew

id:world-mayhew a oa:Place, oa:World ;
    skos:prefLabel "Mayhew" ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Camelopardalis at 447 ly. No article recorded: the link given for it was truncated to the site's article path with no identifier." ;
    oa:uncertain false .

claim:location-world-mayhew a prov:Entity, oa:LocationClaim ;
    oa:about id:world-mayhew ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 237193 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-mayhew-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-mayhew ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-mayhew-001 a prov:Entity, oa:EventClaim ;
    oa:about id:world-mayhew ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2989 .
