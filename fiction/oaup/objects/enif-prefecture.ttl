# Enif Prefecture

id:world-enif-prefecture a oa:Place, oa:World ;
    skos:prefLabel "Enif Prefecture" ;
    oa:article <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:kind "polity_marker" ;
    oa:labelsSystem false ;
    oa:note "More than thirty worlds, centred on Enif — Epsilon Pegasi, 690 ly. Drawn at the centre: no extent is given for the volume itself." ;
    oa:uncertain false .

claim:location-world-enif-prefecture a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:about id:world-enif-prefecture ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Enif" .

claim:affiliation-world-enif-prefecture-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:about id:world-enif-prefecture ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-enif-prefecture-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:about id:world-enif-prefecture ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Established before the Version War." ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 4450 .
