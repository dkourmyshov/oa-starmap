@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Remagar

id:world-remagar a oa:Place, oa:World ;
    skos:prefLabel "Remagar" ;
    oa:article <https://www.orionsarm.com/eg-article/477027c0787a2> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Taurus at 3,701 ly." ;
    oa:uncertain false .

claim:location-world-remagar a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/477027c0787a2> ;
    oa:about id:world-remagar ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Taurus" ;
    oa:distance value:location-world-remagar-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-remagar-distance a oa:QuantityValue ;
    qudt:numericValue 3701.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-remagar-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/477027c0787a2> ;
    oa:about id:world-remagar ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 8822 .
