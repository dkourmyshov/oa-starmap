@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Newlife

id:world-newlife a oa:Place, oa:World ;
    skos:prefLabel "Newlife" ;
    oa:article <https://www.orionsarm.com/eg-article/4b374d3c9d6b5> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-newlife a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4b374d3c9d6b5> ;
    oa:about id:world-newlife ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "1,622 ly from Sol and no direction given, which is a shell rather than a place." .

claim:affiliation-world-newlife-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4b374d3c9d6b5> ;
    oa:about id:world-newlife ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-newlife-001 a prov:Entity, oa:EventClaim ;
    oa:about id:world-newlife ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Relativistic rescue mission reaches the Newlife system." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Re-Evaluation" ;
    oa:yearAT 5603 .
