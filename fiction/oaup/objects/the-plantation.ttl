# The Plantation

id:world-the-plantation a oa:Place, oa:World ;
    skos:prefLabel "The Plantation" ;
    oa:article <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:editorialNote "---- Mutual Progress Association ----------------------------------------\n\nMostly megastructures. Several are habitats or rings inside a system the\nmap places some other way, so they sit at their host's position rather than\nrepeating its coordinates." ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Where the Gardener originated. In Aquila at 225 ly, and shares an article with the World Garden it later made." ;
    oa:uncertain false .

claim:location-world-the-plantation a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:about id:world-the-plantation ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 177374 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-the-plantation-keter-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:about id:world-the-plantation ;
    oa:canonical true ;
    oa:polity id:polity-keter-dominion ;
    oa:recordOrder 0 .

claim:event-world-the-plantation-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:about id:world-the-plantation ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 1800 .
