# Canberra Orbital

id:world-canberra-orbital a oa:Place, oa:World ;
    skos:prefLabel "Canberra Orbital" ;
    oa:article <https://www.orionsarm.com/eg-article/5300ada006f6a> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-canberra-orbital a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5300ada006f6a> ;
    oa:about id:world-canberra-orbital ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-canberra-orbital-distance ;
    oa:hipparcosId 2254 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-canberra-orbital-distance a oa:QuantityValue ;
    qudt:numericValue 348.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-canberra-orbital-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5300ada006f6a> ;
    oa:about id:world-canberra-orbital ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .

claim:event-world-canberra-orbital-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5300ada006f6a> ;
    oa:about id:world-canberra-orbital ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Construction begins." ;
    oa:polity id:polity-communion-of-worlds ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 6449 .
