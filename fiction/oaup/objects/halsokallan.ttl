# Halsokallan

id:world-halsokallan a oa:Place, oa:World ;
    skos:prefLabel "Halsokallan" ;
    oa:article <https://www.orionsarm.com/eg-article/46674941b75a2> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Formerly of the Solar Dominion. The affiliation is the present holder." ;
    oa:uncertain false .

claim:location-world-halsokallan a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46674941b75a2> ;
    oa:about id:world-halsokallan ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Perseus" ;
    oa:distance value:location-world-halsokallan-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-halsokallan-distance a oa:QuantityValue ;
    qudt:numericValue 5889.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-halsokallan-amalgamation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46674941b75a2> ;
    oa:about id:world-halsokallan ;
    oa:canonical true ;
    oa:polity id:polity-amalgamation ;
    oa:recordOrder 0 .

claim:event-world-halsokallan-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46674941b75a2> ;
    oa:about id:world-halsokallan ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "Fell to the Amalgamation." ;
    oa:polity id:polity-amalgamation ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 8760 .
