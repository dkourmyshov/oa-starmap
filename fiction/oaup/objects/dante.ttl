@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Dante

id:world-dante a oa:Place, oa:World ;
    skos:prefLabel "Dante" ;
    oa:article <https://www.orionsarm.com/eg-article/48fa66f687117> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Gliese 676 A, in Ara at 52 ly." ;
    oa:uncertain false .

claim:location-world-dante a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa66f687117> ;
    oa:about id:world-dante ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 85647 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-dante-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa66f687117> ;
    oa:about id:world-dante ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-dante-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa66f687117> ;
    oa:about id:world-dante ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1380 .
