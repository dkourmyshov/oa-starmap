    oa:about id:world-djed ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .

claim:event-world-djed-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464ceaad61e78> ;
    oa:about id:world-djed ;
    oa:canonical true ;
