    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "A planet and a megastructure both, at Eta Sagittarii B, 137 ly." ;
    oa:uncertain false .

claim:location-world-djed a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464ceaad61e78> ;
    oa:about id:world-djed ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Eta Sagittarii" .

claim:affiliation-world-djed-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
