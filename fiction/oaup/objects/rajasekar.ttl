claim:event-world-rajasekar-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910f10364835> ;
    oa:about id:world-rajasekar ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "\"Just ten years after the first outbreak the culture had collapsed to the point where it could no longer maintain the necessary nanotech and information infrastructure, and it died out.\" Year is computed as 4182 AT (the viral outbreak, 'In 4182 AT ... a viral infection ... attacked the Pikuu-Pik-3') plus the sentence's own 'ten years after'; no explicit AT number is given for the collapse itself, so this should be checked by the reviewer. 'Ten years after the first outbreak' of 4182; the culture the Stellar Umma had found in 2534." ;
    oa:precision oa:Circa ;
    oa:recordOrder 3 ;
    oa:yearAT 4192 .

claim:event-world-rajasekar-005 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910f10364835> ;
    oa:about id:world-rajasekar ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Currently Rajasekar is a member of the Mutual Progress Association after the 7833 AT coup by the Requiemists against the until then ruling Spranger Party.\" The sentence ties current MPA membership to the 7833 AT coup, but does not explicitly say MPA membership began at that date rather than at some later point; flagged for reviewer confirmation. After the Requiemists' coup against the Spranger Party; the reader flagged the link between the coup and the joining as the article's, not stated." ;
    oa:polity id:polity-mutual-progress-association ;
    oa:precision oa:Exact ;
    oa:recordOrder 4 ;
    oa:yearAT 7833 .
