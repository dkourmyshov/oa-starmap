# Oceans Unlimited Dyson

id:world-oceans-unlimited-dyson a oa:Place, oa:World ;
    skos:prefLabel "Oceans Unlimited Dyson" ;
    oa:article <https://www.orionsarm.com/eg-article/4a3a4277520cc> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-oceans-unlimited-dyson a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a3a4277520cc> ;
    oa:about id:world-oceans-unlimited-dyson ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 22.325907361 ;
    oa:distance value:location-world-oceans-unlimited-dyson-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 103511. It has no article of its own and is named in the one cited. Named in the Zoeific Biopolity's own article in an older revision, and in the Diskworlds article now." ;
    oa:rightAscensionDeg 314.56812975 .

value:location-world-oceans-unlimited-dyson-distance a oa:QuantityValue ;
    qudt:numericValue 452.381 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-oceans-unlimited-dyson-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a3a4277520cc> ;
    oa:about id:world-oceans-unlimited-dyson ;
