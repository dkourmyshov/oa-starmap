@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Diwali

id:world-diwali a oa:Place, oa:World ;
    skos:prefLabel "Diwali" ;
    oa:article <https://www.orionsarm.com/eg-article/48ff5ef2ed040> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Eta Cassiopeiae A and B, 19 ly." ;
    oa:uncertain false .

claim:location-world-diwali a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff5ef2ed040> ;
    oa:about id:world-diwali ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Achird" .

claim:affiliation-world-diwali-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff5ef2ed040> ;
    oa:about id:world-diwali ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-diwali-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff5ef2ed040> ;
    oa:about id:world-diwali ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "First reached somewhere in this range." ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
    oa:untilAT 1300 ;
    oa:yearAT 943 .

claim:event-world-diwali-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff5ef2ed040> ;
    oa:about id:world-diwali ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"In the 1300s the Federation sent a number of expeditions to Achird A+B\" Matches the '1300' end of the header's 'visited 943-1300' range. 'The 1300s', entered as 1300." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:Circa ;
    oa:recordOrder 1 ;
    oa:yearAT 1300 .

claim:event-world-diwali-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff5ef2ed040> ;
    oa:about id:world-diwali ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"In 2501, the Solar Dominion sent a mission fleet to this system, and established a colony on the largely undeveloped world Mattancheri\" A colony on Mattancheri, 'the largely undeveloped world'." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 2501 .
