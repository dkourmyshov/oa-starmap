@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Ozymandias

id:world-ozymandias a oa:Place, oa:World ;
    skos:prefLabel "Ozymandias" ;
    oa:article <https://www.orionsarm.com/eg-article/48fa78b7c6cf1> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Capital of the Premacy." ;
    oa:uncertain false .

claim:location-world-ozymandias a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa78b7c6cf1> ;
    oa:about id:world-ozymandias ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Vela" ;
    oa:distance value:location-world-ozymandias-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "Kept as a cone. The Celestia location catalogues give a direction that falls inside Vela, 9 degrees from its centre against a radius of 18 — but they put the system at 2,509 ly where the article says 1,897, and a direction asserted for an object 600 ly further out is not obviously the right direction for this one. See questions.md." .

value:location-world-ozymandias-distance a oa:QuantityValue ;
    qudt:numericValue 1897.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-ozymandias-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa78b7c6cf1> ;
    oa:about id:world-ozymandias ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .
