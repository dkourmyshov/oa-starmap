# Medina

id:world-medina a oa:Place, oa:World ;
    skos:prefLabel "Medina" ;
    oa:article <https://www.orionsarm.com/eg-article/4979e6aa84195> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "HIP 39330, also HD 66653, in Puppis at 118.7 ly against the article's 118. Its own right ascension and declination land in Puppis too, as stated." ;
    oa:uncertain false .

claim:location-world-medina a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4979e6aa84195> ;
    oa:about id:world-medina ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-medina-distance ;
    oa:hipparcosId 39330 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-medina-distance a oa:QuantityValue ;
    qudt:numericValue 118.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-medina-stellar-umma a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4979e6aa84195> ;
    oa:about id:world-medina ;
    oa:canonical true ;
    oa:polity id:polity-stellar-umma ;
    oa:recordOrder 0 .

claim:event-world-medina-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4979e6aa84195> ;
    oa:about id:world-medina ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1639 .

claim:event-world-medina-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-medina ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Islamic Unity probeship arrives at Medina ." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Late Federation / AI Emergence" ;
    oa:yearAT 1639 .

claim:event-world-medina-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4979e6aa84195> ;
    oa:about id:world-medina ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"These four systems shared the title of capital world for a few centuries, before Medina became ascendant in the twenty first century A.T.\" Ascendant among the four capital worlds of the Umma 'in the twenty first century AT', entered as 2000." ;
    oa:polity id:polity-stellar-umma ;
    oa:precision oa:Circa ;
    oa:recordOrder 2 ;
    oa:yearAT 2000 .

claim:event-world-medina-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4979e6aa84195> ;
    oa:about id:world-medina ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"Tensions between isolationist factions and dynamic, expansionist groups led the a schism in 2676, and Medina was left as capital of the Core worlds only, with the outer regions breaking away and developing a new empire with its own invented language, Umma of the Shell.\" The outer regions broke away as a new, unnamed-on-roster empire ('Umma of the Shell'); Medina itself remained capital, now of the Core worlds/Stellar Umma. Capital of the Core after the schism of 2676." ;
    oa:polity id:polity-stellar-umma ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 2676 .
