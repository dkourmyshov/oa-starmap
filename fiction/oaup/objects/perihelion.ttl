# Perihelion

id:world-perihelion a oa:Place, oa:World ;
    skos:prefLabel "Perihelion" ;
    oa:article <https://www.orionsarm.com/eg-article/4910ea3192752> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Perseus at 244 ly. No dates." ;
    oa:uncertain false .

claim:location-world-perihelion a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910ea3192752> ;
    oa:about id:world-perihelion ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 12552 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-perihelion-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910ea3192752> ;
    oa:about id:world-perihelion ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .
