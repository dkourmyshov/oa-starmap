# Sagan Prime

id:world-sagan-prime a oa:Place, oa:World ;
    skos:prefLabel "Sagan Prime" ;
    oa:article <https://www.orionsarm.com/eg-article/54c109a62b582> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "A habitat, given as near NGC 1444." ;
    oa:uncertain false .

claim:location-world-sagan-prime a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/54c109a62b582> ;
    oa:about id:world-sagan-prime ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Perseus" ;
    oa:distance value:location-world-sagan-prime-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-sagan-prime-distance a oa:QuantityValue ;
    qudt:numericValue 3850.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-sagan-prime-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/54c109a62b582> ;
    oa:about id:world-sagan-prime ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-sagan-prime-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/54c109a62b582> ;
    oa:about id:world-sagan-prime ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 8016 .

claim:event-world-sagan-prime-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/54c109a62b582> ;
    oa:about id:world-sagan-prime ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"By 8700 the cylinder was habitable and was given the name Sagan Prime. Most of the population of this system migrated to the new habitat in the following centuries.\" The cylinder habitable, and most of the system's population migrated to it; the map's older 'visited 8016' is the Vuvena sect's arrival." ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 1 ;
    oa:yearAT 8700 .
