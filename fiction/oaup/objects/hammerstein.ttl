claim:event-world-hammerstein-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ce67be2dba24> ;
    oa:about id:world-hammerstein ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Hammerstein joined the NoCoZo in 3410, and adopted a form of government known as Futarchy; this system is found on a number of NoCoZO Worlds, and integrates well with the predominantly libertarian philosophy of that empire.\" New event, not in header. And adopted Futarchy." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 3410 .
