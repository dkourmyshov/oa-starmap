@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Jafalgia

id:world-jafalgia a oa:Place, oa:World ;
    skos:prefLabel "Jafalgia" ;
    oa:article <https://www.orionsarm.com/eg-article/4681a363693b4> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-jafalgia a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a363693b4> ;
    oa:about id:world-jafalgia ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Monoceros" ;
    oa:distance value:location-world-jafalgia-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-jafalgia-distance a oa:QuantityValue ;
    qudt:numericValue 1032.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-jafalgia-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a363693b4> ;
    oa:about id:world-jafalgia ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-jafalgia-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a363693b4> ;
    oa:about id:world-jafalgia ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonized: 5217 a.t\"; \"established by the Metasoft Version Tree\", in the body, undated." ;
    oa:polity id:polity-metasoft ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5217 .
