@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Skeblu

id:world-skeblu a oa:Place, oa:World ;
    skos:prefLabel "Skeblu" ;
    oa:article <https://www.orionsarm.com/eg-article/4f18e05693e65> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Canis Major at 4,001 ly." ;
    oa:uncertain false .

claim:location-world-skeblu a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f18e05693e65> ;
    oa:about id:world-skeblu ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Canis Major" ;
    oa:distance value:location-world-skeblu-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-skeblu-distance a oa:QuantityValue ;
    qudt:numericValue 4001.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-skeblu-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f18e05693e65> ;
    oa:about id:world-skeblu ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 9433 .
