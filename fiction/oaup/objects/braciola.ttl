@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Braciola

id:world-braciola a oa:Place, oa:World ;
    skos:prefLabel "Braciola" ;
    oa:article <https://www.orionsarm.com/eg-article/5b2badb809b9e> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The article's coordinates fall in Delphinus, as it says. No star is named, so the direction stands on its own." ;
    oa:uncertain false .

claim:location-world-braciola a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5b2badb809b9e> ;
    oa:about id:world-braciola ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 14.7472 ;
    oa:distance value:location-world-braciola-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 309.5688 .

value:location-world-braciola-distance a oa:QuantityValue ;
    qudt:numericValue 177.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-braciola-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5b2badb809b9e> ;
    oa:about id:world-braciola ;
    oa:canonical true ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:recordOrder 0 .

claim:event-world-braciola-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5b2badb809b9e> ;
    oa:about id:world-braciola ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2723 .

claim:event-world-braciola-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5b2badb809b9e> ;
    oa:about id:world-braciola ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"In the year 2723 AT a colony mission consisting of near-baseline humans arrived at Braciola (Maiale c) and built their colony.\" Header records this as 'visited 2723', but the sentence describes the colonists building their colony, which reads as settled rather than a mere visit. No polity is named for the colony mission. A colony mission of near-baseline humans; the map's older 'visited 2723' is this arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2723 .
