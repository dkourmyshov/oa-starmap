# Niaanyo

id:world-niaanyo a oa:Place, oa:World ;
    skos:prefLabel "Niaanyo" ;
    oa:article <https://www.orionsarm.com/eg-article/5e3dc9fab9763> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "A rogue planet in deep space carrying a Hider colony, in Sagitta at 2,212 ly from coordinates the article gives. The Hiders are not a polity this file records, and would not thank it for trying." ;
    oa:uncertain false .

claim:location-world-niaanyo a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5e3dc9fab9763> ;
    oa:about id:world-niaanyo ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 21.3378 ;
    oa:distance value:location-world-niaanyo-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 300.3458 .

value:location-world-niaanyo-distance a oa:QuantityValue ;
    qudt:numericValue 2212.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-niaanyo-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5e3dc9fab9763> ;
    oa:about id:world-niaanyo ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7879 .
