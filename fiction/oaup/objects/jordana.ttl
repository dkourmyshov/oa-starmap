@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Jordana

id:world-jordana a oa:Place, oa:World ;
    skos:prefLabel "Jordana" ;
    oa:article <https://www.orionsarm.com/eg-article/4682f991708d7> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Ophiuchus at 1,081 ly." ;
    oa:uncertain false .

claim:location-world-jordana a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4682f991708d7> ;
    oa:about id:world-jordana ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Ophiuchus" ;
    oa:distance value:location-world-jordana-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-jordana-distance a oa:QuantityValue ;
    qudt:numericValue 1081.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-jordana-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4682f991708d7> ;
    oa:about id:world-jordana ;
    oa:canonical true ;
    oa:eventKind oa:Observed ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4694 .
