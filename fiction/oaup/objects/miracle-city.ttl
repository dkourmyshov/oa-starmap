# Miracle City

id:world-miracle-city a oa:Place, oa:World ;
    skos:prefLabel "Miracle City" ;
    oa:article <https://www.orionsarm.com/eg-article/49111e6284074> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "A xenosophont megastructure, and the best-cross-referenced place here: the article gives its distance to five others — 216 ly to Skiiws'nnii, 51 to Vinculum, 84 to the Cooperative Venture, 211 to the Sparks, 78 to the nearest stargate at TYC 443-1690-1. Vinculum and the Sparks are both on this map and both check out, at 59.5 and 266 ly against the stated 51 and 211." ;
    oa:uncertain false .

claim:location-world-miracle-city a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49111e6284074> ;
    oa:about id:world-miracle-city ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 5.81 ;
    oa:distance value:location-world-miracle-city-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 273.75 .

value:location-world-miracle-city-distance a oa:QuantityValue ;
    qudt:numericValue 1730.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

