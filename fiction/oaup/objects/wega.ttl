# Wega

id:world-wega a oa:Place, oa:World ;
    skos:prefLabel "Wega" ;
    oa:article <https://www.orionsarm.com/eg-article/48ff291dd2dfc> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Centaurus at 88 ly. No dates." ;
    oa:uncertain false .

claim:location-world-wega a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff291dd2dfc> ;
    oa:about id:world-wega ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 108309 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-wega-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff291dd2dfc> ;
    oa:about id:world-wega ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .
