@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Labeyrie

id:world-labeyrie a oa:Place, oa:World ;
    skos:prefLabel "Labeyrie" ;
    oa:article <https://www.orionsarm.com/eg-article/46788c08a643b> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Designated JD 9492276-22, which is Orion's Arm's own numbering and matches nothing in the Celestia add-on or in any real catalogue we hold — so the position is the constellation and the distance, not the designation." ;
    oa:uncertain false .

claim:location-world-labeyrie a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46788c08a643b> ;
    oa:about id:world-labeyrie ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Sculptor" ;
    oa:distance value:location-world-labeyrie-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-labeyrie-distance a oa:QuantityValue ;
    qudt:numericValue 675.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-labeyrie-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46788c08a643b> ;
    oa:about id:world-labeyrie ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .

claim:event-world-labeyrie-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46788c08a643b> ;
    oa:about id:world-labeyrie ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3155 .
