    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:parentName "Ho Jong Star" ;
    oa:uncertain false .

claim:location-world-metropolis-ring-city a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4902f1f2c7f73> ;
    oa:about id:world-metropolis-ring-city ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -18.3 ;
    oa:distance value:location-world-metropolis-ring-city-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 277.75 .

value:location-world-metropolis-ring-city-distance a oa:QuantityValue ;
    qudt:numericValue 659.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

