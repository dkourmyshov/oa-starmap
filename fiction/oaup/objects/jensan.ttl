@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Jensan

id:world-jensan a oa:Place, oa:World ;
    skos:prefLabel "Jensan" ;
    oa:article <https://www.orionsarm.com/eg-article/4681a5f4cfc46> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-jensan a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a5f4cfc46> ;
    oa:about id:world-jensan ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Puppis" ;
    oa:distance value:location-world-jensan-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-jensan-distance a oa:QuantityValue ;
    qudt:numericValue 1409.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-jensan-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a5f4cfc46> ;
    oa:about id:world-jensan ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 0 .

claim:event-world-jensan-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a5f4cfc46> ;
    oa:about id:world-jensan ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5309 .

claim:event-world-jensan-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4681a5f4cfc46> ;
    oa:about id:world-jensan ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Sophic League world founded by Jensanist refugees from Neli-Neti , who arrived as hitchikers on a Spacefarer Union ship in 5309 AT.\" The header labels this 'visited 5309', but the sentence describes refugees founding the world, not merely visiting. No polity is recorded on this entry because the refugees and the Spacefarer Union carrying them are not the Sophic League; see holder_undated. Jensanist refugees from Neli-Neti, hitchhikers on a Spacefarer Union ship; the map's older 'visited 5309' is this arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 5309 .
