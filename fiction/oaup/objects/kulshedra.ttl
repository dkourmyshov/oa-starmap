@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Kulshedra

id:world-kulshedra a oa:Place, oa:World ;
    skos:prefLabel "Kulshedra" ;
    oa:article <https://www.orionsarm.com/eg-article/56f009e29ec1f> ;
    oa:editorialNote "---- Perseus Principalities ---------------------------------------------\n\nMostly landmarks rather than places: Czernik 8 and Cam OB1 are in\npolities.yaml and landmarks.yaml, not here. What is here is two stars named\nonly by catalogue number, and Pluton, which the map already had." ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The one place in this roster outside M39, and the only one with no landmark to hang a direction on — Lacerta at 2,652 ly, so the direction is good to the width of the constellation." ;
    oa:uncertain false .

claim:location-world-kulshedra a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56f009e29ec1f> ;
    oa:about id:world-kulshedra ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Lacerta" ;
    oa:distance value:location-world-kulshedra-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-kulshedra-distance a oa:QuantityValue ;
    qudt:numericValue 2652.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-kulshedra-archosaurian-empire a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56f009e29ec1f> ;
    oa:about id:world-kulshedra ;
    oa:canonical true ;
    oa:polity id:polity-archosaurian-empire ;
    oa:recordOrder 0 .

claim:event-world-kulshedra-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56f009e29ec1f> ;
    oa:about id:world-kulshedra ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7209 .
