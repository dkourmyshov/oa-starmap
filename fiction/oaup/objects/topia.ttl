@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Topia

id:world-topia a oa:Place, oa:World ;
    skos:prefLabel "Topia" ;
    oa:article <https://www.orionsarm.com/eg-article/47a3ec6e06652> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "A planet and the megastructure built over it. The article names HIP 85986 and puts it at 609 ly; the catalogue puts that star at 2,716, four and a half times further. The direction is not in doubt and the distance is not reconcilable, so the star supplies the one and the article the other. At 609 ly Topia sits in the Utopia Sphere's core, 108 ly from Beta Arae and at the same distance the article gives Eutopia — which is where a Utopian megastructure belongs, and is why the article's figure is the one kept." ;
    oa:uncertain false .

claim:location-world-topia a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a3ec6e06652> ;
    oa:about id:world-topia ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -54.1986 ;
    oa:distance value:location-world-topia-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "HIP 85986" ;
    oa:rightAscensionDeg 263.6103 .

value:location-world-topia-distance a oa:QuantityValue ;
    qudt:numericValue 609.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-topia-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a3ec6e06652> ;
    oa:about id:world-topia ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-topia-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a3ec6e06652> ;
    oa:about id:world-topia ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 4800 .
