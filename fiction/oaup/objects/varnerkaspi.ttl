# Varnerkaspi

id:world-varnerkaspi a oa:Place, oa:World ;
    skos:prefLabel "Varnerkaspi" ;
    oa:article <https://www.orionsarm.com/eg-article/474e2f74abc1f> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-varnerkaspi a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/474e2f74abc1f> ;
    oa:about id:world-varnerkaspi ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Centaurus" ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "The outer Crucis Corridor and the outer volumes of the Centaurus sector. The sector fixes a direction; the corridor is not a sector and is not read here." .

claim:affiliation-world-varnerkaspi-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/474e2f74abc1f> ;
    oa:about id:world-varnerkaspi ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-varnerkaspi-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/474e2f74abc1f> ;
    oa:about id:world-varnerkaspi ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 8048 .
