@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Gripler

id:world-gripler a oa:Place, oa:World ;
    skos:prefLabel "Gripler" ;
    oa:article <https://www.orionsarm.com/eg-article/48fa7379af7e0> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Designated GD 80008751, a catalogue this map does not carry." ;
    oa:uncertain false .

claim:location-world-gripler a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa7379af7e0> ;
    oa:about id:world-gripler ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Perseus" ;
    oa:distance value:location-world-gripler-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-gripler-distance a oa:QuantityValue ;
    qudt:numericValue 2998.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-gripler-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa7379af7e0> ;
    oa:about id:world-gripler ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-gripler-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa7379af7e0> ;
    oa:about id:world-gripler ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7022 .
