# Wallace Dyson Swarm

id:world-wallace-dyson-swarm a oa:Place, oa:World ;
    skos:prefLabel "Wallace Dyson Swarm" ;
    oa:article <https://www.orionsarm.com/eg-article/46f879c9c42a8> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "Given as 644 ly from Sol, 44 from Beta Arae and 42 from the Wilson swarm. The catalogue reproduces the last of those almost exactly at 41.6 ly, which confirms the pair, but puts both about 14% nearer than the article." ;
    oa:uncertain false .

claim:location-world-wallace-dyson-swarm a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f879c9c42a8> ;
    oa:about id:world-wallace-dyson-swarm ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 84507 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

