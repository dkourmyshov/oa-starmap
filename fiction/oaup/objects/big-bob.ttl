@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Big Bob

id:world-big-bob a oa:Place, oa:World ;
    skos:prefLabel "Big Bob" ;
    oa:article <https://www.orionsarm.com/eg-article/45f4870be3455> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "A gas giant. Whether the Non-Coercive Zone has a presence here at all is unsettled, so the affiliation is marked uncertain rather than asserted." ;
    oa:uncertain true .

claim:location-world-big-bob a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f4870be3455> ;
    oa:about id:world-big-bob ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Puppis" ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In Puppis, presumably not far from the Premacy. No distance given." .

claim:affiliation-world-big-bob-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f4870be3455> ;
    oa:about id:world-big-bob ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .
