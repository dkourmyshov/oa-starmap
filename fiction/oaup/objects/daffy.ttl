claim:event-world-daffy-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "The planet New Daffy was colonised by heretic expansionists from the Negentropy Alliance world of Greylag , becoming the New Daffy Panoparchy ." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Separate Empires" ;
    oa:yearAT 6230 .

claim:event-world-daffy-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In 2556 AT FreedomWorld got a lucrative offer from the TakiCorb subsidiary Serpens Development Blast for the colonisation rights, and they sold the right to the planet.\" FreedomWorld Inc. and the TakiCorb subsidiary Serpens Development Blast are megacorporations, not roster polities (see unplaced). Serpens Development Blast, a TakiCorb subsidiary, no polity of this file; the map's older 'settled 6230' has no sentence in the article." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 2556 .

claim:event-world-daffy-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"During the Version War, Daffy was hard hit by the standardisation side, and in 4479 AT it was occupied by NoCoZo / Cyberian forces.\" until_at computed from 'throughout the 60 year occupation'. The occupation was contested throughout by local resistance (the Narchy), so this may be military occupation rather than an accepted transfer of allegiance - flagged for review. An occupation during the Version War, contested throughout by the local Narchy; the same sentence carries the Cyberian Network." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:untilAT 4539 ;
    oa:yearAT 4479 .

claim:event-world-daffy-005 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"During the Version War, Daffy was hard hit by the standardisation side, and in 4479 AT it was occupied by NoCoZo / Cyberian forces.\" until_at computed from 'throughout the 60 year occupation'. Paired with the NoCoZo entry above; same caveat about contested occupation applies." ;
    oa:polity id:polity-cyberian-network ;
    oa:precision oa:Exact ;
    oa:recordOrder 4 ;
    oa:untilAT 4539 ;
    oa:yearAT 4479 .

claim:event-world-daffy-006 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The Conver Wars devastated the planet ... In the aftermath one group managed to unite the scattered survivors and restore order and environment control: the Church of Negentropy ... Over a span of a decade they united the planet, creating a new planetary government strongly based on negentropism\", and \"As the Negentropy Alliance grew Daffy became one of the main worlds\". The year is the timeline's end of the Conver Wars, 3943. The Ambi's tenancy of 2556: \"The new tenants of Daffy were the Harvists of the Conver Ambi\"." ;
    oa:polity id:polity-negentropy-alliance ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 5 ;
    oa:yearAT 3943 .
