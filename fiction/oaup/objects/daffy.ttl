# Daffy

id:world-daffy a oa:Place, oa:World ;
    skos:prefLabel "Daffy" ;
    oa:article <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Psi Serpentis, 48 ly, a triple — A, Ba and Bb. Daffy orbits A, which is the component the catalogue entry is." ;
    oa:uncertain false .

claim:location-world-daffy a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Psi Serpentis" .

claim:affiliation-world-daffy-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .

claim:event-world-daffy-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462d549553412> ;
    oa:about id:world-daffy ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
