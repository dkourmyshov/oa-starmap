# Neli-Neti

id:world-neli-neti a oa:Place, oa:World ;
    skos:prefLabel "Neli-Neti" ;
    oa:article <https://www.orionsarm.com/eg-article/5385f65c43e09> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Placed at 698 ly in the direction of HIP 63911, rather than at the 17,120 ly the catalogue gives that star. Musca is both the constellation the system is said to be in and the one the star is in, which says the identifier is right and only its parallax is wrong — Hipparcos measures positions to milliarcseconds and measures parallaxes at kiloparsec ranges barely at all. So the direction is taken from the star and the distance from the source. Using the constellation alone would have thrown away a good direction for a cone some 86 ly wide at this range." ;
    oa:uncertain false .

claim:location-world-neli-neti a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5385f65c43e09> ;
    oa:about id:world-neli-neti ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -65.5129 ;
    oa:distance value:location-world-neli-neti-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "HIP 63911" ;
    oa:rightAscensionDeg 196.4508 .

value:location-world-neli-neti-distance a oa:QuantityValue ;
    qudt:numericValue 698.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

