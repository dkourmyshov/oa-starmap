    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5385f65c43e09> ;
    oa:about id:world-neli-neti ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

