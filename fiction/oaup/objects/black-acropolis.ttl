    oa:rightAscensionDeg 281.25 .

value:location-world-black-acropolis-distance a oa:QuantityValue ;
    qudt:numericValue 1530.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

