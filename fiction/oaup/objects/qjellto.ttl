# Qjellto

id:world-qjellto a oa:Place, oa:World ;
    skos:prefLabel "Qjellto" ;
    oa:article <https://www.orionsarm.com/eg-article/46de1625d2357> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The panel's \"Former Cygexpa world.\" is undated and not entered as a holding; it fell somewhere before the Utopia Sphere enclave of 4896. Divided rather than shared: the Utopia Sphere holds the Hrek worldhouse and the Zoeific Biopolity everywhere else." ;
    oa:uncertain false .

claim:location-world-qjellto a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46de1625d2357> ;
    oa:about id:world-qjellto ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 332518 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-qjellto-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46de1625d2357> ;
    oa:about id:world-qjellto ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:affiliation-world-qjellto-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
