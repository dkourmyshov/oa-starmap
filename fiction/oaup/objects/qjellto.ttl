claim:event-world-qjellto-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-qjellto ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Qjellto settled by retroists and low-tech peripathetics." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Age of Expansion" ;
    oa:yearAT 2344 .

claim:event-world-qjellto-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46de1625d2357> ;
    oa:about id:world-qjellto ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The aphasics congregated on the Hrek worldhouse, which in 4896 AT became a Utopia Sphere enclave run by the archailect Nameless One.\" The Hrek worldhouse became a Utopia Sphere enclave under the archailect Nameless One; the map's older 'settled 2344' has no sentence in the article." ;
    oa:polity id:polity-utopia-sphere ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 4896 .

claim:event-world-qjellto-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46de1625d2357> ;
    oa:about id:world-qjellto ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The Qjellto society elsewhere developed into a fairly typical multiurban Inner Sphere society, eventually joining the Zoeific Biopolity in 9405 AT.\" The rest of Qjellto's society, 'eventually'." ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 9405 .
