# Nirio Dyson

id:world-nirio-dyson a oa:Place, oa:World ;
    skos:prefLabel "Nirio Dyson" ;
    oa:article <https://www.orionsarm.com/eg-article/46d62d210a07e> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-nirio-dyson a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d62d210a07e> ;
    oa:about id:world-nirio-dyson ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -47.4714 ;
    oa:derivation "The direction is the article's own, to arcseconds. The distance is not: the article gives none. Its two neighbours do — Budrosa at 1,783 ly and Jekaumeatrine at 1,818 — and this lies between them on the sky, a third of a degree from one and half a degree from the other, so 1,800 ly is their midpoint and the error covers both. That is an inference, and a narrow one, but an inference." ;
    oa:directionErrorDeg 0.1 ;
    oa:distance value:location-world-nirio-dyson-distance ;
    oa:distanceError value:location-world-nirio-dyson-distance-error ;
    oa:knownDistanceConflict false ;
    oa:method oa:EditorialEstimate ;
    oa:rightAscensionDeg 211.3056 .

value:location-world-nirio-dyson-distance a oa:QuantityValue ;
    qudt:numericValue 1800.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

value:location-world-nirio-dyson-distance-error a oa:QuantityValue ;
    qudt:numericValue 50.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-nirio-dyson-paradigm a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d62d210a07e> ;
    oa:about id:world-nirio-dyson ;
    oa:canonical true ;
    oa:polity id:polity-paradigm ;
    oa:recordOrder 0 .

claim:event-world-nirio-dyson-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d62d210a07e> ;
    oa:about id:world-nirio-dyson ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5184 .

claim:event-world-nirio-dyson-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-nirio-dyson ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Attacked by the Efficiency Maximisation Paradigm in 5439 and optimized with little loss of life; most of the population was uploaded against their will and instantiated inside a virtual reality copy of their original environment.\" Framed as an attack, but the following sentences state the system 'remained in Paradigm control' afterward, so this is recorded as a change of holder rather than a mere battle. An attack after which the system 'remained in Paradigm control'; the map's older 'settled 4384' has no sentence in the article." ;
    oa:polity id:polity-paradigm ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Integration" ;
    oa:yearAT 4384 .
