claim:event-world-zikhron-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/532b2a4235638> ;
    oa:about id:world-zikhron ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Joined the Terragen Federation during the Consolidation Wars , but was nevertheless occupied for thirteen years by the Geminga Orthodoxy until it was liberated by a Terragen Federation force in 3802.\" Records the liberation year (3802); the earlier joining 'during the Consolidation Wars' has no year given, see holder_undated. During the Consolidation Wars, though occupied thirteen years by the Geminga Orthodoxy, no polity of this file; 3802 is the liberation." ;
    oa:polity id:polity-terragen-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 3802 .
