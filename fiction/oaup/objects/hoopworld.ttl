# Hoopworld

id:world-hoopworld a oa:Place, oa:World ;
    skos:prefLabel "Hoopworld" ;
    oa:article <https://www.orionsarm.com/eg-article/49142c044cba7> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "In Ophiuchus at 491 ly. One of the few entries here with an end rather than a beginning: it came apart twenty years before the setting's present." ;
    oa:uncertain false .

claim:location-world-hoopworld a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49142c044cba7> ;
    oa:about id:world-hoopworld ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 86705 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-hoopworld-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
