claim:event-world-freedonia-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f9dc012e4209> ;
    oa:about id:world-freedonia ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The S Antliae system was colonised in 2477 AT by a joint NoCoZo / Sophic League mission, drawn by the unusual characteristics of this double star.\" Joint colonisation by NoCoZo and the Sophic League; recorded as two entries, one per polity. A joint NoCoZo and Sophic League mission; the same sentence carries the Zone." ;
    oa:polity id:polity-sophic-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2477 .

claim:event-world-freedonia-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f9dc012e4209> ;
    oa:about id:world-freedonia ;
    oa:canonical true ;
    oa:eventKind oa:Independent ;
    oa:note "\"The joint NoCoZo/Sophic administration named this system Freedonia, but after two centuries they declared themselves independent of both empires and seceded from Sephirotic influence.\" Year computed as circa 2677 AT, two centuries after the stated 2477 colonisation; the article gives only the relative span 'two centuries', not an AT year, for the secession itself. 'After two centuries' of joint administration, entered as 2677; independent of both." ;
    oa:precision oa:Circa ;
    oa:recordOrder 2 ;
    oa:yearAT 2677 .
