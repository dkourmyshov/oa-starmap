    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f9dc012e4209> ;
    oa:about id:world-freedonia ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 82610" .

