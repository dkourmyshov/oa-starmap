@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Rergenar

id:world-rergenar a oa:Place, oa:World ;
    skos:prefLabel "Rergenar" ;
    oa:article <https://www.orionsarm.com/eg-article/47703480bcd62> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-rergenar a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47703480bcd62> ;
    oa:about id:world-rergenar ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-rergenar-distance ;
    oa:hdId 3357 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-rergenar-distance a oa:QuantityValue ;
    qudt:numericValue 351.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-rergenar-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47703480bcd62> ;
    oa:about id:world-rergenar ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .

claim:event-world-rergenar-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47703480bcd62> ;
    oa:about id:world-rergenar ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2479 .
