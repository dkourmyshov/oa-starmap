claim:event-world-yangko-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/532b2e15251be> ;
    oa:about id:world-yangko ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"this conservatism attracted the 'Dao, who became members of that empire in 3509.\" 'That empire' refers to the Terragen Federation, named in the immediately preceding sentence as the faction that gained territory in this volume." ;
