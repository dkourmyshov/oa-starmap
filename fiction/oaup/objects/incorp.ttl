@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Incorp

id:world-incorp a oa:Place, oa:World ;
    skos:prefLabel "Incorp" ;
    oa:article <https://www.orionsarm.com/eg-article/465ccc8e9c7f8> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Melotte 111, the Coma Berenices cluster, which Metasoft also holds as a landmark. The article's 307 ly and the catalogue's 284 agree well enough to bind." ;
    oa:uncertain false .

claim:location-world-incorp a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/465ccc8e9c7f8> ;
    oa:about id:world-incorp ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-incorp-distance ;
    oa:hdId 107793 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-incorp-distance a oa:QuantityValue ;
    qudt:numericValue 307.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-incorp-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/465ccc8e9c7f8> ;
    oa:about id:world-incorp ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-incorp-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/465ccc8e9c7f8> ;
    oa:about id:world-incorp ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2777 .
