    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "82 Eridani IV, 19.7 ly. The catalogue carries the star under the Gould designation 82 G. Eri rather than a Flamsteed number." ;
    oa:uncertain false .

