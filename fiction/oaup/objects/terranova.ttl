claim:event-world-terranova-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49126e35d4891> ;
    oa:about id:world-terranova ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In 4328 Terranova was bought by Riddersdan Ikki, a major shareholder nanotech AI owning several of the largest NoCoZo megacorps.\" Riddersdan Ikki is an individual AI, not on the roster (see unplaced). The sentence describes ownership by that individual, not an acquisition by NoCoZo as a polity, so no roster polity has been recorded. Riddersdan Ikki, a nanotech AI and shareholder of NoCoZo megacorps, an individual; the map's older 'visited 1885' has no sentence in the article." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 4328 .
