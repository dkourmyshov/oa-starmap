# Relay 8

id:inner-sphere-row-0670 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Relay 8" .

claim:inner-sphere-inner-sphere-row-0670-77a282ba3f49 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0670 ;
    oa:canonical true ;
    oa:colonyName "Relay 8" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 669 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0670-77a282ba3f49-source-distance ;
    oa:spectralType "." ;
    oa:starName "Gliese 819 A" .

value:inner-sphere-inner-sphere-row-0670-77a282ba3f49-source-distance a oa:QuantityValue ;
    qudt:numericValue 56.699 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

