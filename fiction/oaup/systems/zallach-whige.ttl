# Zallach-Whige

id:world-zallach-whige a oa:Place, oa:World ;
    skos:prefLabel "Zallach-Whige" ;
    oa:article <https://www.orionsarm.com/eg-article/5460a5aceb49a> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Chi Eridani A, as the colony table has it." ;
    oa:systemName "Zallach-Whige" ;
    oa:uncertain false .

claim:location-world-zallach-whige a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5460a5aceb49a> ;
    oa:about id:world-zallach-whige ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Chi Eridani A" .

claim:affiliation-world-zallach-whige-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5460a5aceb49a> ;
    oa:about id:world-zallach-whige ;
    oa:canonical true ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:recordOrder 0 .

claim:event-world-zallach-whige-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5460a5aceb49a> ;
    oa:about id:world-zallach-whige ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised 2050 AT\" No polity is named for this original colonisation, either in the panel or the body text." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2050 .

claim:event-world-zallach-whige-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5460a5aceb49a> ;
    oa:about id:world-zallach-whige ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The colony in this system was stagnating until the Zoeific Biopolity constructed a McKendree Cylinder (Zallach-Whige) in 8950 AT, and encouraged House Genen to populate it.\" The system's original 2050 AT colony (moon and gas-giant bubblehabs) already existed and was 'stagnating'; this event is the Zoeific Biopolity's later construction and repopulation of the McKendree cylinder, not the system's first settlement. A second settlement of a stagnating colony, with House Genen, no polity of this file, encouraged to populate the cylinder." ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 8950 .

