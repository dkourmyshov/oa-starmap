# JD 836902

id:star-jd-836902 a oa:CelestiaStar, oa:Place, oa:Star ;
    skos:prefLabel "JD 836902" ;
    oa:sourceName "JD 836902" .

claim:celestia-star-jd-836902-c9a2ef6427e0 a prov:Entity, oa:CelestiaLocationClaim, oa:LocationClaim ;
    prov:hadPrimarySource src:celestia-addons ;
    oa:about id:star-jd-836902 ;
    oa:absoluteMagnitude 4.43 ;
    oa:canonical true ;
    oa:declinationDeg 29.871 ;
    oa:distance value:celestia-star-jd-836902-c9a2ef6427e0-distance ;
    oa:method oa:ImportedValue ;
    oa:rightAscensionDeg 52.62495 ;
    oa:sourceArchive "OAAddons1.zip" ;
    oa:sourceComment "G3  star for Niuearth" ;
    oa:sourceFile "oastars2-2.stc" ;
    oa:sourceSystemName "Niuearth" ;
    oa:spectralType "G1" .

value:celestia-star-jd-836902-c9a2ef6427e0-distance a oa:QuantityValue ;
    qudt:numericValue 786.9 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-star-jd-836902-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52b993102478a> ;
    oa:about id:star-jd-836902 ;
    oa:canonical true ;
    oa:polity id:polity-metasoft .

claim:curation-star-jd-836902 a prov:Entity, oa:SystemCuration ;
    oa:about id:star-jd-836902 ;
    oa:article <https://www.orionsarm.com/eg-article/52b993102478a> ;
    oa:editorialLabel "Niuearth" ;
    oa:hidden false ;
    oa:note "worlds.yaml carries Niuearth bound to this same star, and that is what stops it being drawn twice: a world bound to an add-on star is drawn as that star and takes over its label. Hiding this entry does not dedupe them, it deletes the world — the marker the world would have used is the one that goes away." ;
    oa:uncertain false .

# Niuearth

id:world-niuearth a oa:Place, oa:World ;
    skos:prefLabel "Niuearth" ;
    oa:article <https://www.orionsarm.com/eg-article/52b993102478a> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Around JD 836902, a G1 star the Celestia add-on places in Taurus at 786.9 ly — the same distance the article gives to the light year, and the same constellation, but exact in direction where the article gives only the region." ;
    oa:uncertain false .

claim:location-world-niuearth a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52b993102478a> ;
    oa:about id:world-niuearth ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:oaStarName "JD 836902" .

claim:affiliation-world-niuearth-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52b993102478a> ;
    oa:about id:world-niuearth ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-niuearth-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52b993102478a> ;
    oa:about id:world-niuearth ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2998 .
