# Krantor

id:world-krantor a oa:Place, oa:World ;
    skos:prefLabel "Krantor" ;
    oa:article <https://www.orionsarm.com/eg-article/46dcbc280a037> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-krantor a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46dcbc280a037> ;
    oa:about id:world-krantor ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -59.096063361 ;
    oa:distance value:location-world-krantor-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg-article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer, which gave no coordinates itself. The add-on's designation for the primary is HIP 67748. It has no article of its own; it is named in the Megasov article, and the article cited here is NoCoNeg's, the polity it belongs to — Negentropy by law and Non-Coercive by spirit. The gazetteer's note on Try Anything Once, the route reaching it, reads \"To Non Coersive Zone\". Recorded under the Negentropy Alliance for a time, on the project owner's decision, this file then having no entry for NoCoNeg and no other world wanting one. Both halves of that have stopped being true since: the add-on's NOCONEG region is a second object wanting it, so the polity now exists and this system sits under it." ;
    oa:rightAscensionDeg 208.186474083 .

value:location-world-krantor-distance a oa:QuantityValue ;
    qudt:numericValue 1120.8 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-krantor-noconeg a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46dcbc280a037> ;
    oa:about id:world-krantor ;
    oa:canonical true ;
    oa:polity id:polity-noconeg ;
    oa:recordOrder 0 .
