claim:event-world-vega-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4b6ec434691e3> ;
    oa:about id:world-vega ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Reached : 1130, by the Vega Triumvirate\" Body text elaborates: 'the luminous star Vega was reached in 1130 by the Vega Triumvirate, which began to develop the system as a transapientech (and later godtech ) research facility.' The Vega Triumvirate is not on the roster. The Vega Triumvirate is no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1130 .
