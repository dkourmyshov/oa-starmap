# M'Buto

id:world-m-buto a oa:Place, oa:World ;
    skos:altLabel "M'Buto Confederacy" ;
    skos:prefLabel "M'Buto" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 454, 42 ly out. Named in the colony table and held jointly with the Non-Coercive Zone; the Encyclopaedia gives it no article of its own. The Combine's page puts the M'Buto Confederacy at BD -9 3413, 10.7 ly from Beta Virginis." ;
    oa:uncertain false .

claim:location-world-m-buto a prov:Entity, oa:LocationClaim ;
    oa:about id:world-m-buto ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 454" .

claim:affiliation-world-m-buto-metasoft a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-m-buto ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:affiliation-world-m-buto-nocozo a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-m-buto ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 1 .

claim:event-world-m-buto-001 a prov:Entity, oa:EventClaim ;
    oa:about id:world-m-buto ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"After some years of increasingly close links, the M'Buto Confederacy joins the Virginis Combine.\" The Combine's own page: the Confederacy, \"a loose solar system alliance of diverse habitats, clades, corporations, and Houses, was easily subverted and annexed by the combine.\"" ;
    oa:polity id:polity-virginis-combine ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:sourceDescription "Encyclopaedia timeline, Late Federation / AI Emergence" ;
    oa:yearAT 1816 .

