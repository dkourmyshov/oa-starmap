# Moedus

id:world-moedus a oa:Place, oa:World ;
    skos:prefLabel "Moedus" ;
    oa:article <https://www.orionsarm.com/eg-article/48aca6f9717da> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-moedus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48aca6f9717da> ;
    oa:about id:world-moedus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -38.411984889 ;
    oa:distance value:location-world-moedus-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 89361. It has no article of its own and is named in the one cited. No polity recorded; named in the Traction article, at the far end of Corridor 3490." ;
    oa:rightAscensionDeg 273.529001542 .

value:location-world-moedus-distance a oa:QuantityValue ;
    qudt:numericValue 1284.12 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
