# Xi Boötis B I

id:world-xi-bootis-b-i a oa:Place, oa:World ;
    skos:prefLabel "Xi Boötis B I" ;
    oa:article <https://www.orionsarm.com/eg-article/46f1e74d34205> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "A world of Ishtar, the B component of the Shamash system." ;
    oa:systemName "Shamash" ;
    oa:uncertain false .

claim:location-world-xi-bootis-b-i a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f1e74d34205> ;
    oa:about id:world-xi-bootis-b-i ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Xi Bootis" .

claim:affiliation-world-xi-bootis-b-i-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f1e74d34205> ;
    oa:about id:world-xi-bootis-b-i ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-xi-bootis-b-i-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f1e74d34205> ;
    oa:about id:world-xi-bootis-b-i ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"In 6222 a Nimbus colony was set up on Xi Bootis B I, but it persisted only for 400 years before dissipating.\" Colony endured about 400 years before dissipating; no explicit end year is given, so none was recorded. By Nimbus, no polity of this file; the colony 'persisted only for 400 years', its end not dated outright." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 6222 .

