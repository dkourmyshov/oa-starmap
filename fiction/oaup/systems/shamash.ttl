# Shamash

id:world-shamash a oa:Place, oa:World ;
    skos:prefLabel "Shamash" ;
    oa:article <https://www.orionsarm.com/eg-article/49121fa0347e1> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Xi Boötis, 22 ly. Shamash is the A component and Ishtar the B; the catalogue carries the pair as one entry." ;
    oa:systemName "Shamash" ;
    oa:uncertain false .

claim:location-world-shamash a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49121fa0347e1> ;
    oa:about id:world-shamash ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Xi Bootis" .

claim:affiliation-world-shamash-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49121fa0347e1> ;
    oa:about id:world-shamash ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-shamash-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49121fa0347e1> ;
    oa:about id:world-shamash ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1349 .

claim:event-world-shamash-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-shamash ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Shamash (Xi Bootis A III)colonised by Hearp Rangers." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Middle Federation / Megacorps" ;
    oa:yearAT 1349 .

claim:event-world-shamash-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49121fa0347e1> ;
    oa:about id:world-shamash ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In 2348 Shamash formally joined the Solar Dominion.\" New against the header, which records only visited/settled 1349." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 2348 .

claim:event-world-shamash-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49121fa0347e1> ;
    oa:about id:world-shamash ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"When the Taurus Nexus break-up occurred in 3263 Locos was annexed by the Dominion.\" New against the header. Locos is a continent of Shamash previously leased to the Taurus Nexus; its annexation is recorded as a transferred event rather than treated as a mere sub- settlement, since it is a stated change of holder. Locos, a world of the system, at the Taurus Nexus break-up." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 3263 .

