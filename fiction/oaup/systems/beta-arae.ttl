@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Beta Arae

id:world-beta-arae a oa:Place, oa:World ;
    skos:prefLabel "Beta Arae" ;
    oa:article <https://www.orionsarm.com/eg-article/460c3bd4ad939> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The landmark the Utopia Sphere's core is quoted against: half a dozen of its systems are given as so many light years from Beta Arae rather than from Sol. The catalogue gives it class K, B-V 1.48 and absolute magnitude -3.9: a luminous orange star, and luminous at this range means a parallax small enough to be revised more than once. The catalogue here says 715 ly, while the distances the Encyclopaedia gives its neighbours imply about 635." ;
    oa:systemName "Beta Arae" ;
    oa:uncertain false .

claim:location-world-beta-arae a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3bd4ad939> ;
    oa:about id:world-beta-arae ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Beta Arae" .

claim:affiliation-world-beta-arae-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3bd4ad939> ;
    oa:about id:world-beta-arae ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-beta-arae-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3bd4ad939> ;
    oa:about id:world-beta-arae ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2975 .

# Shangdu

id:world-shangdu a oa:Place, oa:World ;
    skos:prefLabel "Shangdu" ;
    oa:article <https://www.orionsarm.com/eg-article/4d5d92f9dcd6d> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In the Beta Arae system, in the Middle Regions. Held jointly by the Utopia Sphere and the TRHN, the TechnoRapture HyperNation." ;
    oa:systemName "Beta Arae" ;
    oa:uncertain false .

claim:location-world-shangdu a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4d5d92f9dcd6d> ;
    oa:about id:world-shangdu ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Beta Arae" .

claim:affiliation-world-shangdu-technorapture-hypernation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4d5d92f9dcd6d> ;
    oa:about id:world-shangdu ;
    oa:canonical true ;
    oa:polity id:polity-technorapture-hypernation ;
    oa:recordOrder 1 .

claim:affiliation-world-shangdu-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4d5d92f9dcd6d> ;
    oa:about id:world-shangdu ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-shangdu-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4d5d92f9dcd6d> ;
    oa:about id:world-shangdu ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Shangdu was established by TRHN AIs and Utopia Sphere archai in 4200 as a way of allowing Utopian modosophont citizens the chance to ascend .\" Joint venture; recorded once for each founding polity. A joint venture of the two; the second entry is the same sentence for the Utopia Sphere." ;
    oa:polity id:polity-technorapture-hypernation ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4200 .

claim:event-world-shangdu-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4d5d92f9dcd6d> ;
    oa:about id:world-shangdu ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Shangdu was established by TRHN AIs and Utopia Sphere archai in 4200 as a way of allowing Utopian modosophont citizens the chance to ascend .\" Joint venture; recorded once for each founding polity." ;
    oa:polity id:polity-utopia-sphere ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 4200 .
