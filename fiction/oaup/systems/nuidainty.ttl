# NuiDainty

id:world-nuidainty a oa:Place, oa:World ;
    skos:prefLabel "NuiDainty" ;
    oa:article <https://www.orionsarm.com/eg-article/49a7dcd6413a0> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-nuidainty a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49a7dcd6413a0> ;
    oa:about id:world-nuidainty ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 26.868572778 ;
    oa:distance value:location-world-nuidainty-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 94696. It has no article of its own and is named in the one cited. The gazetteer's own note on the route reaching it, Yellow Brick Road II, reads \"To Zoeific Biopolity\"." ;
    oa:rightAscensionDeg 289.036210917 .

value:location-world-nuidainty-distance a oa:QuantityValue ;
    qudt:numericValue 274.32 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-nuidainty-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49a7dcd6413a0> ;
    oa:about id:world-nuidainty ;
    oa:canonical true ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:recordOrder 0 .
