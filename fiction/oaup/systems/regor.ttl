@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Regor

id:world-regor a oa:Place, oa:World ;
    skos:prefLabel "Regor" ;
    oa:article <https://www.orionsarm.com/eg-article/4bdb45052ddfe> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "1,117 ly. Canon disagrees over whether the Regor supernova was averted; nothing here depends on the answer." ;
    oa:systemName "Regor" ;
    oa:uncertain false .

claim:location-world-regor a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bdb45052ddfe> ;
    oa:about id:world-regor ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gamma 2 Velorum" .

claim:affiliation-world-regor-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bdb45052ddfe> ;
    oa:about id:world-regor ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-regor-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bdb45052ddfe> ;
    oa:about id:world-regor ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4082 .
