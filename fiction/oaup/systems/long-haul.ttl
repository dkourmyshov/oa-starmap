@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Long Haul

id:world-long-haul a oa:Place, oa:World ;
    skos:prefLabel "Long Haul" ;
    oa:article <https://www.orionsarm.com/eg-article/4902dd900dbc5> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-long-haul a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4902dd900dbc5> ;
    oa:about id:world-long-haul ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -24.3 ;
    oa:distance value:location-world-long-haul-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. It has no article of its own and is named in the one cited. Both gazetteer routes reaching it, Night On the Town and Street of Dreams, are noted \"To Mutual Progress Association\"." ;
    oa:rightAscensionDeg 277.25 .

value:location-world-long-haul-distance a oa:QuantityValue ;
    qudt:numericValue 991.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-long-haul-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4902dd900dbc5> ;
    oa:about id:world-long-haul ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .
