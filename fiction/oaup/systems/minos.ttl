@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Minos

id:world-minos a oa:Place, oa:World ;
    skos:prefLabel "Minos" ;
    oa:article <https://www.orionsarm.com/eg-article/46788d76422a7> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Perseus at 3,041 ly." ;
    oa:systemName "Minos" ;
    oa:uncertain false .

claim:location-world-minos a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46788d76422a7> ;
    oa:about id:world-minos ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Perseus" ;
    oa:distance value:location-world-minos-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-minos-distance a oa:QuantityValue ;
    qudt:numericValue 3041.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

# Labyrinth

id:world-labyrinth a oa:Place, oa:World ;
    skos:prefLabel "Labyrinth" ;
    oa:article <https://www.orionsarm.com/eg-article/46788d76422a7> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The world of Minos, and named for what is on it." ;
    oa:systemName "Minos" ;
    oa:uncertain false .
