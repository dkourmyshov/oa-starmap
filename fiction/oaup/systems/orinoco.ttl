# Orinoco

id:world-orinoco a oa:Place, oa:World ;
    skos:prefLabel "Orinoco" ;
    oa:article <https://www.orionsarm.com/eg-article/4910613da24b9> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Lambda Serpentis, 39 ly." ;
    oa:systemName "Orinoco" ;
    oa:uncertain false .

claim:location-world-orinoco a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910613da24b9> ;
    oa:about id:world-orinoco ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Lambda Serpentis" .

claim:affiliation-world-orinoco-cyberian-network a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910613da24b9> ;
    oa:about id:world-orinoco ;
    oa:canonical true ;
    oa:polity id:polity-cyberian-network ;
    oa:recordOrder 0 .

claim:event-world-orinoco-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910613da24b9> ;
    oa:about id:world-orinoco ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2103 .

claim:event-world-orinoco-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910613da24b9> ;
    oa:about id:world-orinoco ;
    oa:canonical true ;
    oa:eventKind oa:Independent ;
    oa:note "\"In the Glorious Defenestration of 2223, OGA was overthrown and the planet became at least on paper democratic and independent.\" OGA (Orinoco Government Associates), the overthrown local government, is a TakiCorb subsidiary, not a roster polity; the planet is described as becoming independent of it, joining no listed polity at this point. The Glorious Defenestration, overthrowing the OGA and TakiCorb, no polities of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2223 .

