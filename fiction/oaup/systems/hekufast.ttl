# Hekufast

id:world-hekufast a oa:Place, oa:World ;
    skos:prefLabel "Hekufast" ;
    oa:article <https://www.orionsarm.com/eg-article/466c9a62708d2> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The pulsar PSR B1749-28, in Sagittarius at 652 ly, from coordinates the article gives." ;
    oa:systemName "Hekufast" ;
    oa:uncertain false .

claim:location-world-hekufast a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/466c9a62708d2> ;
    oa:about id:world-hekufast ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -28.11 ;
    oa:distance value:location-world-hekufast-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 268.24 .

value:location-world-hekufast-distance a oa:QuantityValue ;
    qudt:numericValue 652.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-hekufast-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/466c9a62708d2> ;
    oa:about id:world-hekufast ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3709 .
