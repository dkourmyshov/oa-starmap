# Wasat

id:world-wasat a oa:Place, oa:World ;
    skos:prefLabel "Wasat" ;
    oa:article <https://www.orionsarm.com/eg-article/4bb5d6c578611> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Delta Geminorum Aa, as the colony table has it." ;
    oa:systemName "Wasat" ;
    oa:uncertain false .

claim:location-world-wasat a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bb5d6c578611> ;
    oa:about id:world-wasat ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Delta Geminorum Aa" .

claim:event-world-wasat-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bb5d6c578611> ;
    oa:about id:world-wasat ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Tianzun was reached by the First Federation in 1920 by colonists aboard the Visible Excitement.\" Aligned with the TCP, 'which means it soon became part of the Conver Ambi', undated." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1920 .

claim:event-world-wasat-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bb5d6c578611> ;
    oa:about id:world-wasat ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"In 1848, Wasat became home of the House Conver Limis, specialists of the colonization of AquaCytherean planets (also known as PelaCytherian wprlds).\" House Conver Limis is a dynasty/faction, not a roster polity; see unplaced. A later sentence calls the Apex Carbuncle habitat 'the symbolic capital of the Conver Limis', supporting the capital classification. House Conver Limis, a dynasty, no polity of this file; the year precedes the article's own 'first reached' of 1920, and both are kept as written." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1848 .

claim:event-world-wasat-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bb5d6c578611> ;
    oa:about id:world-wasat ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The system was first reached in 1920 by the Visible Excitement, a First Federation colony mission aligned with the TCP, which means it soon became part of the Conver Ambi, a theocratic empire based on the neighboring system Conver Ky (37 Geminorum).\" The year is the Ambi's establishment on the timeline." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 2 ;
    oa:yearAT 1984 .

claim:event-world-wasat-004 a prov:Entity, oa:EventClaim ;
    oa:about id:world-wasat ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In the aftermath of the war, Wasat, the important wormhole hub Conver Ky, and several other core Conver systems became part of the Solar Dominion.\" The year is the peace accords' on the timeline. The colony table gives the system no present affiliation, and nothing saved says it left the Dominion." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:sourceDescription "Encyclopaedia timeline, 3943" ;
    oa:yearAT 3943 .

