claim:event-world-qinglong-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464f1e545d058> ;
    oa:about id:world-qinglong ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"This world was inhabited by Mirrored Owl symbiotic swarm-nets, including the entity known as Advection of Pure Drylines during the 4000's AT.\" Inhabiting group is a clade of symbiotic swarm-nets, not a roster polity. The gas dwarf of the Shenjing system, inhabited by the Mirrored Owls' swarm-nets; no polity of this file." ;
    oa:precision oa:Circa ;
    oa:recordOrder 0 ;
    oa:yearAT 4000 .
