# Bake-eo

id:inner-sphere-row-1091 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Bake-eo" .

claim:inner-sphere-inner-sphere-row-1091-d7317ecc31ac a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-1091 ;
    oa:canonical true ;
    oa:colonyName "Bake-eo" ;
    oa:luminositySol "2.5" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 1090 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-1091-d7317ecc31ac-source-distance ;
    oa:spectralType "A0 Vnp" ;
    oa:starName "Gamma Ophiuchi A" .

value:inner-sphere-inner-sphere-row-1091-d7317ecc31ac-source-distance a oa:QuantityValue ;
    qudt:numericValue 97.020 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
