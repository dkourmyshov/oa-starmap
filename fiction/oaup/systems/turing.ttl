# Turing

id:world-turing a oa:Place, oa:World ;
    skos:prefLabel "Turing" ;
    oa:article <https://www.orionsarm.com/eg-article/49125f5d1c049> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Castor, 51 ly out, and named as Turing in the colony table too." ;
    oa:uncertain false .

claim:location-world-turing a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49125f5d1c049> ;
    oa:about id:world-turing ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Castor" .

claim:affiliation-world-turing-technorapture-hypernation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49125f5d1c049> ;
    oa:about id:world-turing ;
    oa:canonical true ;
    oa:polity id:polity-technorapture-hypernation ;
    oa:recordOrder 0 .

claim:event-world-turing-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49125f5d1c049> ;
    oa:about id:world-turing ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2211 .

claim:event-world-turing-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-turing ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "The Turing arrives at Pi3 Orionis . The Heterosemiotics name the fourth planet Daedalus." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Sundering" ;
    oa:yearAT 854 .

