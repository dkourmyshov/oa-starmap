@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Brashton

id:world-brashton a oa:Place, oa:World ;
    skos:prefLabel "Brashton" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-brashton a prov:Entity, oa:LocationClaim ;
    oa:about id:world-brashton ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 68.768138694 ;
    oa:distance value:location-world-brashton-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 80650. No article names it. No article survives. The gazetteer's note on Bright Lights Big City, the route reaching it, reads \"To Solar Dominion\"." ;
    oa:rightAscensionDeg 246.995893708 .

value:location-world-brashton-distance a oa:QuantityValue ;
    qudt:numericValue 486.816 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-brashton-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-brashton ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .
