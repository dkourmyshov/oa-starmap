# Keid

id:world-keid a oa:Place, oa:World ;
    skos:prefLabel "Keid" ;
    oa:article <https://www.orionsarm.com/eg-article/45e24ae0d6d07> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Omicron2 Eridani A, as the colony table has it." ;
    oa:systemName "Keid" ;
    oa:uncertain false .

claim:location-world-keid a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e24ae0d6d07> ;
    oa:about id:world-keid ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Omicron2 Eridani A" .

claim:affiliation-world-keid-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e24ae0d6d07> ;
    oa:about id:world-keid ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-keid-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e24ae0d6d07> ;
    oa:about id:world-keid ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The first wave of colonists were refugees from the Technocalypse who arrived in 789 AT in arkships built by GAIA .\" Refugees of the Technocalypse in GAIA's arkships; a former member of the Eridanus League and NoCoZo-aligned since, both undated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 789 .

