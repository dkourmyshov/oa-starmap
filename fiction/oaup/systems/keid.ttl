claim:event-world-twilight-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a683c98fd29> ;
    oa:about id:world-twilight ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The newly arrived colonists joined the Eridanus League in 810 AT, and together with Epsilon Eridani were the founding partners of that early interstellar empire.\" The roster records the Eridanus League as founded 770 AT, a 40-year gap from this \"founding partner\" claim; not a same-article contradiction, but see doubts. With Epsilon Eridani, 'the founding partners of that early interstellar empire'." ;
    oa:polity id:polity-eridanus-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 810 .

claim:event-world-twilight-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a683c98fd29> ;
    oa:about id:world-twilight ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"They formally joined the NoCoZo in 5403.\" Matches the header's \"filed under: Non-Coercive Zone (NoCoZo)\"." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 5403 .
