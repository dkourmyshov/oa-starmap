    oa:about id:inner-sphere-row-0423 ;
    oa:canonical true ;
    oa:colonyName "Solipsist AI" ;
    oa:luminositySol "0.016" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 422 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0423-9e53f462a74c-source-distance ;
    oa:spectralType "M" ;
    oa:starName "Gliese 842" .

value:inner-sphere-inner-sphere-row-0423-9e53f462a74c-source-distance a oa:QuantityValue ;
    qudt:numericValue 37.679 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

