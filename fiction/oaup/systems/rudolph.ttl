@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Rudolph

id:world-rudolph a oa:Place, oa:World ;
    skos:prefLabel "Rudolph" ;
    oa:article <https://www.orionsarm.com/eg-article/49119e365a395> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "A fiery-red brown dwarf." ;
    oa:systemName "Rudolph" ;
    oa:uncertain false .

claim:location-world-rudolph a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49119e365a395> ;
    oa:about id:world-rudolph ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "3,650 ly from Sol, on the edge of the old Disarchy volume and about 120 ly counterspinward of Lynga 2. The cluster is on the map, but an offset of 120 ly from it in a named direction is not something this map can yet resolve into a position." .

claim:affiliation-world-rudolph-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49119e365a395> ;
    oa:about id:world-rudolph ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-rudolph-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49119e365a395> ;
    oa:about id:world-rudolph ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "Became Non-Coercive Zone property." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 9654 .
