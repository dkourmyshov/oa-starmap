# Barboro

id:world-barboro a oa:Place, oa:World ;
    skos:prefLabel "Barboro" ;
    oa:article <https://www.orionsarm.com/eg-article/4609c83fbc355> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Psi Capricorni, 48 ly. Recorded as a planet, but the source does not make clear whether Barboro names the planet, the star, the system, or all three; the binding is to the star either way." ;
    oa:uncertain false .

claim:location-world-barboro a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c83fbc355> ;
    oa:about id:world-barboro ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Psi Capricorni" .

claim:affiliation-world-barboro-keter-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c83fbc355> ;
    oa:about id:world-barboro ;
    oa:canonical true ;
    oa:polity id:polity-keter-dominion ;
    oa:recordOrder 0 .

claim:event-world-barboro-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c83fbc355> ;
    oa:about id:world-barboro ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2245 .
