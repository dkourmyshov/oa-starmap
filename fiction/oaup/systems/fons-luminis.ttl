# Fons Luminis

id:world-fons-luminis a oa:Place, oa:World ;
    skos:altLabel "Hersperia" ;
    skos:prefLabel "Fons Luminis" ;
    oa:article <https://www.orionsarm.com/eg-article/4900d8c15efa3> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Five stars, 34 ly. Originally called Hersperia. The catalogue carries the primary under its own name, Alula Australis." ;
    oa:systemName "Fons Luminis" ;
    oa:uncertain false .

claim:location-world-fons-luminis a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4900d8c15efa3> ;
    oa:about id:world-fons-luminis ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Xi Ursae Majoris" .

claim:affiliation-world-fons-luminis-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4900d8c15efa3> ;
    oa:about id:world-fons-luminis ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-fons-luminis-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4900d8c15efa3> ;
    oa:about id:world-fons-luminis ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1204 .

# Fons Luminis

id:inner-sphere-row-0266 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
