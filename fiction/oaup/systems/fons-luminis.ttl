claim:inner-sphere-inner-sphere-row-0266-878d87cd302d a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0266 ;
    oa:article <https://www.orionsarm.com/eg-article/4900d8c15efa3> ;
    oa:canonical true ;
    oa:colonyName "Fons Luminis" ;
    oa:luminositySol "0.01" ;
    oa:massSol "0.4" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 265 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0266-878d87cd302d-source-distance ;
    oa:spectralType "M3 V" ;
    oa:starName "Xi Ursae Majoris Ab" .

value:inner-sphere-inner-sphere-row-0266-878d87cd302d-source-distance a oa:QuantityValue ;
    qudt:numericValue 28.489 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

