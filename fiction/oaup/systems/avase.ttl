@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Avase

id:world-avase a oa:Place, oa:World ;
    skos:prefLabel "Avase" ;
    oa:article <https://www.orionsarm.com/eg-article/45ea5e51b4e1f> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:systemName "Avase" ;
    oa:uncertain false .

claim:location-world-avase a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45ea5e51b4e1f> ;
    oa:about id:world-avase ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Centaurus" ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In the Centauri sector, which fixes the direction and not the range." .

claim:affiliation-world-avase-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45ea5e51b4e1f> ;
    oa:about id:world-avase ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .
