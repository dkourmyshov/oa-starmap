    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4629822fcae28> ;
    oa:about id:world-4-vulpeculae ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "4 Vulpeculae" .

