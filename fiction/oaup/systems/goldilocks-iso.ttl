    oa:method oa:DirectTranscription ;
    oa:recordOrder 483 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0484-afcd35c4afec-source-distance ;
    oa:spectralType "K7 V" ;
    oa:starName "SZ Crateris A" .

value:inner-sphere-inner-sphere-row-0484-afcd35c4afec-source-distance a oa:QuantityValue ;
    qudt:numericValue 42.807 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
