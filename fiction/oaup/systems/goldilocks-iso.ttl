# Goldilocks ISO

id:inner-sphere-row-0484 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Goldilocks ISO" .

claim:inner-sphere-inner-sphere-row-0484-afcd35c4afec a prov:Entity, oa:InnerSphereClaim ;
