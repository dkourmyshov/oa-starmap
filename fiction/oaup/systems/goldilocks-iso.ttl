    oa:about id:inner-sphere-row-0484 ;
    oa:article <https://www.orionsarm.com/eg-article/46f96896df066> ;
    oa:canonical true ;
    oa:colonyName "Goldilocks ISO" ;
    oa:luminositySol "0.109" ;
