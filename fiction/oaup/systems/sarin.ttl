# Sarin

id:inner-sphere-row-0879 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Sarin" .

claim:inner-sphere-inner-sphere-row-0879-c38f1ab548de a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0879 ;
    oa:canonical true ;
    oa:colonyName "Sarin" ;
    oa:luminositySol "28" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 878 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0879-c38f1ab548de-source-distance ;
    oa:spectralType "A3 IV" ;
    oa:starName "Delta Herculis Aa" .

value:inner-sphere-inner-sphere-row-0879-c38f1ab548de-source-distance a oa:QuantityValue ;
    qudt:numericValue 76.777 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
