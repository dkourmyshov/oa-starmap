# Osmond

id:world-osmond a oa:Place, oa:World ;
    skos:prefLabel "Osmond" ;
    oa:article <https://www.orionsarm.com/eg-article/486ecd3a8e1a5> ;
    oa:editorialNote "53, the" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-osmond a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ecd3a8e1a5> ;
    oa:about id:world-osmond ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 64.633263806 ;
    oa:distance value:location-world-osmond-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 21276. It has no article of its own and is named in the one cited. The gazetteer's note on Little Ray of Sunshine #53, the route reaching it, reads \"To Solar Dominion\"." ;
    oa:rightAscensionDeg 68.476083958 .

value:location-world-osmond-distance a oa:QuantityValue ;
    qudt:numericValue 82.8466 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-osmond-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ecd3a8e1a5> ;
    oa:about id:world-osmond ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .
