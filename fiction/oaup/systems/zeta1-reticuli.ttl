# Atlantis

id:world-atlantis a oa:Place, oa:World ;
    skos:prefLabel "Atlantis" ;
    oa:article <https://www.orionsarm.com/eg-article/486ec4e68c62e> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "One cell of the colony table holds three names for this system — Atlantis, Prometheus and Daedalus — belonging to three meta-empires." ;
    oa:uncertain false .

claim:location-world-atlantis a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ec4e68c62e> ;
    oa:about id:world-atlantis ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Zeta1 Reticuli" .

