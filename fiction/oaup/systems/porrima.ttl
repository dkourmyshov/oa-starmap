# Porrima

id:world-porrima a oa:Place, oa:World ;
    skos:prefLabel "Porrima" ;
    oa:article <https://www.orionsarm.com/eg-article/4703b95b8c03b> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "39 ly." ;
    oa:systemName "Porrima" ;
    oa:uncertain false .

claim:location-world-porrima a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4703b95b8c03b> ;
    oa:about id:world-porrima ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gamma Virginis" .

claim:affiliation-world-porrima-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4703b95b8c03b> ;
    oa:about id:world-porrima ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-porrima-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4703b95b8c03b> ;
    oa:about id:world-porrima ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "A derelict alien starship found here — the first dated event the system has, and evidence of somebody's presence rather than of the Dominion's." ;
    oa:polity id:polity-virginis-combine ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1752 .

claim:event-world-porrima-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-porrima ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "The 61 Virginis probes of the Virginis Effort arrive within their target system. Separating from the mother hull, the Virgo probe is placed within an orbit that takes it within 0.32 AU of the star, and out to 0.75 AU. The Spica probe ran..." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Sundering" ;
    oa:yearAT 597 .

