# Proxima Centauri

id:world-proxima-centauri a oa:Place, oa:World ;
    skos:prefLabel "Proxima Centauri" ;
    oa:article <https://www.orionsarm.com/eg-article/4ce52fdf5e9de> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "4.2 ly — the nearest system to Sol, and among the earliest settled." ;
    oa:systemName "Proxima Centauri" ;
    oa:uncertain false .

claim:location-world-proxima-centauri a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ce52fdf5e9de> ;
    oa:about id:world-proxima-centauri ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Proxima Centauri" .

claim:affiliation-world-proxima-centauri-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ce52fdf5e9de> ;
    oa:about id:world-proxima-centauri ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 0 .

claim:event-world-proxima-centauri-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4ce52fdf5e9de> ;
    oa:about id:world-proxima-centauri ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "First colonised somewhere in this range." ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
    oa:untilAT 405 ;
    oa:yearAT 385 .
