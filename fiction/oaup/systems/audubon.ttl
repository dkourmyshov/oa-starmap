claim:event-world-audubon-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45eac09bed094> ;
    oa:about id:world-audubon ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Both inner system AIs finally entered an accord with the rival Linnent company transapient, O'Brien , in 7109 after the formal absorption of all 4 remaining Linnent Engenerator colonies into the NoCoZo.\" The accord itself is dated exactly to 7109; the 'formal absorption' it followed is not separately dated, only stated to have preceded it. An accord between the system's AIs and the LinnEnt transapient O'Brien; the reader read it as the Zone's absorption of the system, and the map's older 'visited 1392' has no sentence in the article." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 3 ;
    oa:yearAT 7109 .
