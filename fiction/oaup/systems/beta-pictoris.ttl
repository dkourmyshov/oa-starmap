@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Beta Pictoris

id:world-beta-pictoris a oa:Place, oa:World ;
    skos:prefLabel "Beta Pictoris" ;
    oa:article <https://www.orionsarm.com/eg-article/5de8fb490b641> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "64 ly out. The colony table carries this system as Vinci, giving the star name as the second of the pair; both names are on the map." ;
    oa:uncertain false .

claim:location-world-beta-pictoris a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5de8fb490b641> ;
    oa:about id:world-beta-pictoris ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Beta Pictoris" .

claim:affiliation-world-beta-pictoris-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5de8fb490b641> ;
    oa:about id:world-beta-pictoris ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-beta-pictoris-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5de8fb490b641> ;
    oa:about id:world-beta-pictoris ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
    oa:untilAT 1070 ;
    oa:yearAT 912 .

claim:event-world-beta-pictoris-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5de8fb490b641> ;
    oa:about id:world-beta-pictoris ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"the first exchanges encouraged the Federation to transmit ai diplomats (prototype FedReps) in 1076, who arrived in 1140.\" Diplomats dispatched 1076, arrived 1140; recorded under the arrival year. Prototype FedReps transmitted in 1076." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1140 .

claim:event-world-beta-pictoris-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5de8fb490b641> ;
    oa:about id:world-beta-pictoris ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"An enterprising hyperturing transmitted emself to the system, arriving in 1270.\" The hyperturing's origin/affiliation is not stated at the point of arrival; Beta Pictoris became a Metasoft satrapy afterward (see holder_undated). A hyperturing who transmitted emself; the Diamond Belt missions of 912 to 1070 were all defeated, and Exa Energy's probes of 948 to 967 are no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 1270 .
