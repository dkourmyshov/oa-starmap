# EG 471

id:star-eg-471 a oa:CelestiaStar, oa:Place, oa:Star ;
    skos:prefLabel "EG 471" ;
    oa:sourceName "EG 471" .

claim:celestia-star-eg-471-f14d2097d58c a prov:Entity, oa:CelestiaLocationClaim, oa:LocationClaim ;
    prov:hadPrimarySource src:celestia-addons ;
    oa:about id:star-eg-471 ;
    oa:absoluteMagnitude 14.81 ;
    oa:canonical true ;
    oa:declinationDeg -14.408 ;
    oa:distance value:celestia-star-eg-471-f14d2097d58c-distance ;
    oa:method oa:ImportedValue ;
    oa:rightAscensionDeg 37.5625 ;
    oa:sourceArchive "OAAddons1.zip" ;
    oa:sourceFile "oastars2-2.stc" ;
    oa:spectralType "DA2" .

value:celestia-star-eg-471-f14d2097d58c-distance a oa:QuantityValue ;
    qudt:numericValue 50.521 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-star-eg-471-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910e5c60edcc> ;
    oa:about id:star-eg-471 ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league .

claim:curation-star-eg-471 a prov:Entity, oa:SystemCuration ;
    oa:about id:star-eg-471 ;
    oa:article <https://www.orionsarm.com/eg-article/4910e5c60edcc> ;
    oa:editorialLabel "Wadai" ;
    oa:hidden false ;
    oa:note "In both source sets: the Celestia add-on as EG 471, and the Inner Sphere table as WD 0230-144 at 54.4 ly. The table's row does not resolve, because no WD or GJ 3162 designation appears in HYG — a white dwarf of absolute magnitude 14.8 is below Hipparcos and outside the Bright Star Catalogue. So the add-on's 50.5 ly is the only position we have for it, and it is a measurement rather than an assertion." ;
    oa:realObjectIdentity "GJ 3162, the white dwarf WD 0230-144" ;
    oa:uncertain false .

# Wadai

id:inner-sphere-row-0652 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
