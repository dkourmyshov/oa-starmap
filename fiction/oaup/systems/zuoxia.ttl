# Zuoxia

id:inner-sphere-row-0712 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Zuoxia" .

claim:inner-sphere-inner-sphere-row-0712-d6f574480022 a prov:Entity, oa:InnerSphereClaim ;
