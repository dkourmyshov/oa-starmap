# Cthonids

id:world-cthonids a oa:Place, oa:World ;
    skos:prefLabel "Cthonids" ;
    oa:article <https://www.orionsarm.com/eg-topic/464635ea58237> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "A xenosophont species, originating on a small low-gravity world of an unstable K8 V star in the Carina Arm, 3,950 ly out. The article places it near NGC 3496, and this map's catalogue has that cluster at 7,467 ly — nearly twice as far — so the cluster lends its direction and the stated 3,950 ly the radius. That reconciles this with Anaximander, whose article calls the Cthonids its nearest alien neighbours at 1,050 ly: the two placements here fall 1,083 ly apart, which is a check worth having, because neither position was derived from the other — one is a constellation centroid and the other a cluster's direction." ;
    oa:uncertain false .

claim:location-world-cthonids a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-topic/464635ea58237> ;
    oa:about id:world-cthonids ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -60.3325 ;
    oa:distance value:location-world-cthonids-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "NGC 3496" ;
    oa:rightAscensionDeg 164.8769 .

value:location-world-cthonids-distance a oa:QuantityValue ;
    qudt:numericValue 3950.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

