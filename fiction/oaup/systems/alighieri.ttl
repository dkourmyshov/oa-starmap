# Alighieri

id:inner-sphere-row-0634 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Alighieri" .

claim:inner-sphere-inner-sphere-row-0634-d21860ce6978 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0634 ;
    oa:canonical true ;
    oa:colonyName "Alighieri" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 633 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0634-d21860ce6978-source-distance ;
    oa:spectralType "M" ;
    oa:starName "Gliese 676 B" .

value:inner-sphere-inner-sphere-row-0634-d21860ce6978-source-distance a oa:QuantityValue ;
    qudt:numericValue 52.120 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
