@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Yanqiu

id:world-yanqiu a oa:Place, oa:World ;
    skos:prefLabel "Yanqiu" ;
    oa:article <https://www.orionsarm.com/eg-article/4f1569e126d8c> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Cepheus at 5,411 ly." ;
    oa:systemName "Yanqiu" ;
    oa:uncertain false .

claim:location-world-yanqiu a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f1569e126d8c> ;
    oa:about id:world-yanqiu ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Cepheus" ;
    oa:distance value:location-world-yanqiu-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-yanqiu-distance a oa:QuantityValue ;
    qudt:numericValue 5411.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-yanqiu-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f1569e126d8c> ;
    oa:about id:world-yanqiu ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 9801 .
