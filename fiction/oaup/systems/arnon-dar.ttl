# Arnon Dar

id:world-arnon-dar a oa:Place, oa:World ;
    skos:prefLabel "Arnon Dar" ;
    oa:article <https://www.orionsarm.com/eg-article/5025ec682d4a4> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:systemName "Arnon Dar" ;
    oa:uncertain false .

claim:location-world-arnon-dar a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5025ec682d4a4> ;
    oa:about id:world-arnon-dar ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In the Crucis Corridor, which is a volume of the setting rather than a direction." .

claim:affiliation-world-arnon-dar-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5025ec682d4a4> ;
    oa:about id:world-arnon-dar ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .
