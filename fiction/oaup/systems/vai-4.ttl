# VAI-4

id:world-vai-4 a oa:Place, oa:World ;
    skos:prefLabel "VAI-4" ;
    oa:article <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-vai-4 a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:about id:world-vai-4 ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 39.771802778 ;
    oa:distance value:location-world-vai-4-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is TYC 2945-191-1. It has no article of its own and is named in the one cited." ;
    oa:rightAscensionDeg 100.374116667 .

value:location-world-vai-4-distance a oa:QuantityValue ;
    qudt:numericValue 1853.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-vai-4-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:about id:world-vai-4 ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .
