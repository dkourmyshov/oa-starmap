# Cythera

id:world-cythera a oa:Place, oa:World ;
    skos:prefLabel "Cythera" ;
    oa:article <https://www.orionsarm.com/eg-article/4648fef23d4e6> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "HD 190771, as the colony table has it." ;
    oa:systemName "Cythera" ;
    oa:uncertain false .

claim:location-world-cythera a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4648fef23d4e6> ;
    oa:about id:world-cythera ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 190771" .

claim:event-world-cythera-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4648fef23d4e6> ;
    oa:about id:world-cythera ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised by the Ypperbach clade in 1958 AT.\" Holder is a clade (the Ypperbach, who became the Cythera clade), not a polity on the roster. The Ypperbach clade, no polity of this file; the panel's allegiance is independent." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1958 .

