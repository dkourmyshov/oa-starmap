# The Orange Polity

id:world-the-orange-polity a oa:Place, oa:World ;
    skos:prefLabel "The Orange Polity" ;
    oa:article <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-the-orange-polity a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:about id:world-the-orange-polity ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 43.838889 ;
    oa:distance value:location-world-the-orange-polity-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is YTS 2892-5093071. The article is its own. Its article places it \"on the border between Negentropy space and the MPA\", and this position falls in the Cygexpa and Zoeific volumes instead. The position is drawn as the add-on gives it and the discrepancy is recorded rather than resolved; it bears on Golden Globe and NoGo Solarius too, both cited to this article." ;
    oa:rightAscensionDeg 275.908333 .

value:location-world-the-orange-polity-distance a oa:QuantityValue ;
    qudt:numericValue 804.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-the-orange-polity-the-seams a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:about id:world-the-orange-polity ;
    oa:canonical true ;
    oa:polity id:polity-the-seams ;
    oa:recordOrder 0 .
