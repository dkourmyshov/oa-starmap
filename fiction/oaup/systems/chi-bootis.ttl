# Chi Bootis

id:world-chi-bootis a oa:Place, oa:World ;
    skos:prefLabel "Chi Bootis" ;
    oa:article <https://www.orionsarm.com/eg-article/4625883bc38f7> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Also written Chibootis, and named Kybutes in the setting. In Bootes, where the catalogue gives 244 ly against the article's 226 — an eight percent difference, close enough to bind to the star itself." ;
    oa:systemName "Chi Bootis" ;
    oa:uncertain false .

claim:location-world-chi-bootis a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4625883bc38f7> ;
    oa:about id:world-chi-bootis ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Chi Bootis" .

claim:affiliation-world-chi-bootis-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4625883bc38f7> ;
    oa:about id:world-chi-bootis ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
