claim:event-world-dorangloon-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f94f1a7f8db> ;
    oa:about id:world-dorangloon ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "From the Sesharia article: \"The last remnants [of the Doran Empire] including Dorannok (GL 877) entered the Terragen Federation in 5855.\"" ;
