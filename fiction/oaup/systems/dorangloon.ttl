# Dorangloon

id:world-dorangloon a oa:Place, oa:World ;
    skos:prefLabel "Dorangloon" ;
    oa:article <https://www.orionsarm.com/eg-article/464d0eddc8718> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 877, in Octans at 28 ly, and reached in 929 — the earliest date on either roster it appears in. It came here twice, once with the Solar Dominion and once with the Terragen Federation, from the one article; both are drawn rather than one being chosen." ;
    oa:systemName "Dorangloon" ;
    oa:uncertain false .

