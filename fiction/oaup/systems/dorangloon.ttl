    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464d0eddc8718> ;
    oa:about id:world-dorangloon ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised in 929 AT by the Doran clade, in the Gathol, a ship of their own construction.\" The Doran Empire's first world; the Sesharia article calls it Dorannok." ;
    oa:polity id:polity-doran-empire ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
