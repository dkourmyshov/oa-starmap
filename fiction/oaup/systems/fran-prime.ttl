@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Fran Prime

id:world-fran-prime a oa:Place, oa:World ;
    skos:prefLabel "Fran Prime" ;
    oa:article <https://www.orionsarm.com/eg-article/4650f64b979d6> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Vulpecula at 715 ly." ;
    oa:systemName "Fran Prime" ;
    oa:uncertain false .

claim:location-world-fran-prime a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4650f64b979d6> ;
    oa:about id:world-fran-prime ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Vulpecula" ;
    oa:distance value:location-world-fran-prime-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-fran-prime-distance a oa:QuantityValue ;
    qudt:numericValue 715.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
