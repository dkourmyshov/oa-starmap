# Cantor

id:star-cantor a oa:CelestiaStar, oa:Place, oa:Star ;
    skos:prefLabel "Cantor" ;
    oa:sourceName "Cantor" .

claim:celestia-star-cantor-438bb4b3bff2 a prov:Entity, oa:CelestiaLocationClaim, oa:LocationClaim ;
    prov:hadPrimarySource src:celestia-addons ;
    oa:about id:star-cantor ;
    oa:absoluteMagnitude 4.67 ;
    oa:canonical true ;
    oa:declinationDeg -54.842 ;
    oa:distance value:celestia-star-cantor-438bb4b3bff2-distance ;
    oa:method oa:ImportedValue ;
    oa:rightAscensionDeg 112.654 ;
    oa:sourceArchive "OAAddons1.zip" ;
    oa:sourceFile "cantor.stc" ;
    oa:spectralType "K0V" .

value:celestia-star-cantor-438bb4b3bff2-distance a oa:QuantityValue ;
    qudt:numericValue 2735.51 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-star-cantor-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:star-cantor ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods .

claim:curation-star-cantor a prov:Entity, oa:SystemCuration ;
    oa:about id:star-cantor ;
    oa:article <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:editorialLabel "Cantor" ;
    oa:hidden false ;
    oa:uncertain true .

# Chorus

id:world-chorus a oa:Place, oa:World ;
    skos:prefLabel "Chorus" ;
    oa:article <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The add-on independently confirms the article: it places Cantor in Carina at 2,736 ly against the article's Carina at 2,735 ly — two sources agreeing to four figures." ;
    oa:systemName "Cantor" ;
    oa:uncertain false .

claim:location-world-chorus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:oaStarName "Cantor" .

claim:affiliation-world-chorus-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .

claim:event-world-chorus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Explorers entered the system." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7953 .

claim:event-world-chorus-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Faber/Tavi exploration and development teams entered what they thought was a virgin system in 7953, and though they left Chorus strictly alone other than for scientific purposes, they began to develop the rest of the system.\" Header records this as 'visited 7953'; the prose describes ongoing development of the system, not just a visit. Fabers and Tavi are clades/groups, not on the polity roster (see unplaced). Faber and Tavi exploration and development teams, no polity of this file; the map's older 'visited 7953' is this arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 7953 .

claim:event-world-chorus-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"They made the existence of the new sapient clade public in 8677, after several centuries of development, and the Tavi and Faber colonists granted the new clade ownership of Chorus and the entire system\" Neither Faber/Tavi (grantor) nor Chorusmoot/Jade Chime Singers (grantee) are on the polity roster; see unplaced. Ownership transfer year is inferred from the same sentence as the 8677 public- disclosure date. Ownership granted to the Jade Chime Singers, the sapient clade the colonists had developed; no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 8677 .

claim:event-world-chorus-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:eventKind oa:Independent ;
    oa:note "\"Jade Chime Singers' Moot achieved full independence in 10377.\" Independence appears to be from the Faber/Tavi development lease, not from any roster polity; Chorusmoot (the local government) is not on the roster either. The Jade Chime Singers' Moot; independence from the Faber and Tavi colonists rather than from any polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 10377 .

claim:event-world-chorus-005 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fe1da7a2205> ;
    oa:about id:world-chorus ;
    oa:canonical true ;
    oa:eventKind oa:Stewardship ;
    oa:note "\"At undetermined point, probably not before the 7th millennium AT, Mist Rising, a transapient of Terragen origin, presumably explored the system and marked Chorus for eir own.\" Mist Rising's ethos is presumed to be a form of Caretakerism (see data panel AI's Ethos line). The article itself hedges this as 'undetermined' and 'presumably'. Mist Rising, 'at undetermined point, probably not before the 7th millennium'; the article's own hedge, kept." ;
    oa:polity id:polity-caretaker-gods ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 4 ;
    oa:yearAT 6000 .
