# Morpheo A

id:world-morpheo-a a oa:Place, oa:World ;
    skos:prefLabel "Morpheo A" ;
    oa:article <https://www.orionsarm.com/eg-article/47bcf7d1a1549> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Named for its star rather than its world, because the world was called Paz — a name this file already uses for a system in Draco — and because the Efficiency Maximization Paradigm has since taken the planet apart. In the Centaurus sector near NGC 5460 at 1,990 ly, which sits it among the Paradigm's other holdings: Budrosa at 1,783, Nirio at 1,800, Jekaumeatrine at 1,818." ;
    oa:systemName "Morpheo A" ;
    oa:uncertain false .

claim:location-world-morpheo-a a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47bcf7d1a1549> ;
    oa:about id:world-morpheo-a ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -48.2988 ;
    oa:distance value:location-world-morpheo-a-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "NGC 5460" ;
    oa:rightAscensionDeg 211.8148 .

value:location-world-morpheo-a-distance a oa:QuantityValue ;
    qudt:numericValue 1990.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

