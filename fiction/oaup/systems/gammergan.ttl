claim:event-world-gammergan-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464d338cc6026> ;
    oa:about id:world-gammergan ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"contact was re-established in 9885 when the Skiiws'nnii ship Namor entered the system.\" Skiiws'nnii is a species/clade, not a roster polity; see unplaced. The Skiiws'nnii ship Namor re-establishing contact; contact had been lost in 6580." ;
