# Gammergan

id:world-gammergan a oa:Place, oa:World ;
    skos:prefLabel "Gammergan" ;
    oa:article <https://www.orionsarm.com/eg-article/464d338cc6026> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "On the border, and held by both." ;
    oa:uncertain false .

claim:location-world-gammergan a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464d338cc6026> ;
    oa:about id:world-gammergan ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 5.801 ;
    oa:distance value:location-world-gammergan-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 265.9513 .

value:location-world-gammergan-distance a oa:QuantityValue ;
    qudt:numericValue 1702.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

