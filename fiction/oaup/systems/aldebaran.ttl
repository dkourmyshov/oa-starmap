    oa:about id:inner-sphere-row-0788 ;
    oa:article <https://www.orionsarm.com/eg-article/48f4938fd0487> ;
    oa:canonical true ;
    oa:colonyName "Aldebaran" ;
    oa:luminositySol "156 to 171" ;
    oa:massSol "2.5" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 787 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0788-8e239f9e8b86-source-distance ;
    oa:spectralType "K5 III" ;
    oa:starName "Alpha Tauri A" .

value:inner-sphere-inner-sphere-row-0788-8e239f9e8b86-source-distance a oa:QuantityValue ;
    qudt:numericValue 66.64 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
