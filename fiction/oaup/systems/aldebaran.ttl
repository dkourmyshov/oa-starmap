# Aldebaran

id:world-aldebaran a oa:Place, oa:World ;
    skos:prefLabel "Aldebaran" ;
    oa:article <https://www.orionsarm.com/eg-article/48f4938fd0487> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The eye of Taurus, 67 ly out, and independent — one of the nearer bright stars to hold to no empire." ;
    oa:systemName "Aldebaran" ;
    oa:uncertain false .

claim:location-world-aldebaran a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4938fd0487> ;
    oa:about id:world-aldebaran ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Aldebaran" .

claim:event-world-aldebaran-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4938fd0487> ;
    oa:about id:world-aldebaran ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The rise of the Conver Ambi was bad news for ADSP and the local corporate polity was undermined during the age of establishment by relativistic Conver Ambi colonisers (who originally posed as nomad clone-clade workers).\" The era is the timeline's 2600 to 3200; the article states no year at all." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
    oa:untilAT 3200 ;
    oa:yearAT 2600 .

# Aldebaran

id:inner-sphere-row-0788 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Aldebaran" .

claim:inner-sphere-inner-sphere-row-0788-8e239f9e8b86 a prov:Entity, oa:InnerSphereClaim ;
