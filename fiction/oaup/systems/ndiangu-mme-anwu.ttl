    oa:distance value:location-world-ndiangu-mme-anwu-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 259.4793 .

value:location-world-ndiangu-mme-anwu-distance a oa:QuantityValue ;
    qudt:numericValue 7816.0376 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

