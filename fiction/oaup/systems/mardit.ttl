# Mardit

id:inner-sphere-row-0151 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Mardit" .

claim:inner-sphere-inner-sphere-row-0151-a7d2878db1c3 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0151 ;
    oa:canonical true ;
    oa:colonyName "Mardit" ;
    oa:luminositySol "0.0000014.5" ;
    oa:massSol "64 x Jupiter" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 150 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0151-a7d2878db1c3-source-distance ;
    oa:spectralType "M9 brown dwarf" ;
    oa:starName "LP 944-20" .

value:inner-sphere-inner-sphere-row-0151-a7d2878db1c3-source-distance a oa:QuantityValue ;
    qudt:numericValue 20.961 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
