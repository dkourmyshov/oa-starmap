@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Delta Star

id:world-delta-star a oa:Place, oa:World ;
    skos:prefLabel "Delta Star" ;
    oa:article <https://www.orionsarm.com/eg-article/48acafcb42410> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-delta-star a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48acafcb42410> ;
    oa:about id:world-delta-star ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -38.631667 ;
    oa:distance value:location-world-delta-star-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. It has no article of its own and is named in the one cited. Named in the Alpha Star article and in the Seams' own." ;
    oa:rightAscensionDeg 280.4291667 .

value:location-world-delta-star-distance a oa:QuantityValue ;
    qudt:numericValue 876.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-delta-star-the-seams a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48acafcb42410> ;
    oa:about id:world-delta-star ;
    oa:canonical true ;
    oa:polity id:polity-the-seams ;
    oa:recordOrder 0 .
