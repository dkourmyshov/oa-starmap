@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Earth

id:world-earth a oa:Place, oa:World ;
    skos:prefLabel "Earth" ;
    oa:article <https://www.orionsarm.com/eg-article/462eae95003f8> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Under GAIA. Already on the map as the origin of the coordinate frame, so this entry adds the article rather than a position." ;
    oa:systemName "Sol" ;
    oa:uncertain false .

claim:location-world-earth a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462eae95003f8> ;
    oa:about id:world-earth ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Sol" .

claim:affiliation-world-earth-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462eae95003f8> ;
    oa:about id:world-earth ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .

claim:event-world-earth-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462eae95003f8> ;
    oa:about id:world-earth ;
    oa:canonical true ;
    oa:eventKind oa:Stewardship ;
    oa:note "The Great Expulsion by GAIA, the first Caretaker. Not a colonisation date — Earth is where the colonists came from — but the year its Caretaker took it, which is the same kind of event as Duxed's 2917." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 621 .
