    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/57f4e86a578dc> ;
    oa:about id:world-rihal ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 680 .

claim:event-world-rihal-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/57f4e86a578dc> ;
    oa:about id:world-rihal ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"this system was one of the first contacted by the Eridanus League in 783 but declined to join\" The system declined to join the Eridanus League, so this is recorded as visited rather than transferred. Contacted by the League, 'but declined to join'." ;
    oa:polity id:polity-eridanus-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 783 .

claim:event-world-rihal-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/57f4e86a578dc> ;
    oa:about id:world-rihal ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"After an economic crash in 950, the remaining colonists decided to align themselves with the new First Federation .\" 'The new First Federation', after the economic crash of 950." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 2 ;
    oa:yearAT 950 .

