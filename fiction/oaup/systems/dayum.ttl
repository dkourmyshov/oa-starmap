# Dayum

id:inner-sphere-row-0951 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Dayum" .

claim:inner-sphere-inner-sphere-row-0951-9b7f1899050a a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0951 ;
    oa:canonical true ;
    oa:colonyName "Dayum" ;
    oa:luminositySol "1.576" ;
    oa:massSol "1.13" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 950 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0951-9b7f1899050a-source-distance ;
    oa:spectralType "F8 V" ;
    oa:starName "HD 20367" .

value:inner-sphere-inner-sphere-row-0951-9b7f1899050a-source-distance a oa:QuantityValue ;
    qudt:numericValue 84.990 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
