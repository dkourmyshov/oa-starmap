@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Byran

id:world-byran a oa:Place, oa:World ;
    skos:altLabel "Byran Sector" ;
    skos:prefLabel "Byran" ;
    oa:article <https://www.orionsarm.com/eg-article/491232472b626> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-byran a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491232472b626> ;
    oa:about id:world-byran ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -8.05 ;
    oa:distance value:location-world-byran-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is YTS-3342-10-904. It has no article of its own and is named in the one cited. Named as non-aligned in the Tabridgen article. The add-on writes \"Byran Sector\"; the gazetteer writes \"Bryan\"." ;
    oa:rightAscensionDeg 115.25 .

value:location-world-byran-distance a oa:QuantityValue ;
    qudt:numericValue 2699.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
