# Golden Globe

id:world-golden-globe a oa:Place, oa:World ;
    skos:prefLabel "Golden Globe" ;
    oa:article <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-golden-globe a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:about id:world-golden-globe ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 38.3877222 ;
    oa:distance value:location-world-golden-globe-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is TYC-7916-2646-1. It has no article of its own and is named in the one cited. A Seams system lying in Mutual Progress Association volumes. See the Orange Polity's entry for the border question that covers it." ;
    oa:rightAscensionDeg 282.7628333 .

value:location-world-golden-globe-distance a oa:QuantityValue ;
    qudt:numericValue 1028.9 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-golden-globe-the-seams a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:about id:world-golden-globe ;
    oa:canonical true ;
    oa:polity id:polity-the-seams ;
    oa:recordOrder 0 .
