@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Medius

id:world-medius a oa:Place, oa:World ;
    skos:prefLabel "Medius" ;
    oa:article <https://www.orionsarm.com/eg-article/4902eb14ca7bc> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Erg is the primary. HIP 93229 is in Corona Australis at 280 ly." ;
    oa:parentName "Erg" ;
    oa:systemName "Medius" ;
    oa:uncertain false .

claim:location-world-medius a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4902eb14ca7bc> ;
    oa:about id:world-medius ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 93229 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-medius-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4902eb14ca7bc> ;
    oa:about id:world-medius ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .

claim:event-world-medius-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4902eb14ca7bc> ;
    oa:about id:world-medius ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Founded/Colonized: 2589\" Panel field gives no polity for the founding date itself; the system's local polity (United Habitats of Medius) and its MPA affiliation appear as separate, undated panel fields. The panel gives the date and the MPA affiliation as separate fields; the United Habitats of Medius is local." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2589 .

# Tar Vara

id:world-tar-vara a oa:Place, oa:World ;
    skos:prefLabel "Tar Vara" ;
    oa:article <https://www.orionsarm.com/eg-article/4a0cbb76669a3> ;
    oa:kind "habitat" ;
    oa:labelsSystem false ;
    oa:note "A habitat in the Medius system, and so on the same star." ;
    oa:systemName "Medius" ;
    oa:uncertain false .

claim:location-world-tar-vara a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a0cbb76669a3> ;
    oa:about id:world-tar-vara ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 93229 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-tar-vara-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a0cbb76669a3> ;
    oa:about id:world-tar-vara ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .
