# Unukalhai

id:inner-sphere-row-0857 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Unukalhai" .

claim:inner-sphere-inner-sphere-row-0857-71410d604554 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0857 ;
    oa:canonical true ;
    oa:colonyName "Unukalhai" ;
    oa:luminositySol "40" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 856 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0857-71410d604554-source-distance ;
    oa:spectralType "K2 III" ;
    oa:starName "Alpha Serpentis" .

value:inner-sphere-inner-sphere-row-0857-71410d604554-source-distance a oa:QuantityValue ;
    qudt:numericValue 74.219 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
