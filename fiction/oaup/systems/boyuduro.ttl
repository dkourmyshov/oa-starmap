# Boyuduro

id:world-boyuduro a oa:Place, oa:World ;
    skos:prefLabel "Boyuduro" ;
    oa:article <https://www.orionsarm.com/eg-article/47a1402105afd> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Triangulum Australe at 3,712 ly. The star's name is the setting's own and matches nothing in the catalogues here, so the constellation carries the direction." ;
    oa:systemName "Boyuduro" ;
    oa:uncertain false .

claim:location-world-boyuduro a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a1402105afd> ;
    oa:about id:world-boyuduro ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Triangulum Australe" ;
    oa:distance value:location-world-boyuduro-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-boyuduro-distance a oa:QuantityValue ;
    qudt:numericValue 3712.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-boyuduro-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a1402105afd> ;
    oa:about id:world-boyuduro ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7632 .

