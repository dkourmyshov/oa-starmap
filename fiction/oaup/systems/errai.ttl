# Anomie

id:world-anomie a oa:Place, oa:World ;
    skos:prefLabel "Anomie" ;
    oa:article <https://www.orionsarm.com/eg-article/48f9ecc17d772> ;
    oa:kind "moon" ;
    oa:labelsSystem false ;
    oa:note "Held jointly by the Communion of Worlds and the Sophic League. Anomie is a moon of the planet Tadmor, in the Errai system — Gamma Cephei, 45 ly, which is both the system's name and its primary's." ;
    oa:parentName "Tadmor" ;
    oa:systemName "Errai" ;
    oa:uncertain false .

claim:location-world-anomie a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9ecc17d772> ;
    oa:about id:world-anomie ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 222404 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-anomie-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9ecc17d772> ;
    oa:about id:world-anomie ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .

claim:affiliation-world-anomie-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9ecc17d772> ;
    oa:about id:world-anomie ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 1 .

claim:event-world-anomie-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9ecc17d772> ;
    oa:about id:world-anomie ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1420 .

# Errai

id:inner-sphere-row-0512 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Errai" .

claim:inner-sphere-inner-sphere-row-0512-87e544dea078 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0512 ;
    oa:article <https://www.orionsarm.com/eg-article/48f9ecc17d772> ;
    oa:canonical true ;
    oa:colonyName "Errai" ;
    oa:luminositySol "8.633" ;
    oa:massSol "1.6" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 511 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0512-87e544dea078-source-distance ;
    oa:spectralType "K1 Ive" ;
    oa:starName "Gamma Cephei A" .

value:inner-sphere-inner-sphere-row-0512-87e544dea078-source-distance a oa:QuantityValue ;
    qudt:numericValue 44.977 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
