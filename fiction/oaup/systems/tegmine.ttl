# Tegmine

id:inner-sphere-row-0908 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Tegmine" .

claim:inner-sphere-inner-sphere-row-0908-58d1017971cd a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0908 ;
    oa:canonical true ;
    oa:colonyName "Tegmine" ;
    oa:luminositySol "." ;
    oa:massSol "1.28" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 907 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0908-58d1017971cd-source-distance ;
    oa:spectralType "F7 V" ;
    oa:starName "Zeta Cancri A" .

value:inner-sphere-inner-sphere-row-0908-58d1017971cd-source-distance a oa:QuantityValue ;
    qudt:numericValue 79.768 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
