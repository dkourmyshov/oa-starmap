@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Amida

id:world-amida a oa:Place, oa:World ;
    skos:prefLabel "Amida" ;
    oa:article <https://www.orionsarm.com/eg-article/51e556cf3a54f> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Aquarius at 7,131 ly, among the furthest places in this file. The article's designation C2306265-085103 encodes a position a few arcminutes from the coordinates it also prints; the printed coordinates are used, and at this distance the difference is a handful of light years either way." ;
    oa:systemName "Amida" ;
    oa:uncertain false .

claim:location-world-amida a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/51e556cf3a54f> ;
    oa:about id:world-amida ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -8.8135 ;
    oa:distance value:location-world-amida-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 346.6575 .

value:location-world-amida-distance a oa:QuantityValue ;
    qudt:numericValue 7131.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-amida-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/51e556cf3a54f> ;
    oa:about id:world-amida ;
    oa:canonical true ;
    oa:eventKind oa:Observed ;
    oa:note "An extinct xenosophont civilisation found here." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 9871 .
