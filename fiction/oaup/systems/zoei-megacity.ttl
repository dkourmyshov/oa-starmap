# Zoei Megacity

id:world-zoei-megacity a oa:Place, oa:World ;
    skos:prefLabel "Zoei Megacity" ;
    oa:article <https://www.orionsarm.com/eg-article/48fca9d97f6c5> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-zoei-megacity a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fca9d97f6c5> ;
    oa:about id:world-zoei-megacity ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 21.769751833 ;
    oa:distance value:location-world-zoei-megacity-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 90139. It has no article of its own and is named in the one cited." ;
    oa:rightAscensionDeg 275.924540667 .

value:location-world-zoei-megacity-distance a oa:QuantityValue ;
    qudt:numericValue 118.952 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-zoei-megacity-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fca9d97f6c5> ;
    oa:about id:world-zoei-megacity ;
    oa:canonical true ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:recordOrder 0 .
