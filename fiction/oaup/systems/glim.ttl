    oa:spectralType "M0 V" ;
    oa:starName "HD 223889" .

value:inner-sphere-inner-sphere-row-0364-78fc14f6c76b-source-distance a oa:QuantityValue ;
    qudt:numericValue 32.995 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
