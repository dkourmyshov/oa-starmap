# Caph

id:world-caph a oa:Place, oa:World ;
    skos:prefLabel "Caph" ;
    oa:article <https://www.orionsarm.com/eg-article/4625899c756f8> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Beta Cassiopeiae, as the colony table has it." ;
    oa:systemName "Caph" ;
    oa:uncertain false .

claim:location-world-caph a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4625899c756f8> ;
    oa:about id:world-caph ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Beta Cassiopeiae" .

claim:event-world-caph-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4625899c756f8> ;
    oa:about id:world-caph ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Beta Cassiopeiae, known as Caph, 54.7 light-years from Sol, was colonized in 1532 AT using seed ships and parental vecs, and a successful vec-biont hybrid civilization developed there, nominally aligned with the Solar Dominion .\" The sentence gives the colonization date, but the 'nominally aligned with the Solar Dominion' clause is not clearly dated to 1532 itself; recorded separately below under holder_undated. Seed ships and parental vecs, on the pattern of the Federation programme the article implies but does not state; nominally Solarist since, undated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1532 .

