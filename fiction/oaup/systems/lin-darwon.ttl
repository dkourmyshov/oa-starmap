# Lin-Darwon

id:world-lin-darwon a oa:Place, oa:World ;
    skos:prefLabel "Lin-Darwon" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-lin-darwon a prov:Entity, oa:LocationClaim ;
    oa:about id:world-lin-darwon ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 42.4515 ;
    oa:derivation "Placed entirely by its distance from Ridgewell, which the source gives as 6 ly, and Ridgewell is Chi Herculis at 51.9 ly. So this lies on a sphere of 6 ly radius about a point known exactly, and the error is the same 6 ly whichever way it is measured — six and a half degrees across the sky at this range works out to the same six light years as along the line of sight. That makes it the one entry here whose uncertainty is a ball rather than a patch of shell: almost everything else estimated has an exact radius and a direction blurred across degrees of sky. Its own star, BD +39 2947, is in none of the catalogues here, and finding it under a designation they do carry would replace all of this with a position." ;
    oa:directionErrorDeg 6.6 ;
    oa:distance value:location-world-lin-darwon-distance ;
    oa:distanceError value:location-world-lin-darwon-distance-error ;
    oa:knownDistanceConflict false ;
    oa:method oa:EditorialEstimate ;
    oa:rightAscensionDeg 238.1689 .

value:location-world-lin-darwon-distance a oa:QuantityValue ;
    qudt:numericValue 52.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

value:location-world-lin-darwon-distance-error a oa:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

