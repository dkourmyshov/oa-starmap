    oa:about id:inner-sphere-row-0542 ;
    oa:article <https://www.orionsarm.com/eg-article/4681d6ec5d076> ;
    oa:canonical true ;
    oa:colonyName "Lin-Darwon" ;
    oa:luminositySol "0.39" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 541 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0542-37ee031e8e0b-source-distance ;
    oa:spectralType "G8 V" ;
    oa:starName "Gliese 611 A" .

value:inner-sphere-inner-sphere-row-0542-37ee031e8e0b-source-distance a oa:QuantityValue ;
    qudt:numericValue 46.834 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

