@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Dorminy IV

id:world-dorminy-iv a oa:Place, oa:World ;
    skos:prefLabel "Dorminy IV" ;
    oa:article <https://www.orionsarm.com/eg-article/464d0e44bc3c7> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Near NGC 3033, which is itself at 5,636 ly and so not a close neighbour." ;
    oa:systemName "Dorminy IV" ;
    oa:uncertain false .

claim:location-world-dorminy-iv a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464d0e44bc3c7> ;
    oa:about id:world-dorminy-iv ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Vela" ;
    oa:distance value:location-world-dorminy-iv-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-dorminy-iv-distance a oa:QuantityValue ;
    qudt:numericValue 929.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-dorminy-iv-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464d0e44bc3c7> ;
    oa:about id:world-dorminy-iv ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-dorminy-iv-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464d0e44bc3c7> ;
    oa:about id:world-dorminy-iv ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7010 .
