# Bolobo

id:world-bolobo a oa:Place, oa:World ;
    skos:prefLabel "Bolobo" ;
    oa:article <https://www.orionsarm.com/eg-article/486ff0a5e72d4> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Given as HR 8323. The colony table has the same system as Gliese 838.6 at 51 ly, under the name \"Nike (Bolobo Colony)\"." ;
    oa:uncertain false .

claim:location-world-bolobo a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ff0a5e72d4> ;
    oa:about id:world-bolobo ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 838.6" .

claim:affiliation-world-bolobo-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ff0a5e72d4> ;
    oa:about id:world-bolobo ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-bolobo-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ff0a5e72d4> ;
    oa:about id:world-bolobo ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:polity id:polity-linnent ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1822 .

claim:event-world-bolobo-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ff0a5e72d4> ;
    oa:about id:world-bolobo ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"a long forgotten drone probe sent from Vesta in 1020\" Probe sent by 'the defunct Vestacorp' (not on roster); see unplaced. Only the probe reached the system at this time, no colonists. A drone probe from Vesta, forgotten until contact was re-established in 1822." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1020 .

