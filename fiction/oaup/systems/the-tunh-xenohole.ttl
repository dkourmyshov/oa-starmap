claim:event-world-the-tunh-xenohole-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491418776bb70> ;
    oa:about id:world-the-tunh-xenohole ;
    oa:canonical true ;
    oa:eventKind oa:Contact ;
    oa:note "\"In 4094 it was discovered that the Tunnler wormhole in fact housed a powerful xenotech AI, which was still active, though largely dormant.\" Judgement call: treats the dormant Tunnler wormhole AI as the resident xenosophont contacted; the discoverers (Lagrange, Tunh Logika) are not on the roster. Flagged in doubts. The Tunnler wormhole's dormant xenotech AI." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 4094 .

claim:event-world-the-tunh-xenohole-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491418776bb70> ;
    oa:about id:world-the-tunh-xenohole ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Tunh Logika survived just barely, and when the Sagittarius Transcultural Cooperation was created this system was a founding member.\" The sentence does not itself give a numeral; the year 4805 is the Sagittarius Transcultural Cooperation's founding year from the roster, taken as the implied date of 'when the Sagittarius Transcultural Cooperation was created'. Flagged in doubts. A founding member of the Cooperation; the year is the Cooperation's founding from the timeline, the article giving none." ;
    oa:polity id:polity-sagittarius-transcultural-cooperation ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 4805 .
