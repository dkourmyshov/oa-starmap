    oa:catalogueFromSource false ;
    oa:declinationDeg -39.56 ;
    oa:distance value:location-world-the-tunh-xenohole-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "Neb 34786" ;
    oa:rightAscensionDeg 253.1595 .

