# Long Reach

id:world-long-reach a oa:Place, oa:World ;
    skos:prefLabel "Long Reach" ;
    oa:article <https://www.orionsarm.com/eg-article/491232472b626> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-long-reach a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491232472b626> ;
    oa:about id:world-long-reach ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -5.769461111 ;
    oa:distance value:location-world-long-reach-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is TYC 4811-614-1. It has no article of its own and is named in the one cited. The gazetteer's note on New Worlds for Old, the route reaching it, reads \"To Orion Federation\"." ;
    oa:rightAscensionDeg 100.396983333 .

value:location-world-long-reach-distance a oa:QuantityValue ;
    qudt:numericValue 2380.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-long-reach-orion-federation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491232472b626> ;
    oa:about id:world-long-reach ;
    oa:canonical true ;
    oa:polity id:polity-orion-federation ;
    oa:recordOrder 0 .
