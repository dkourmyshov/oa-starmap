claim:event-world-neo-helix-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46cf87ac11567> ;
    oa:about id:world-neo-helix ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised: 1191 AT\" No settling polity or group is named at this line; \"Clan Yall from House Genen\" is credited elsewhere with designing the ecosystem, but the text does not tie that credit to this date. The Zoeific Biopolity assumed its management after the Age of Crisis, undated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1191 .
