# Dalim

id:inner-sphere-row-0520 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Dalim" .

claim:inner-sphere-inner-sphere-row-0520-3cceeeb8b543 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0520 ;
    oa:canonical true ;
    oa:colonyName "Dalim" ;
    oa:luminositySol "4.563" ;
    oa:massSol "1.5" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 519 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0520-3cceeeb8b543-source-distance ;
    oa:spectralType "F7 IV" ;
    oa:starName "Alpha Fornacis A" .

value:inner-sphere-inner-sphere-row-0520-3cceeeb8b543-source-distance a oa:QuantityValue ;
    qudt:numericValue 45.659 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
