# Cog

id:world-cog a oa:Place, oa:World ;
    skos:prefLabel "Cog" ;
    oa:article <https://www.orionsarm.com/eg-article/462a6ca1b0077> ;
    oa:editorialNote "---- Stellar Umma --------------------------------------------------------" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "HD 190470 in Vulpecula, 72 ly out, and already in the colony table — this entry adds the article and the date the table has no column for." ;
    oa:uncertain false .

claim:location-world-cog a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462a6ca1b0077> ;
    oa:about id:world-cog ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-cog-distance ;
    oa:hdId 190470 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-cog-distance a oa:QuantityValue ;
    qudt:numericValue 72.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-cog-silicon-generation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462a6ca1b0077> ;
    oa:about id:world-cog ;
    oa:canonical true ;
    oa:polity id:polity-silicon-generation ;
    oa:recordOrder 0 .

claim:event-world-cog-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462a6ca1b0077> ;
    oa:about id:world-cog ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1405 .

claim:event-world-cog-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/462a6ca1b0077> ;
    oa:about id:world-cog ;
    oa:canonical true ;
    oa:eventKind oa:Observed ;
    oa:note "\"When this structure was discovered in 1698 AT it was labeled \"Cog\" by certain sensationalist sectors of the Known Net .\" External observation/naming of the already-settled system's Dyson swarm, not a separate settlement. Discovered by outsiders and labelled Cog on the Known Net, three centuries after its colonisation." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1698 .

