    prov:hadPrimarySource src:celestia-addons ;
    oa:about id:star-yts-233-091-0998 ;
    oa:absoluteMagnitude 4.76 ;
    oa:canonical true ;
    oa:declinationDeg 64.101 ;
    oa:distance value:celestia-star-yts-233-091-0998-73f0e25501bb-distance ;
    oa:method oa:ImportedValue ;
    oa:rightAscensionDeg 65.7101 ;
    oa:sourceArchive "Cenote.zip" ;
    oa:sourceComment "star for Cenote and Sequence" ;
    oa:sourceFile "astarsaroundCenote.stc" ;
    oa:sourceSystemName "Cenote and Sequence" ;
