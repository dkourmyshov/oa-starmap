# Cenote

id:world-cenote a oa:Place, oa:World ;
    skos:prefLabel "Cenote" ;
    oa:article <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Designated YTS 233-091-0998, which is Orion's Arm's own numbering — and the add-on carries that star, so this is placed by an asserted position rather than by the width of Camelopardalis. Five more stars of the group lie within a degree, one of them the sun of Sequence." ;
    oa:systemName "Cenote" ;
    oa:uncertain false .

claim:location-world-cenote a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:about id:world-cenote ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:oaStarName "YTS 233-091-0998" .

claim:affiliation-world-cenote-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:about id:world-cenote ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-cenote-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:about id:world-cenote ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7107 .

claim:event-world-cenote-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-cenote ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Cenote colonised by Solar Dominion ." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Age of Crisis" ;
    oa:yearAT 7017 .

claim:event-world-cenote-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:about id:world-cenote ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The Solar Dominion long distance linelayer Yucatan arrived in 7107 with a micro wormhole and a small cargo of digitised colonists, who were to be given new bodies on arrival.\" The header labels this event 'visited 7107', but the sentence describes colonists arriving to be embodied and stay, which reads as settlement rather than a visit. The linelayer Yucatan with digitised colonists to be embodied; the map's older 'settled 7017' has no sentence in the article." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 7107 .

# YTS 233-091-0998

id:star-yts-233-091-0998 a oa:CelestiaStar, oa:Place, oa:Star ;
    skos:prefLabel "YTS 233-091-0998" ;
    oa:sourceName "YTS 233-091-0998" .

