    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-star-yts-233-091-0998-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:about id:star-yts-233-091-0998 ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion .

claim:curation-star-yts-233-091-0998 a prov:Entity, oa:SystemCuration ;
    oa:about id:star-yts-233-091-0998 ;
    oa:article <https://www.orionsarm.com/eg-article/491c2e73c4188> ;
    oa:editorialLabel "Cenote" ;
    oa:hidden false ;
    oa:note "The star Cenote's own article names, and now with a position rather than only a constellation: the add-on puts it at 3,075 ly, the distance the article gives. Five more stars of the same group sit within a degree of it, one of them the sun of Sequence." ;
    oa:uncertain false .
