    oa:about id:world-refugium ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5740 .

claim:event-world-refugium-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-refugium ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "The first relativistic colony ships of the Semperist Survival Fleet reached Refugium , an easily terraformable terrestrial world approximately 2200 lightyears from Sol." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Re-Evaluation" ;
    oa:yearAT 5740 .

claim:event-world-refugium-003 a prov:Entity, oa:EventClaim ;
    oa:about id:world-refugium ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Salaam colonised by the Refugium Federation." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Separate Empires" ;
    oa:yearAT 5989 .

claim:event-world-refugium-004 a prov:Entity, oa:EventClaim ;
    oa:about id:world-refugium ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "The Refugium Federation has expanded to a 100 lightyear sphere, including 20 colonised systems. Contacts are by tightbeam laser, and most inhabitants believed that by now the rest of mankind would have destroyed itself or transformed int..." ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:sourceDescription "Encyclopaedia timeline, Age of Separate Empires" ;
    oa:yearAT 6000 .

claim:event-world-refugium-005 a prov:Entity, oa:EventClaim ;
    oa:about id:world-refugium ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "A contact fleet launched from Polonius (see Refugium Federation ) reaches a nearby world, and diplomatic contact begins. The aliens turn out to be Kestnerists. The Kestnerists give the Semperists the news that humankind has survived. The..." ;
    oa:precision oa:Exact ;
    oa:recordOrder 4 ;
    oa:sourceDescription "Encyclopaedia timeline, The Age of Crisis" ;
    oa:yearAT 6916 .
