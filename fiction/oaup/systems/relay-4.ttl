# Relay 4

id:inner-sphere-row-0271 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Relay 4" .

claim:inner-sphere-inner-sphere-row-0271-e25143e8b7ea a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0271 ;
    oa:canonical true ;
    oa:colonyName "Relay 4" ;
    oa:luminositySol "0.157" ;
    oa:massSol "0.6" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 270 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0271-e25143e8b7ea-source-distance ;
    oa:spectralType "K3 V" ;
    oa:starName "HD 50281 A" .

value:inner-sphere-inner-sphere-row-0271-e25143e8b7ea-source-distance a oa:QuantityValue ;
    qudt:numericValue 28.521 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

