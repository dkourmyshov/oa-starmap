# Relay 7

id:inner-sphere-row-0679 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Relay 7" .

claim:inner-sphere-inner-sphere-row-0679-e08090c723f0 a prov:Entity, oa:InnerSphereClaim ;
