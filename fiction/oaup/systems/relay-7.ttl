    oa:about id:inner-sphere-row-0679 ;
    oa:canonical true ;
    oa:colonyName "Relay 7" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 678 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0679-e08090c723f0-source-distance ;
    oa:spectralType "." ;
    oa:starName "10 Canum Venaticorum" .

value:inner-sphere-inner-sphere-row-0679-e08090c723f0-source-distance a oa:QuantityValue ;
    qudt:numericValue 57.262 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
