# Arkady 2

id:world-arkady-2 a oa:Place, oa:World ;
    skos:prefLabel "Arkady 2" ;
    oa:article <https://www.orionsarm.com/eg-article/48ff3802ed02e> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:systemName "Toke" ;
    oa:uncertain false .

claim:location-world-arkady-2 a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff3802ed02e> ;
    oa:about id:world-arkady-2 ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -62.6264 ;
    oa:distance value:location-world-arkady-2-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In the outer Non-Coercive Zone, on the long Carina Trade of wormholes towards the Carina Rush — which the article gives as a route rather than a position. The position is from the Orion's Arm Celestia add-ons' location catalogues (OAAddons9, OALocationsv4; extracted to sources/derived/oa_dsc_locations.tsv), which the star importer never read because it takes only .stc files. It falls in Carina, which is what the article's own Carina Trade and Carina Rush imply, and nothing else here places this world." ;
    oa:rightAscensionDeg 162.1875 .

value:location-world-arkady-2-distance a oa:QuantityValue ;
    qudt:numericValue 2698.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-arkady-2-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff3802ed02e> ;
    oa:about id:world-arkady-2 ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .
