@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Oquendo

id:world-oquendo a oa:Place, oa:World ;
    skos:prefLabel "Oquendo" ;
    oa:article <https://www.orionsarm.com/eg-article/58db9b4a098ed> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In the Outer Volumes, down the Camelopardalis sector. No holder is recorded." ;
    oa:uncertain false .

claim:location-world-oquendo a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/58db9b4a098ed> ;
    oa:about id:world-oquendo ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Camelopardalis" ;
    oa:distance value:location-world-oquendo-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-oquendo-distance a oa:QuantityValue ;
    qudt:numericValue 4642.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-oquendo-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/58db9b4a098ed> ;
    oa:about id:world-oquendo ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 8550 .
