# Threshold

id:world-threshold a oa:Place, oa:World ;
    skos:prefLabel "Threshold" ;
    oa:article <https://www.orionsarm.com/eg-article/47a3e440c01a5> ;
    oa:editorialNote "---- Negentropy Alliance -------------------------------------------------\n\nNine of these twenty-two carry no position at all, which is the highest\nproportion of any polity here. Most are located by Orion's Arm's own region\nnames — the Crucis Corridor, the Centaurus sector, the Centauri sector —\nwhich name volumes of the setting rather than directions on the sky, and\nthis map has no table of them. See questions.md." ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:systemName "Threshold" ;
    oa:uncertain false .

claim:location-world-threshold a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a3e440c01a5> ;
    oa:about id:world-threshold ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "A black hole, Sco BH-76. The designation is Orion's Arm's own and matches nothing this map carries; no distance or coordinates are given." .

claim:affiliation-world-threshold-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a3e440c01a5> ;
    oa:about id:world-threshold ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .

claim:event-world-threshold-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47a3e440c01a5> ;
    oa:about id:world-threshold ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Dynamic orbital rings built close to the event horizon." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5100 .
