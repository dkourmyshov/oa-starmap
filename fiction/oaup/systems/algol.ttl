# Algol

id:world-algol a oa:Place, oa:World ;
    skos:prefLabel "Algol" ;
    oa:article <https://www.orionsarm.com/eg-article/45ecdfff13c09> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Beta Persei, 90 ly. The colony table holds an unresolved assignment for it." ;
    oa:systemName "Algol" ;
    oa:uncertain false .

claim:location-world-algol a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45ecdfff13c09> ;
    oa:about id:world-algol ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Algol" .

claim:affiliation-world-algol-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45ecdfff13c09> ;
    oa:about id:world-algol ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

# Algol

id:inner-sphere-row-1015 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Algol" .

claim:inner-sphere-inner-sphere-row-1015-a5ac33fc9dc0 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-1015 ;
    oa:article <https://www.orionsarm.com/eg-article/45ecdf18385f5> ;
    oa:canonical true ;
    oa:colonyName "Algol" ;
    oa:luminositySol "84" ;
    oa:massSol "3.7" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 1014 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-1015-a5ac33fc9dc0-source-distance ;
    oa:spectralType "B8 V" ;
    oa:starName "Beta Persei Aa1" .

value:inner-sphere-inner-sphere-row-1015-a5ac33fc9dc0-source-distance a oa:QuantityValue ;
    qudt:numericValue 89.92 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
