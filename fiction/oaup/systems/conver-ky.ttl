# Conver Ky

id:world-conver-ky a oa:Place, oa:World ;
    skos:prefLabel "Conver Ky" ;
    oa:article <https://www.orionsarm.com/eg-article/463a95fc3fb97> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "37 Geminorum, as the colony table has it." ;
    oa:systemName "Conver Ky" ;
    oa:uncertain false .

claim:location-world-conver-ky a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/463a95fc3fb97> ;
    oa:about id:world-conver-ky ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "37 Geminorum" .

claim:event-world-conver-ky-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/463a95fc3fb97> ;
    oa:about id:world-conver-ky ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised 1866 AT\" No settling polity or group is named in the text for this date. The timeline has the world earlier: circa 1800, \"On the important corporate outpost of 37 Geminorum I there develops an ideology of corporate theism and monomegist supremacy\", the link pointing at this article." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1866 .

claim:event-world-conver-ky-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-conver-ky ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"Conver Ky was the capital of the Conver Ambi up until the Conver War.\" The article dates neither; the Ambi's establishment is the timeline's 1984 (\"Birnam Ecotech joins the Transtellar Cooperative Pact, resulting in the establishment of the Conver Ambi\") and the Conver War its 3713. The Ambi's division of 3943 ends the holding; which of its three parts took the old capital, no saved page says." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, 1984 and 3713" ;
    oa:yearAT 1984 .

claim:event-world-conver-ky-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4bb5d6c578611> ;
    oa:about id:world-conver-ky ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "The Wasat article: \"In the aftermath of the war, Wasat, the important wormhole hub Conver Ky, and several other core Conver systems became part of the Solar Dominion.\" The year is the peace accords' on the timeline. The colony table gives the system no present affiliation, and nothing saved says it left the Dominion. As the project owner describes it: nominally Solar Dominion still, but the system was never fully cleaned up after the Conver War and remains dangerous to this day. No saved article says so; kept here on that authority rather than a citation." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 3943 .

