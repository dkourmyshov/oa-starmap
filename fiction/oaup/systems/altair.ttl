@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://dkourmyshov.github.io/oa-starmap/source/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Altair

id:world-altair a oa:Place, oa:World ;
    skos:prefLabel "Altair" ;
    oa:article <https://www.orionsarm.com/eg-article/45f0c3797f2fa> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "17 ly out in Aquila." ;
    oa:uncertain false .

claim:location-world-altair a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0c3797f2fa> ;
    oa:about id:world-altair ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Altair" .

claim:affiliation-world-altair-diamond-network a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0c3797f2fa> ;
    oa:about id:world-altair ;
    oa:canonical true ;
    oa:polity id:polity-diamond-network ;
    oa:recordOrder 0 .

claim:event-world-altair-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0c3797f2fa> ;
    oa:about id:world-altair ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Occupied." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 550 .

# Altair

id:inner-sphere-row-0086 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Altair" .

claim:inner-sphere-inner-sphere-row-0086-6129f200cac6 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0086 ;
    oa:article <https://www.orionsarm.com/eg-article/45f0c3797f2fa> ;
    oa:canonical true ;
    oa:colonyName "Altair" ;
    oa:luminositySol "11.39" ;
    oa:massSol "2" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 85 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0086-6129f200cac6-source-distance ;
    oa:spectralType "A7 V" ;
    oa:starName "Alpha Aquilae" .

value:inner-sphere-inner-sphere-row-0086-6129f200cac6-source-distance a oa:QuantityValue ;
    qudt:numericValue 16.730 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
