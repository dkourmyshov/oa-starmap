# Cyrus

id:world-cyrus a oa:Place, oa:World ;
    skos:prefLabel "Cyrus" ;
    oa:article <https://www.orionsarm.com/eg-article/55e84f2e1dfa4> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "4,357 ly out, and that is the whole of it: no constellation and no coordinates, so there is a radius and no direction, and nothing is drawn. Its beamrider links reach the Blackbody Cluster in the Perseus Rift and Mollweide at 3,866 ly in Cygnus, but a route is not a direction — and the Blackbody Cluster is itself only interpolated, to a thousand light years." ;
    oa:uncertain false .

claim:location-world-cyrus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/55e84f2e1dfa4> ;
    oa:about id:world-cyrus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-cyrus-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-cyrus-distance a oa:QuantityValue ;
    qudt:numericValue 4357.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-cyrus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/55e84f2e1dfa4> ;
    oa:about id:world-cyrus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 9107 .

claim:event-world-cyrus-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/55e84f2e1dfa4> ;
    oa:about id:world-cyrus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The Cyrus system was initially settled by a relativistic 'claim staking' operation from the Chauzor megacorp, an organisation which was defunct by the time the hyperturing probe Prismatic Helium-3 arrived in 8437AT.\" Chauzor megacorp is not on the roster (see unplaced); its own claim-staking 'settlement' is undated. Prismatic Helium-3, also not on the roster, arrived in 8437 AT to find the claim already defunct and went on to found a vec colony -- this reads as the article's own settlement narrative, in tension with the panel's 9107 AT figure. The Chauzor megacorp's claim-staking operation, no polity of this file; the panel's 'Colonized 9107' is kept beside it." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 8437 .

claim:event-world-cyrus-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/55e84f2e1dfa4> ;
    oa:about id:world-cyrus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"In 9200AT, Prismatic Helium-3's Hydrogen Republic was contacted by a biont colonial developer who expressed interest in the eoGaian world Zamin. The Hydrogen Republic accepted the request and negotiated limits on development, while positioning itself as the recognized owner of the Cyrus system. The new settlers were granted extended leases.\" First biont (neb) settlement of Zamin, the system's main colony world. Hydrogen Republic is not on the roster; the biont developer is not named. Neither 9107 AT nor 8437 AT is repeated here. The Hydrogen Republic, local, accepting a biont colonial developer for Zamin." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 9200 .
