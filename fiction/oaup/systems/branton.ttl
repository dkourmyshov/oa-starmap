@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Branton

id:world-branton a oa:Place, oa:World ;
    skos:prefLabel "Branton" ;
    oa:article <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In the outer Cassiopeia sector, read as the volume behind the constellation. The star is TYC 3663-2842-1, from a catalogue this map does not carry. Re-colonised by the Solar Dominion, which is the present holder and the only one this system has ever had: the Xeon blight originated here in 8995 and left, and the entry no longer records it as having held the place." ;
    oa:systemName "Branton" ;
    oa:uncertain false .

claim:location-world-branton a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:about id:world-branton ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Cassiopeia" ;
    oa:distance value:location-world-branton-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-branton-distance a oa:QuantityValue ;
    qudt:numericValue 3305.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-branton-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:about id:world-branton ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-branton-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:about id:world-branton ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7866 .

claim:event-world-branton-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:about id:world-branton ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "Possibly where Xeon originated." ;
    oa:precision oa:Circa ;
    oa:recordOrder 1 ;
    oa:yearAT 8995 .

claim:event-world-branton-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:about id:world-branton ;
    oa:canonical true ;
    oa:eventKind oa:Contact ;
    oa:note "\"In 8995 the colonists in this system were subsumed by a rogue hyperturing, believed to be an Exploration Rover class 4 S:1. This entity appears to have used the hapless colonists as a biotic matrix for the Xeon blight.\" Recorded as contact and not as a transfer to Xeon, which is what this entry used to say. Nothing held Branton here: the entity subsumed the colonists and then, in the article's own words, \"abandoned this world to establish a minor empire several hundred light years to rimward\". A rescue fleet in 9010 found the system empty. Xeon begins here and never possesses the place, and the roster's founding year of 9210 sits later than this in any case." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 8995 .

claim:event-world-branton-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611935cb9c74> ;
    oa:about id:world-branton ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"A new wave of colonists began to arrive in this system soon afterwards from the Solar Dominion , and mostly inhabit orbiting space habitats and the moon Vali, while preserving the environment of Sigyn as a nature reserve.\" 'soon afterwards' the 9010at discovery of the empty system. A new wave of colonists from the Dominion, 'soon afterwards' the rescue fleet of 9010 found the system empty." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 3 ;
    oa:yearAT 9010 .
