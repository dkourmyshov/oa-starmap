# Unon-Duuz

id:world-unon-duuz a oa:Place, oa:World ;
    skos:prefLabel "Unon-Duuz" ;
    oa:article <https://www.orionsarm.com/eg-article/57699df2f2118> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "A triple: GJ 1245 A, B and C, 15 ly out in Cygnus. Bound to the primary, the map going no finer than a system." ;
    oa:uncertain false .

claim:location-world-unon-duuz a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/57699df2f2118> ;
    oa:about id:world-unon-duuz ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "GJ 1245 A" .

claim:affiliation-world-unon-duuz-terragen-federation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/57699df2f2118> ;
    oa:about id:world-unon-duuz ;
    oa:canonical true ;
    oa:polity id:polity-terragen-federation ;
    oa:recordOrder 0 .

claim:event-world-unon-duuz-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/57699df2f2118> ;
    oa:about id:world-unon-duuz ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1203 .

