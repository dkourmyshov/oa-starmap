# Halcyon

id:world-halcyon a oa:Place, oa:World ;
    skos:prefLabel "Halcyon" ;
    oa:article <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "20 Leonis Minoris, 49 ly. The name is both the system's and the star's." ;
    oa:systemName "Halcyon" ;
    oa:uncertain false .

claim:location-world-halcyon a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:about id:world-halcyon ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "20 Leonis Minoris" .

claim:affiliation-world-halcyon-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:about id:world-halcyon ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .

claim:event-world-halcyon-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:about id:world-halcyon ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1402 .

# Halcyon

id:inner-sphere-row-0593 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Halcyon" .

claim:inner-sphere-inner-sphere-row-0593-22d4fadd7892 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0593 ;
    oa:article <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:canonical true ;
    oa:colonyName "Halcyon" ;
    oa:luminositySol "1.37" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 592 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0593-22d4fadd7892-source-distance ;
    oa:spectralType "G2 V" ;
    oa:starName "20 Leonis Minoris" .

value:inner-sphere-inner-sphere-row-0593-22d4fadd7892-source-distance a oa:QuantityValue ;
    qudt:numericValue 48.683 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
