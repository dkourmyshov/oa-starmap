@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Alpha Star

id:world-alpha-star a oa:Place, oa:World ;
    skos:prefLabel "Alpha Star" ;
    oa:article <https://www.orionsarm.com/eg-article/48acafcb42410> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-alpha-star a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48acafcb42410> ;
    oa:about id:world-alpha-star ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -45.4483333 ;
    oa:distance value:location-world-alpha-star-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is YTS 2915-15824332. The article is its own. Described as on the Negentropy-Keter border, which this position does not obviously bear out; worth checking." ;
    oa:rightAscensionDeg 269.41666 .

value:location-world-alpha-star-distance a oa:QuantityValue ;
    qudt:numericValue 809.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-alpha-star-the-seams a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48acafcb42410> ;
    oa:about id:world-alpha-star ;
    oa:canonical true ;
    oa:polity id:polity-the-seams ;
    oa:recordOrder 0 .
