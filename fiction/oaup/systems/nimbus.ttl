# Nimbus

id:world-nimbus a oa:Place, oa:World ;
    skos:prefLabel "Nimbus" ;
    oa:article <https://www.orionsarm.com/eg-article/46d4d49a72fec> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "58 Eridani, as the colony table has it." ;
    oa:systemName "Nimbus" ;
    oa:uncertain false .

claim:location-world-nimbus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d4d49a72fec> ;
    oa:about id:world-nimbus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "58 Eridani" .

claim:event-world-nimbus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d4d49a72fec> ;
    oa:about id:world-nimbus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"In 1716 it moved its headquarters to the Novoterra system where it set to terraform the planet Novoterra into a showpiece of nanotech macroengineering and integration.\" 'It' is Ubikorp, a megacorporation of the First Federation era, not a polity on the roster (see unplaced). It is not clear from the text whether Novoterra was already settled before this, or whether this is its first development. Ubikorp, a megacorporation, moving its headquarters; the article gives no earlier settlement." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1716 .

claim:event-world-nimbus-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46d4d49a72fec> ;
    oa:about id:world-nimbus ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"When contact was restored in 2123, Novoterra - now called Nimbus - became a neutral part of the Empire.\" 'the Empire' is not identified by name with any roster polity; see unplaced. 'The Empire' is not named further in the sentence; left unplaced." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2123 .

