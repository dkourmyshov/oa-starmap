# Alpamis

id:world-alpamis a oa:Place, oa:World ;
    skos:prefLabel "Alpamis" ;
    oa:article <https://www.orionsarm.com/eg-article/45e77cd829bbd> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:systemName "Alpamis" ;
    oa:uncertain false .

claim:location-world-alpamis a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77cd829bbd> ;
    oa:about id:world-alpamis ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Pi Mensae" .

claim:affiliation-world-alpamis-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77cd829bbd> ;
    oa:about id:world-alpamis ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-alpamis-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77cd829bbd> ;
    oa:about id:world-alpamis ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1831 .

claim:event-world-alpamis-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77cd829bbd> ;
    oa:about id:world-alpamis ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Reached 1831, by colonists aboard the Kadoluk .\" Header records this place as already-dated 'visited 1831'; the panel calls the arrivals 'colonists' and the body (same year) says they founded a colony, so this reads as a settlement rather than a mere visit -- flagged as a kind conflict, not just recorded as visited. Parrot provolves aboard the Kadoluk; the map's older 'visited 1831' is this arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1831 .

