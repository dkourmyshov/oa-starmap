# Wazn

id:inner-sphere-row-1002 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Wazn" .

claim:inner-sphere-inner-sphere-row-1002-457ea7ba95c3 a prov:Entity, oa:InnerSphereClaim ;
