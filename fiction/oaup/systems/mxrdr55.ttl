@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# MXRDR55

id:world-mxrdr55 a oa:Place, oa:World ;
    skos:prefLabel "MXRDR55" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-mxrdr55 a prov:Entity, oa:LocationClaim ;
    oa:about id:world-mxrdr55 ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -32.216666667 ;
    oa:distance value:location-world-mxrdr55-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. No article names it. No polity recorded, and no article: it survives in the gazetteer and in a chronology that refers to the Cableville article, which does not mention it." ;
    oa:rightAscensionDeg 265.0 .

value:location-world-mxrdr55-distance a oa:QuantityValue ;
    qudt:numericValue 1551.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
