# Mfunu

id:inner-sphere-row-0443 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Mfunu" .

claim:inner-sphere-inner-sphere-row-0443-669c104b8b86 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0443 ;
    oa:canonical true ;
    oa:colonyName "Mfunu" ;
    oa:luminositySol "." ;
    oa:massSol "1.12" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 442 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0443-669c104b8b86-source-distance ;
    oa:spectralType "F9 V" ;
    oa:starName "Zeta Trianguli Australis A" .

value:inner-sphere-inner-sphere-row-0443-669c104b8b86-source-distance a oa:QuantityValue ;
    qudt:numericValue 39.358 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

