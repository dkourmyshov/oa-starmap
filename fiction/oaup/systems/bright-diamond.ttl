# Bright Diamond

id:inner-sphere-row-0079 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Bright Diamond" .

claim:inner-sphere-inner-sphere-row-0079-bd97045f7931 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0079 ;
    oa:canonical true ;
    oa:colonyName "Bright Diamond" ;
    oa:luminositySol "0.00345" ;
    oa:massSol "0.44" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 78 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0079-bd97045f7931-source-distance ;
    oa:spectralType "DA4 VII" ;
    oa:starName "Omicron2 Eridani B" .

value:inner-sphere-inner-sphere-row-0079-bd97045f7931-source-distance a oa:QuantityValue ;
    qudt:numericValue 16.340 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
