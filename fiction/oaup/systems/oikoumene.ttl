# Oikoumene

id:inner-sphere-row-0862 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Oikoumene" .

claim:inner-sphere-inner-sphere-row-0862-d8c61be1ffd4 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
