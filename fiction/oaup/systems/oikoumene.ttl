# Oikoumene Dyson

id:world-oikoumene-dyson a oa:Place, oa:World ;
    skos:prefLabel "Oikoumene Dyson" ;
    oa:article <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "Zeta Serpentis, 75 ly — an Inner Sphere system." ;
    oa:systemName "Oikoumene" ;
    oa:uncertain false .

claim:location-world-oikoumene-dyson a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:about id:world-oikoumene-dyson ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-oikoumene-dyson-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Zeta Serpentis" .

value:location-world-oikoumene-dyson-distance a oa:QuantityValue ;
    qudt:numericValue 75.7 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-oikoumene-dyson-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:about id:world-oikoumene-dyson ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .

claim:event-world-oikoumene-dyson-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:about id:world-oikoumene-dyson ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached, only to find an ahuman colony already established there. A first visit that was not a first arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1521 .

claim:event-world-oikoumene-dyson-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:about id:world-oikoumene-dyson ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The K4H decided to dig in on the outer belt, as well as appropriate some frozen kuiper bodies and an inner rockball.\" Same year and continuous narrative as the \"reached\" clause above, but this clause describes staying rather than merely arriving; the header records this year only as visited. See contradictions. The K4H development project, finding a Diamond Belt colony already there; the map's older 'visited 1521' is this arrival." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1521 .

claim:event-world-oikoumene-dyson-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:about id:world-oikoumene-dyson ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Diamond Belt neumann colony thought to have been established c. 1470s - 1480s\" Panel gives a two-decade approximate range, \"c. 1470s - 1480s\"; year_at is the earlier bound only. The panel's own estimate for the Diamond Belt neumann colony the K4H found in 1521." ;
    oa:precision oa:Circa ;
    oa:recordOrder 2 ;
    oa:yearAT 1470 .

claim:event-world-oikoumene-dyson-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/490b34ec41bb6> ;
    oa:about id:world-oikoumene-dyson ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"In 3194 a third toposophic MPA artificer ISO, fascinated by the vast project, made contact with the distributed intelligence of the dyson, and was able to establish communication channels and protocol and information exchanges between Oikoumene and Djed.\" The sentence attributes this contact to an MPA-affiliated artificer. Whether this is the point Oikoumene formally became MPA-affiliated (per the panel's current \"Affiliation: MPA\") is not stated and is not inferred here. A third-toposophic MPA artificer ISO making contact with the dyson's distributed intelligence." ;
    oa:polity id:polity-mutual-progress-association ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 3194 .
