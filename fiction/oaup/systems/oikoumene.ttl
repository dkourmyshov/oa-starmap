    oa:canonical true ;
    oa:colonyName "Oikoumene" ;
    oa:luminositySol "6.65" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 861 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0862-d8c61be1ffd4-source-distance ;
    oa:spectralType "F3 V" ;
    oa:starName "Zeta Serpentis" .

