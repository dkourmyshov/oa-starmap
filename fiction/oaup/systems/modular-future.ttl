@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Modular Future

id:world-modular-future a oa:Place, oa:World ;
    skos:prefLabel "Modular Future" ;
    oa:article <https://www.orionsarm.com/eg-article/47b8e6bd0c7e0> ;
    oa:editorialNote "Held by nobody now: Metasoft destroyed it and the Amalgamation did not\nkeep it, so what is left is a cinder system with no polity over it. The\nevents below are the whole of its allegiance, and they end in 10348." ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The furthest place in this file, and the only one destroyed by the empire that built it: Metasoft answered the Amalgamation's infiltration in 10348 by ending the system. Drawn as Metasoft's because that is who acted last there, not because anything is left to hold. The article's right ascension and declination put it in Perseus, as it says." ;
    oa:uncertain false .

claim:location-world-modular-future a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47b8e6bd0c7e0> ;
    oa:about id:world-modular-future ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 40.0103 ;
    oa:distance value:location-world-modular-future-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 59.4633 .

value:location-world-modular-future-distance a oa:QuantityValue ;
    qudt:numericValue 5771.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:event-world-modular-future-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47b8e6bd0c7e0> ;
    oa:about id:world-modular-future ;
    oa:canonical true ;
    oa:eventKind oa:Contact ;
    oa:note "Infiltrated by the Amalgamation." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 10348 .

claim:event-world-modular-future-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47b8e6bd0c7e0> ;
    oa:about id:world-modular-future ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "Destroyed by Metasoft in response." ;
    oa:polity id:polity-metasoft ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 10348 .

claim:event-world-modular-future-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47b8e6bd0c7e0> ;
    oa:about id:world-modular-future ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Despite the protection of the Perseus Arm Defence Organisation , this colony was infiltrated by the Amalgamation in 10348 AT. The system was rapidly subverted by Amalgamation agents\" No kind in the list cleanly fits a hostile infiltration/subversion that was destroyed rather than held; 'transferred' is the closest fit. The header records this as 'contact 10348', but 'contact' is defined as first contact with a resident xenosophont species, which the Amalgamation (an external, hostile infiltrator) does not appear to be. An infiltration despite the Perseus Arm Defence Organisation's protection; the map's older 'contact 10348' is this event." ;
    oa:polity id:polity-amalgamation ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 10348 .
