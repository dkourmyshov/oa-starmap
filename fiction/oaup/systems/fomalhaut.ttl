# Fomalhaut

id:world-fomalhaut a oa:Place, oa:World ;
    skos:prefLabel "Fomalhaut" ;
    oa:article <https://www.orionsarm.com/eg-topic/45cbd30e46c61> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The Society's capital, 25 ly out, and the only place it is named for. The Encyclopaedia gives it no article of its own — the topic entry for the Society is the source for the system as well." ;
    oa:uncertain false .

