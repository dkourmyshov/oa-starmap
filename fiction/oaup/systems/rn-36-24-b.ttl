# RN-36-24-b

id:world-rn-36-24-b a oa:Place, oa:World ;
    skos:prefLabel "RN-36-24-b" ;
    oa:article <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-rn-36-24-b a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4667386bcae2b> ;
    oa:about id:world-rn-36-24-b ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 26.969012611 ;
    oa:distance value:location-world-rn-36-24-b-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 47741. It has no article of its own and is named in the one cited. An industrial world with no polity recorded. Worth checking against the real star at these coordinates." ;
    oa:rightAscensionDeg 145.981706292 .

value:location-world-rn-36-24-b-distance a oa:QuantityValue ;
    qudt:numericValue 45.7521 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
