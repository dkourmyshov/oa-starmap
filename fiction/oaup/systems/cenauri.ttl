# Cenauri

id:inner-sphere-row-0003 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Cenauri" .

claim:inner-sphere-inner-sphere-row-0003-02e8a3bf5ed3 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0003 ;
    oa:article <https://www.orionsarm.com/eg-article/487146f744c8e> ;
    oa:canonical true ;
    oa:colonyName "Cenauri" ;
    oa:luminositySol "1.515" ;
    oa:massSol "1.100" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 2 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0003-02e8a3bf5ed3-source-distance ;
    oa:spectralType "G2 V" ;
    oa:starName "Alpha Centauri A" .

value:inner-sphere-inner-sphere-row-0003-02e8a3bf5ed3-source-distance a oa:QuantityValue ;
    qudt:numericValue 4.321 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

