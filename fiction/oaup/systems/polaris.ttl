@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Polaris

id:world-polaris a oa:Place, oa:World ;
    skos:prefLabel "Polaris" ;
    oa:article <https://www.orionsarm.com/eg-article/4a28264cb9420> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "433 ly, and the pole star of the epoch this map's coordinates are built on." ;
    oa:systemName "Polaris" ;
    oa:uncertain false .

claim:location-world-polaris a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a28264cb9420> ;
    oa:about id:world-polaris ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Polaris" .

claim:affiliation-world-polaris-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a28264cb9420> ;
    oa:about id:world-polaris ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .
