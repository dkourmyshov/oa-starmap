@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Abydos

id:world-abydos a oa:Place, oa:World ;
    skos:prefLabel "Abydos" ;
    oa:article <https://www.orionsarm.com/eg-article/48ff364d90669> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Alpha Canum Venaticorum, 100 ly. The colony table holds an assignment for Abydos whose star did not resolve; this entry places it." ;
    oa:systemName "Abydos" ;
    oa:uncertain false .

claim:location-world-abydos a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff364d90669> ;
    oa:about id:world-abydos ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Cor Caroli" .

claim:affiliation-world-abydos-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48ff364d90669> ;
    oa:about id:world-abydos ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .
