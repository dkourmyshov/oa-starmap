@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Betelgeuse

id:world-betelgeuse a oa:Place, oa:World ;
    skos:prefLabel "Betelgeuse" ;
    oa:article <https://www.orionsarm.com/eg-article/460c3c2a8b657> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "498 ly out. The article makes it the Volume's capital rather than an Umma settlement, which is a distinction the map cannot draw — a ring says who holds a place and not in what capacity." ;
    oa:systemName "Betelgeuse" ;
    oa:uncertain false .

claim:location-world-betelgeuse a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3c2a8b657> ;
    oa:about id:world-betelgeuse ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Betelgeuse" .

claim:affiliation-world-betelgeuse-stellar-umma a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3c2a8b657> ;
    oa:about id:world-betelgeuse ;
    oa:canonical true ;
    oa:polity id:polity-stellar-umma ;
    oa:recordOrder 0 .

claim:event-world-betelgeuse-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3c2a8b657> ;
    oa:about id:world-betelgeuse ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3621 .

claim:event-world-betelgeuse-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3c2a8b657> ;
    oa:about id:world-betelgeuse ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "Capital of the Betelgeuse Volume." ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 1 ;
    oa:yearAT 3621 .
