# Pardes

id:world-pardes a oa:Place, oa:World ;
    skos:prefLabel "Pardes" ;
    oa:article <https://www.orionsarm.com/eg-article/47bcf1f1efee6> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "HD 190605, 146 ly out in Vulpecula." ;
    oa:uncertain false .

claim:location-world-pardes a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47bcf1f1efee6> ;
    oa:about id:world-pardes ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 190605" .

claim:affiliation-world-pardes-cygexpa a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47bcf1f1efee6> ;
    oa:about id:world-pardes ;
    oa:canonical true ;
    oa:polity id:polity-cygexpa ;
    oa:recordOrder 0 .

claim:event-world-pardes-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47bcf1f1efee6> ;
    oa:about id:world-pardes ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2010 .

claim:event-world-pardes-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47bcf1f1efee6> ;
    oa:about id:world-pardes ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"It was terraformed with relative ease and became the headquarters of the Cygnus Expansion Association in 2376.\" 'Cygnus Expansion Association' is the full name behind 'Cygexpa', per the article's own opening line ('Pardes is the former Cygexpa capitalworld'). The headquarters of the Cygnus Expansion Association; ended by the Great Cygexpa Sell-off, undated here." ;
    oa:polity id:polity-cygexpa ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2376 .
