# Pluton

id:world-pluton a oa:Place, oa:World ;
    skos:prefLabel "Pluton" ;
    oa:article <https://www.orionsarm.com/eg-article/4910ed34571fd> ;
    oa:editorialNote "---- Silicon Generation --------------------------------------------------" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Perseus, and already on the map through the Celestia add-on, which is where this position comes from. The two sources give different distances and differ by exactly a thousand light years: the add-on says 5,130.8 and the article 4,130.8. Identical but for the leading digit, which is the shape of a slipped digit rather than of two sources disagreeing. The add-on's figure is drawn because the binding is to its star; see questions.md." ;
    oa:uncertain false .

claim:location-world-pluton a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910ed34571fd> ;
    oa:about id:world-pluton ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:oaStarName "JD 140582223" .

claim:affiliation-world-pluton-perseus-principalities a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910ed34571fd> ;
    oa:about id:world-pluton ;
    oa:canonical true ;
    oa:polity id:polity-perseus-principalities ;
    oa:recordOrder 0 .

claim:event-world-pluton-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4910ed34571fd> ;
    oa:about id:world-pluton ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 8400 .

