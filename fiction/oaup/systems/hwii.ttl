# Hwii

id:world-hwii a oa:Place, oa:World ;
    skos:prefLabel "Hwii" ;
    oa:article <https://www.orionsarm.com/eg-article/4675ea6d92bd9> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Zeta Tucanae, as the colony table has it." ;
    oa:systemName "Hwii" ;
    oa:uncertain false .

claim:location-world-hwii a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4675ea6d92bd9> ;
    oa:about id:world-hwii ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Zeta Tucanae" .

claim:affiliation-world-hwii-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4675ea6d92bd9> ;
    oa:about id:world-hwii ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 0 .

claim:event-world-hwii-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4675ea6d92bd9> ;
    oa:about id:world-hwii ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "\"Enhanced Dolphin interests settled Hwii in 1432 after the original Nanotech Window colonists had been found extinct.\" The earlier Nanotech Window colony had ended by 1432, when Dolphin settlers found it extinct; the actual end date is not given. The Nanotech Window colony, found extinct; its own dates are not given." ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 1432 .

claim:event-world-hwii-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4675ea6d92bd9> ;
    oa:about id:world-hwii ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Enhanced Dolphin interests settled Hwii in 1432 after the original Nanotech Window colonists had been found extinct.\" Settling group named as \"Enhanced Dolphin interests\", not a roster polity. Enhanced Dolphin interests, no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1432 .

