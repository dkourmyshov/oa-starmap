# Batholithics

id:world-batholithics a oa:Place, oa:World ;
    skos:prefLabel "Batholithics" ;
    oa:article <https://www.orionsarm.com/eg-article/4f43b87a30aae> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The home of an extinct xenosophont species, given as 4,300 ly out near the giant 6 Geminorum. The catalogue puts that star at 5,781 ly, so it lends its direction and the article keeps its distance: the two are a third apart, which is too much to bind across." ;
    oa:uncertain false .

claim:location-world-batholithics a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4f43b87a30aae> ;
    oa:about id:world-batholithics ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 22.9085 ;
    oa:distance value:location-world-batholithics-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:nearName "6 Geminorum" ;
    oa:rightAscensionDeg 93.0796 .

value:location-world-batholithics-distance a oa:QuantityValue ;
    qudt:numericValue 4300.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

