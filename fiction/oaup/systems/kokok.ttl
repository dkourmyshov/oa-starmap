@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Crustuse

id:world-crustuse a oa:Place, oa:World ;
    skos:prefLabel "Crustuse" ;
    oa:article <https://www.orionsarm.com/eg-article/4643de1a35f57> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:systemName "Kokok" ;
    oa:uncertain false .

claim:location-world-crustuse a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4643de1a35f57> ;
    oa:about id:world-crustuse ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "No position. The Kokok system is named and nothing else about it is — no catalogue star, no distance, no constellation." .

claim:affiliation-world-crustuse-keter-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4643de1a35f57> ;
    oa:about id:world-crustuse ;
    oa:canonical true ;
    oa:polity id:polity-keter-dominion ;
    oa:recordOrder 0 .
