# Akela

id:world-akela a oa:Place, oa:World ;
    skos:prefLabel "Akela" ;
    oa:article <https://www.orionsarm.com/eg-article/470033894c883> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Wolf 359, 7.9 ly out in Leo." ;
    oa:uncertain false .

claim:location-world-akela a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/470033894c883> ;
    oa:about id:world-akela ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Wolf 359" .

claim:affiliation-world-akela-solsys-organization a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/470033894c883> ;
    oa:about id:world-akela ;
    oa:canonical true ;
    oa:polity id:polity-solsys-organization ;
    oa:recordOrder 0 .

claim:event-world-akela-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/470033894c883> ;
    oa:about id:world-akela ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 450 .

claim:event-world-akela-002 a prov:Entity, oa:EventClaim ;
    oa:about id:world-akela ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "'.....' sporeship arrives at Wolf 359 and spreads from there." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Early Federation Age" ;
    oa:yearAT 1150 .

claim:event-world-akela-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/470033894c883> ;
    oa:about id:world-akela ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"A beamrider mission arrived in 730 AT and began construction of a boostbeam station soon afterwards.\" Not in the header's already- dated list (which has visited 450 and visited 1150, not 730). This appears to be the same arrival as 'the first Beamrider Network explorers' below; Beamrider Network is not on the roster, so no polity is recorded (see unplaced). A beamrider mission, building a boostbeam station; the map's older 'visited 1150' has no sentence in the article." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 730 .

