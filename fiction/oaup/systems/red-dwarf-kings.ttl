# Red Dwarf Kings

id:inner-sphere-row-0020 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Red Dwarf Kings" .

claim:inner-sphere-inner-sphere-row-0020-bb1420923c46 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0020 ;
    oa:article <https://www.orionsarm.com/eg-article/47646874c1b82> ;
    oa:canonical true ;
    oa:colonyName "Red Dwarf Kings" ;
    oa:luminositySol "0.000087" ;
    oa:massSol "0.1" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 19 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0020-bb1420923c46-source-distance ;
    oa:spectralType "M5.0-5.5 Ve" ;
    oa:starName "EZ Aquarii A" .

value:inner-sphere-inner-sphere-row-0020-bb1420923c46-source-distance a oa:QuantityValue ;
    qudt:numericValue 11.109 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

