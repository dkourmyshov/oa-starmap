# Merrion

id:world-merrion a oa:Place, oa:World ;
    skos:prefLabel "Merrion" ;
    oa:article <https://www.orionsarm.com/eg-article/48f9f31c92a0a> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:systemName "Merrion" ;
    oa:uncertain false .

claim:location-world-merrion a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9f31c92a0a> ;
    oa:about id:world-merrion ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Alpha Mensae" .

claim:affiliation-world-merrion-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9f31c92a0a> ;
    oa:about id:world-merrion ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-merrion-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9f31c92a0a> ;
    oa:about id:world-merrion ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "First probe." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1284 .

claim:event-world-merrion-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f9f31c92a0a> ;
    oa:about id:world-merrion ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "Manned mission, a century after the probe." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1395 .

claim:event-world-merrion-003 a prov:Entity, oa:EventClaim ;
    oa:about id:world-merrion ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"Merrion became NoCoZo seat in 2215 after the Treaty Revision summit.\" New against the header, which lists only visited 1284, settled 1395 and visited 1395. The NoCoZo seat after the Treaty Revision summit; the map's older 'settled 1395' is a manned exploration mission in the article's words." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:sourceDescription "Encyclopaedia timeline, Middle Federation / Megacorps" ;
    oa:yearAT 1395 .

