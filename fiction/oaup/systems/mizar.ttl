# Mizar

id:world-mizar a oa:Place, oa:World ;
    skos:prefLabel "Mizar" ;
    oa:article <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "81 ly. Alcor lies half a light year off and is held by others entirely — the two share an article and nothing else." ;
    oa:systemName "Mizar" ;
    oa:uncertain false .

claim:location-world-mizar a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-mizar ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Mizar" .

claim:affiliation-world-mizar-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-mizar ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .

claim:event-world-mizar-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-mizar ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "First reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2097 .

claim:event-world-mizar-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-mizar ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"A Truth-Santaya Networks colony ship arrived at Mizar in 2097 a.t. from Hesperia (later Fons Luminis).\" Truth-Santaya Networks is no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2097 .

claim:event-world-mizar-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-mizar ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Leonardo and most of the habitat bands joined the Solar Dominion in 2530, and a number of Dominion transapients of the Divine Order arrived during this period.\"" ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 2530 .

