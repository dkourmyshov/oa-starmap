@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# World Garden

id:world-world-garden a oa:Place, oa:World ;
    skos:prefLabel "World Garden" ;
    oa:article <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "In the Rosebud system, within the Gardener's Domain." ;
    oa:systemName "Rosebud" ;
    oa:uncertain false .

claim:location-world-world-garden a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:about id:world-world-garden ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Ophiuchus" ;
    oa:distance value:location-world-world-garden-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-world-garden-distance a oa:QuantityValue ;
    qudt:numericValue 3100.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-world-garden-keter-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:about id:world-world-garden ;
    oa:canonical true ;
    oa:polity id:polity-keter-dominion ;
    oa:recordOrder 0 .

claim:event-world-world-garden-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd64b8b689> ;
    oa:about id:world-world-garden ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 7154 .
