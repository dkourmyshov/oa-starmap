@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Rigel

id:world-rigel a oa:Place, oa:World ;
    skos:prefLabel "Rigel" ;
    oa:article <https://www.orionsarm.com/eg-article/47713d102a5a2> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "863 ly out, and among the most luminous stars anyone here has settled." ;
    oa:uncertain false .

claim:location-world-rigel a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47713d102a5a2> ;
    oa:about id:world-rigel ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Rigel" .

claim:affiliation-world-rigel-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47713d102a5a2> ;
    oa:about id:world-rigel ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-rigel-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47713d102a5a2> ;
    oa:about id:world-rigel ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonisation date 3808 AT / Joint mission Metasoft and Taurus Nexus\"; the body adds that \"this joint fleet arrived in 3808, by which time the Taurus Nexus no longer existed\"." ;
    oa:polity id:polity-metasoft ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3808 .

claim:event-world-rigel-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47713d102a5a2> ;
    oa:about id:world-rigel ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"A number of Backgrounder factions started arriving in the 3950s, followed by several ships sent by the Silicon Generation from the (then) fringes of the Terragen Sphere.\" 'Followed by' implies after the 3950s Backgrounder arrivals; no exact year is given for the Silicon Generation ships. Backgrounder factions first, then ships of the Silicon Generation." ;
    oa:polity id:polity-silicon-generation ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 1 ;
    oa:yearAT 3950 .
