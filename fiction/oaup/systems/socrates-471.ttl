# Socrates 471

id:world-socrates-471 a oa:Place, oa:World ;
    skos:prefLabel "Socrates 471" ;
    oa:article <https://www.orionsarm.com/eg-article/5f57dcfd4cc25> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Auriga at 3,372 ly." ;
    oa:systemName "Socrates 471" ;
    oa:uncertain false .

claim:location-world-socrates-471 a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f57dcfd4cc25> ;
    oa:about id:world-socrates-471 ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Auriga" ;
    oa:distance value:location-world-socrates-471-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-socrates-471-distance a oa:QuantityValue ;
    qudt:numericValue 3372.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-socrates-471-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f57dcfd4cc25> ;
    oa:about id:world-socrates-471 ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .

claim:event-world-socrates-471-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f57dcfd4cc25> ;
    oa:about id:world-socrates-471 ;
    oa:canonical true ;
    oa:eventKind oa:Contact ;
    oa:note "Reached." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 8862 .

# Menexenos

id:world-menexenos a oa:Place, oa:World ;
    skos:prefLabel "Menexenos" ;
    oa:article <https://www.orionsarm.com/eg-article/5f57dcfd4cc25> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The Menexenes' home world, under Caretaker protection — which is the holder recorded, following the rule that protection outranks what lives there. The xenosophont tag is for species going about their own affairs." ;
    oa:systemName "Socrates 471" ;
    oa:uncertain false .

claim:affiliation-world-menexenos-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f57dcfd4cc25> ;
    oa:about id:world-menexenos ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .
