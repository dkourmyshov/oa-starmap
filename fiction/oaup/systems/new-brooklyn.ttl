claim:event-world-new-brooklyn-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/552cf42ae3c54> ;
    oa:about id:world-new-brooklyn ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"This proved to be the decayed remains of a repair station built by a terrestrial hyperturing in 993 AT.\" An unnamed hyperturing, itself a Great Expulsion refugee with a faster ship, paused here to refuel and refurbish its debris shield; no polity named. A repair station of a terrestrial hyperturing, found decayed by the colonists of 1300; the builder is not named." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 993 .
