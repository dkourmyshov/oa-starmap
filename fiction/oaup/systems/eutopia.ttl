@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Eutopia

id:world-eutopia a oa:Place, oa:World ;
    skos:prefLabel "Eutopia" ;
    oa:article <https://www.orionsarm.com/eg-article/4e48fbab1c9a5> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The distance is given but the constellation is not; Ara is inferred from the company it keeps, every other system at this range in the Utopia Sphere's core being there." ;
    oa:uncertain false .

claim:location-world-eutopia a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4e48fbab1c9a5> ;
    oa:about id:world-eutopia ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Ara" ;
    oa:distance value:location-world-eutopia-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-eutopia-distance a oa:QuantityValue ;
    qudt:numericValue 609.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-eutopia-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4e48fbab1c9a5> ;
    oa:about id:world-eutopia ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-eutopia-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4e48fbab1c9a5> ;
    oa:about id:world-eutopia ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2880 .
