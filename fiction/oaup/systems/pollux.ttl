# Pollux

id:inner-sphere-row-0370 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Pollux" .

claim:inner-sphere-inner-sphere-row-0370-3aff047eca9b a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0370 ;
    oa:canonical true ;
    oa:colonyName "Pollux" ;
    oa:luminositySol "32.7" ;
    oa:massSol "1.91" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 369 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0370-3aff047eca9b-source-distance ;
    oa:spectralType "K0 IIIb" ;
    oa:starName "Beta Geminorum" .

value:inner-sphere-inner-sphere-row-0370-3aff047eca9b-source-distance a oa:QuantityValue ;
    qudt:numericValue 33.79 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
