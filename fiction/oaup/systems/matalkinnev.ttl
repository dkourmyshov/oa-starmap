    oa:recordOrder 336 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0337-3f8946f279ab-source-distance ;
    oa:spectralType "M0 Ve" ;
    oa:starName "AU Microscopii" .

value:inner-sphere-inner-sphere-row-0337-3f8946f279ab-source-distance a oa:QuantityValue ;
    qudt:numericValue 31.683 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

