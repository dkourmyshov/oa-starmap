claim:inner-sphere-inner-sphere-row-0337-3f8946f279ab a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0337 ;
    oa:canonical true ;
