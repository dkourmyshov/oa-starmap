# Alshain

id:inner-sphere-row-0505 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Alshain" .

claim:inner-sphere-inner-sphere-row-0505-47f905f31b17 a prov:Entity, oa:InnerSphereClaim ;
