# Ighlawu

id:inner-sphere-row-0076 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Ighlawu" .

claim:inner-sphere-inner-sphere-row-0076-420cd3359a30 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0076 ;
    oa:canonical true ;
    oa:colonyName "Ighlawu" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 75 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0076-420cd3359a30-source-distance ;
    oa:spectralType "T7.5" ;
    oa:starName "WISE J0521+1025" .

value:inner-sphere-inner-sphere-row-0076-420cd3359a30-source-distance a oa:QuantityValue ;
    qudt:numericValue 16.3 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
