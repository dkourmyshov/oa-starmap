# Xyntii

id:world-xyntii a oa:Place, oa:World ;
    skos:prefLabel "Xyntii" ;
    oa:article <https://www.orionsarm.com/eg-article/49a7dcd6413a0> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-xyntii a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49a7dcd6413a0> ;
    oa:about id:world-xyntii ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -43.694318861 ;
    oa:distance value:location-world-xyntii-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 40350. It has no article of its own and is named in the one cited." ;
    oa:rightAscensionDeg 123.576744042 .

value:location-world-xyntii-distance a oa:QuantityValue ;
    qudt:numericValue 245.238 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-xyntii-sophic-league a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49a7dcd6413a0> ;
    oa:about id:world-xyntii ;
    oa:canonical true ;
    oa:polity id:polity-sophic-league ;
    oa:recordOrder 0 .
