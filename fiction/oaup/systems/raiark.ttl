@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Raiark

id:world-raiark a oa:Place, oa:World ;
    skos:prefLabel "Raiark" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-raiark a prov:Entity, oa:LocationClaim ;
    oa:about id:world-raiark ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 58.8163888 ;
    oa:distance value:location-world-raiark-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is YTS 223109-889-8. No article names it. No article. The gazetteer's note on Magnetic Fields, the route reaching it from Jarre, reads \"Closed, leads to Amalgamation\"." ;
    oa:rightAscensionDeg 34.18333 .

value:location-world-raiark-distance a oa:QuantityValue ;
    qudt:numericValue 4943.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-raiark-amalgamation a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-raiark ;
    oa:canonical true ;
    oa:polity id:polity-amalgamation ;
    oa:recordOrder 0 .
