# Batsu

id:inner-sphere-row-0587 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Batsu" .

claim:inner-sphere-inner-sphere-row-0587-370fe6b52850 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0587 ;
    oa:canonical true ;
    oa:colonyName "Batsu" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 586 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0587-370fe6b52850-source-distance ;
    oa:spectralType "M5" ;
    oa:starName "LHS 3844" .

value:inner-sphere-inner-sphere-row-0587-370fe6b52850-source-distance a oa:QuantityValue ;
    qudt:numericValue 48.526 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
