@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Acrab

id:world-acrab a oa:Place, oa:World ;
    skos:prefLabel "Acrab" ;
    oa:article <https://www.orionsarm.com/eg-article/5e9b5712e4df2> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "Beta-1 Scorpii, 404 ly, a multiple star of components Aa, Ab and B. Cited as an example of a Blue Star Dyson." ;
    oa:systemName "Acrab" ;
    oa:uncertain false .

claim:location-world-acrab a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5e9b5712e4df2> ;
    oa:about id:world-acrab ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Acrab" .

claim:affiliation-world-acrab-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5e9b5712e4df2> ;
    oa:about id:world-acrab ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .
