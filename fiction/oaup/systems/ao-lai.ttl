    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Exodus Beneficents arrive at Gamma Leporis and begin extensive development in both systems." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:sourceDescription "Encyclopaedia timeline, The Early Federation Age" ;
    oa:yearAT 933 .

