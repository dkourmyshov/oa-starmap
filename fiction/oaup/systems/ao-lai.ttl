    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "First Federation ship arrives at Gamma Leporis ." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:sourceDescription "Encyclopaedia timeline, The Early Federation Age" ;
    oa:yearAT 1166 .

claim:event-world-ao-lai-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871520aab6c2> ;
    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Ao Lai was first settled by the famous Exodus Beneficents in 868 AT.\" Beneficence/Exodus Beneficents not on roster; see unplaced. This date contradicts the article's own timeline, which gives 933 AT for the same arrival (see contradictions). The article's own timeline has the Exodus Beneficents arriving in 933, which the map already carries as a visit; both are kept." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 868 .

claim:event-world-ao-lai-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871520aab6c2> ;
    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "\"development continued apace until their spectacular and near- miraculous technorapture (or, as some hardened sceptics have it, hoax and mass murder) in 2052 AT.\" The technorapture is described as the wholesale departure of the Beneficents; whether this counts as 'everyone left' is left to the reviewer. The Beneficents' technorapture, 'or, as some hardened sceptics have it, hoax and mass murder'." ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 2052 .

claim:event-world-ao-lai-005 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871520aab6c2> ;
    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"2252 AT: New Beneficence re-colonizes vacant systems at Gamma Leporis\" New Beneficence not on roster; see unplaced. Body text names the leader: 'Many regard \"year zero\" of the system's history to have begun with the arrival of Ukarima Lovejoy's small band of New Beneficence believers in 2252 AT'. The New Beneficence, no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 4 ;
    oa:yearAT 2252 .

claim:event-world-ao-lai-006 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871520aab6c2> ;
    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"2271 AT: IPP leases space at Gamma Leporis B from the New Beneficence; commences planet-building\" Institute for Primate Provolution (IPP) not on roster; see unplaced. The Institute for Primate Provolution leasing space at Gamma Leporis B and commencing planet-building." ;
    oa:polity id:polity-primate-provolution-institute ;
    oa:precision oa:Exact ;
    oa:recordOrder 5 ;
    oa:yearAT 2271 .

claim:event-world-ao-lai-007 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871520aab6c2> ;
    oa:about id:world-ao-lai ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"7040 AT: Migration of IPP headquarters to holdings at Gamma Leporis (later named Ao Lai)\" IPP not on roster; see unplaced. Matches 'IPP headquarters since 7040' in the government box. The Institute's headquarters migrating to its holdings here, later named Ao Lai." ;
    oa:polity id:polity-primate-provolution-institute ;
    oa:precision oa:Exact ;
    oa:recordOrder 6 ;
    oa:yearAT 7040 .

