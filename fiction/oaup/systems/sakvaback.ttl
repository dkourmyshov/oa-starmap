# Sakvaback

id:world-sakvaback a oa:Place, oa:World ;
    skos:prefLabel "Sakvaback" ;
    oa:article <https://www.orionsarm.com/eg-article/478836f1d5431> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The planet is spelled Sökvabäck." ;
    oa:systemName "Sakvaback" ;
    oa:uncertain false .

claim:location-world-sakvaback a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478836f1d5431> ;
    oa:about id:world-sakvaback ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "2,011 ly from Sol, with no direction given." .

claim:affiliation-world-sakvaback-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478836f1d5431> ;
    oa:about id:world-sakvaback ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-sakvaback-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478836f1d5431> ;
    oa:about id:world-sakvaback ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 5804 .

claim:event-world-sakvaback-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478836f1d5431> ;
    oa:about id:world-sakvaback ;
    oa:canonical true ;
    oa:eventKind oa:Abandoned ;
    oa:note "\"Sakvaback (also pronounced Sökvabäck) was first colonised by the Scarlen Host in 5804 AT; they rapidly terraformed this cold planet using orbiting mirrors and swarmtech, but became isolationist and transcended in 6910 AT, leaving the planet uninhabited for over a hundred standard years.\" Same sentence as the settlement entry; the Scarlen Host transcended and left the world empty. The Scarlen Host, no polity of this file, gone." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 6910 .

claim:event-world-sakvaback-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/478836f1d5431> ;
    oa:about id:world-sakvaback ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The empty world became a goal for transcension chasers for a period, but was mostly empty of transapientech by 7013 AT when a second wave of permanent colonists arrived from the Regor Plexus.\" New against the header, which records only 'settled 5804'; matches the article's own panel line 'Recolonised: 7013 AT'. A second wave of permanent colonists." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 7013 .
