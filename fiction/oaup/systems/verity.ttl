@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Verity

id:world-verity a oa:Place, oa:World ;
    skos:prefLabel "Verity" ;
    oa:editorialNote "---- Non-Coercive Zone ---------------------------------------------------\n\nThe largest roster here by some distance. Many of these systems were already\non the map through the Inner Sphere colony table, so the entries bind by the\nnames that table resolved rather than by numbers, and add the article and\nthe dates the table has no room for." ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "No article of its own." ;
    oa:systemName "Verity" ;
    oa:uncertain false .

claim:location-world-verity a prov:Entity, oa:LocationClaim ;
    oa:about id:world-verity ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In the outer volumes, near the Mutual Progress Association border." .

claim:affiliation-world-verity-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-verity ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .
