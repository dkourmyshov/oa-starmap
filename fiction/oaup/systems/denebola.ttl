# Denebola

id:world-denebola a oa:Place, oa:World ;
    skos:prefLabel "Denebola" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Beta Leonis, 36 ly, as the colony table has it, which names the system and no holder; the Encyclopaedia's Denebola Incident article is not among the saved pages." ;
    oa:systemName "Denebola" ;
    oa:uncertain false .

claim:location-world-denebola a prov:Entity, oa:LocationClaim ;
    oa:about id:world-denebola ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Beta Leonis" .

claim:event-world-denebola-001 a prov:Entity, oa:EventClaim ;
    oa:about id:world-denebola ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Virginis Combine amat farms seeded at Denebola.\" The Combine's own page: \"the young bright A class star Denebola (8 light-years) which became an important amat-farm center for the Combine\", and which \"later underwent an over-complexity collapse (see the Denebola Incident)\", undated there." ;
    oa:polity id:polity-virginis-combine ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:sourceDescription "Encyclopaedia timeline, Late Federation / AI Emergence" ;
    oa:yearAT 1748 .

# Denebola

id:inner-sphere-row-0401 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Denebola" .

claim:inner-sphere-inner-sphere-row-0401-8534ea390b65 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0401 ;
    oa:article <https://www.orionsarm.com/eg-article/46490ca002b02> ;
    oa:canonical true ;
    oa:colonyName "Denebola" ;
    oa:luminositySol "14.98" ;
    oa:massSol "2.3" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 400 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0401-8534ea390b65-source-distance ;
    oa:spectralType "A3 V" ;
    oa:starName "Beta Leonis" .

value:inner-sphere-inner-sphere-row-0401-8534ea390b65-source-distance a oa:QuantityValue ;
    qudt:numericValue 35.88 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
