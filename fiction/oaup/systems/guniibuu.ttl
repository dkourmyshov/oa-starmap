# Guniibuu

id:inner-sphere-row-0121 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Guniibuu" .

claim:inner-sphere-inner-sphere-row-0121-469aa7f03f18 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0121 ;
    oa:canonical true ;
    oa:colonyName "Guniibuu" ;
    oa:luminositySol "0.291" ;
    oa:massSol "0.77" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 120 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0121-469aa7f03f18-source-distance ;
    oa:spectralType "K1 Ve" ;
    oa:starName "36 Ophiuchi A" .

value:inner-sphere-inner-sphere-row-0121-469aa7f03f18-source-distance a oa:QuantityValue ;
    qudt:numericValue 19.399 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

