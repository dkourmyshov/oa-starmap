# Radwan

id:world-radwan a oa:Place, oa:World ;
    skos:prefLabel "Radwan" ;
    oa:article <https://www.orionsarm.com/eg-article/47fec92ad2278> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-radwan a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/47fec92ad2278> ;
    oa:about id:world-radwan ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -65.769855083 ;
    oa:distance value:location-world-radwan-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg-article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer, which gave no coordinates itself. The add-on's designation for the primary is HD 108054. It has no article of its own and is named in the Pan-Sophontist League's, cited here; the gazetteer's note on The Way of Trees, the route reaching it, reads \"To Pan-Sophontist League\". Drawn as neutral rather than as that League's, on the project owner's decision, because this file has no entry for it and one world is too thin a reason to add a polity — the Encyclopaedia's timeline names it once more, at Karmiti." ;
    oa:rightAscensionDeg 186.323051208 .

value:location-world-radwan-distance a oa:QuantityValue ;
    qudt:numericValue 158.1 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
