    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871893629b5e> ;
    oa:about id:world-zavijava ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .

claim:event-world-zavijava-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4871893629b5e> ;
    oa:about id:world-zavijava ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonized: 868 A.T.\" No system-wide holder; the article names protectorates and affiliations world by world, undated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 868 .

claim:event-world-zavijava-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48735da987f1b> ;
    oa:about id:world-zavijava ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "The Pacifica article: \"By 1068 fully four-fifths of the technorats had officially seceded\" from the New America administration to the Federation, \"and whilst they never actually formed a single technarch-style orbital league, each habitat was a local Federation member.\" The habitats, not the planet's surface, which stayed with the orbital regime until 1541." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 1 ;
    oa:yearAT 1068 .

claim:event-world-zavijava-003 a prov:Entity, oa:EventClaim ;
    oa:about id:world-zavijava ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"A number of Technorat habitats form the Virginis Combine [Beta Virginis].\" The Combine formed here; its own page is not among the saved articles, and the Zavijava article says only that most of the system's worlds \"are member states of the Virginis Combine\"." ;
    oa:polity id:polity-virginis-combine ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:sourceDescription "Encyclopaedia timeline, Late Federation / AI Emergence" ;
    oa:yearAT 1590 .

claim:event-world-zavijava-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48735da987f1b> ;
    oa:about id:world-zavijava ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "The Pacifica article: \"by 2512 the Combine and the Conver Ambi announced a merger.\" The Arcadia article has both \"In 2512 the Virginis Combine also dissolved, and it was effectively absorbed by the Conver Ambi\" and, later, \"when the Combine dissolved in 3932\"; the earlier year is entered and the later kept here. Pacifica itself \"joined the Utopia Sphere\" in the Age of Consolidation, undated." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 2512 .

