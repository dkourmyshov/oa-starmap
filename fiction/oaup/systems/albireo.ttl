# Albireo

id:world-albireo a oa:Place, oa:World ;
    skos:prefLabel "Albireo" ;
    oa:article <https://www.orionsarm.com/eg-article/45e77f147567f> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Beta Cygni, 363 ly out — a gold and blue pair that is one of the finest double stars in Earth's sky, and the centre of the sector named for it." ;
    oa:systemName "Albireo" ;
    oa:uncertain false .

claim:location-world-albireo a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77f147567f> ;
    oa:about id:world-albireo ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Albireo" .

claim:affiliation-world-albireo-albireo-confluence a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77f147567f> ;
    oa:about id:world-albireo ;
    oa:canonical true ;
    oa:polity id:polity-albireo-confluence ;
    oa:recordOrder 0 .

claim:event-world-albireo-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45e77f147567f> ;
    oa:about id:world-albireo ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "Capital of the Albireo Confluence." ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 10600 .
