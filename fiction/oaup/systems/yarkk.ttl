# Yarkk

id:world-yarkk a oa:Place, oa:World ;
    skos:prefLabel "Yarkk" ;
    oa:article <https://www.orionsarm.com/eg-article/55114779e0902> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 833, as the colony table has it." ;
    oa:systemName "Yarkk" ;
    oa:uncertain false .

claim:location-world-yarkk a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/55114779e0902> ;
    oa:about id:world-yarkk ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 833" .

claim:event-world-yarkk-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/55114779e0902> ;
    oa:about id:world-yarkk ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Goodworld/Yarkk was first colonised by Linnaeus Enterprises in 1976 AT, using engenerator technology.\" Linnaeus Enterprises is identified elsewhere in the same article (Related Articles: 'LinnEnt (Linnaeus Enterprises)') as LinnEnt, the roster polity." ;
    oa:polity id:polity-linnent ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1976 .

