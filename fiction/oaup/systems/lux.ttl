# Lux

id:world-lux a oa:Place, oa:World ;
    skos:prefLabel "Lux" ;
    oa:article <https://www.orionsarm.com/eg-article/468d9486eaa11> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Kappa1 Ceti, as the colony table has it." ;
    oa:systemName "Lux" ;
    oa:uncertain false .

claim:location-world-lux a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/468d9486eaa11> ;
    oa:about id:world-lux ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Kappa1 Ceti" .

claim:event-world-lux-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/468d9486eaa11> ;
    oa:about id:world-lux ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Reached 1503, by Parthene colonists\" Body text corroborates: 'the sites of early Terragen habitation in this system, primarily in form of habitats established by Parthene colonists that arrived in 1503'. The Parthene colonists are not a polity on the roster. Parthene colonists, no polity of this file; mainly aligned since with the MPA, the Solar Dominion and the Fomalhaut Acquisition Society, undated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1503 .

