    oa:about id:inner-sphere-row-0859 ;
    oa:article <https://www.orionsarm.com/eg-article/467897cabc3d3> ;
    oa:canonical true ;
    oa:colonyName "Landau" ;
    oa:luminositySol "4.13" ;
    oa:massSol "1.3" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 858 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0859-eddc1406af5b-source-distance ;
    oa:spectralType "F8 V" ;
    oa:starName "94 Ceti A" .

value:inner-sphere-inner-sphere-row-0859-eddc1406af5b-source-distance a oa:QuantityValue ;
    qudt:numericValue 74.631 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

