# Baei

id:inner-sphere-row-0036 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Baei" .

claim:inner-sphere-inner-sphere-row-0036-7d62587e7504 a prov:Entity, oa:InnerSphereClaim ;
