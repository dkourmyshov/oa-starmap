# Hoshanti's Star

id:world-hoshanti-s-star a oa:Place, oa:World ;
    skos:prefLabel "Hoshanti's Star" ;
    oa:article <https://www.orionsarm.com/eg-article/464deafc952ed> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In the Outer Volumes, down the Sagittarius sector — a direction with no distance, so the constellation is recorded and nothing is drawn. Settled in 10054, which makes it one of the latest dates in this file. Gavit, its neptunian, was already here from the Solar Dominion's roster and holds both; this entry gives the system it is in a place of its own." ;
    oa:systemName "Hoshanti's Star" ;
    oa:uncertain false .

claim:location-world-hoshanti-s-star a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464deafc952ed> ;
    oa:about id:world-hoshanti-s-star ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Sagittarius" ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-hoshanti-s-star-deeper-covenant a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464deafc952ed> ;
    oa:about id:world-hoshanti-s-star ;
    oa:canonical true ;
    oa:polity id:polity-deeper-covenant ;
    oa:recordOrder 0 .

claim:event-world-hoshanti-s-star-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464deafc952ed> ;
    oa:about id:world-hoshanti-s-star ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 10054 .

