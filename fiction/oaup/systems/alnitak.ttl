# Alnitak

id:world-alnitak a oa:Place, oa:World ;
    skos:prefLabel "Alnitak" ;
    oa:article <https://www.orionsarm.com/eg-article/45eceb9d337cf> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Zeta Orionis, 736 ly out." ;
    oa:uncertain false .

claim:location-world-alnitak a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45eceb9d337cf> ;
    oa:about id:world-alnitak ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Zeta Orionis" .

claim:affiliation-world-alnitak-orion-federation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45eceb9d337cf> ;
    oa:about id:world-alnitak ;
    oa:canonical true ;
    oa:polity id:polity-orion-federation ;
    oa:recordOrder 0 .
