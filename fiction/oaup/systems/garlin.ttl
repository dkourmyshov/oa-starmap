@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Garlin

id:world-garlin a oa:Place, oa:World ;
    skos:prefLabel "Garlin" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "No article of its own." ;
    oa:systemName "Garlin" ;
    oa:uncertain false .

claim:location-world-garlin a prov:Entity, oa:LocationClaim ;
    oa:about id:world-garlin ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In the vicinity of Lynga 7, which is on the map as a Negentropy landmark. No distance of its own is given, and borrowing the cluster's would assert a figure the source does not." .

claim:affiliation-world-garlin-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-garlin ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .
