# Baenf

id:world-baenf a oa:Place, oa:World ;
    skos:prefLabel "Baenf" ;
    oa:article <https://www.orionsarm.com/eg-article/45fdab96a3cc3> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-baenf a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45fdab96a3cc3> ;
    oa:about id:world-baenf ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -52.293035278 ;
    oa:distance value:location-world-baenf-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is TYC 8340-1104-1. The article is its own, and it corroborates the position: it puts Baenf in the \"Utopia Outer Arae\", and these coordinates fall 2.7 degrees from the centre of Ara. That is the firmest agreement any of the add-on's invented positions has with the Encyclopaedia — all the article gives is a region, no distance from Sol and no coordinates, and the add-on lands in the middle of it." ;
    oa:rightAscensionDeg 257.029387917 .

value:location-world-baenf-distance a oa:QuantityValue ;
    qudt:numericValue 667.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-baenf-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45fdab96a3cc3> ;
    oa:about id:world-baenf ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .
