# Copernicus

id:world-copernicus a oa:Place, oa:World ;
    skos:prefLabel "Copernicus" ;
    oa:article <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "55 Cancri, 41 ly out in Cancer. The Copernicus article is at https://www.orionsarm.com/eg-article/45e24d79c0d8b, read for the events. Affiliated to the Terragen Federation, which is the holder recorded, though the article gives it close ties to the Sophic League, Metasoft and the Solar Dominion besides." ;
    oa:systemName "Copernicus" ;
    oa:uncertain false .

claim:location-world-copernicus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "55 Cancri" .

claim:affiliation-world-copernicus-terragen-federation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:polity id:polity-terragen-federation ;
    oa:recordOrder 0 .

claim:event-world-copernicus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"Reached: 809 AT, by subsophont probe Philip K. Dick.\"" ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 809 .

claim:event-world-copernicus-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"First crewed colonization mission in 1421 by the Kontore League.\" Kontore League is not on the roster (see unplaced) The Kontore League is no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1421 .

claim:event-world-copernicus-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Riga joined the Solar Dominion in 5500, and Danzig formed close ties with the Terragen Federation.\" Riga is one world of the system; the panel has Danzig with ties to the Terragen Federation and Mazda affiliated to the Sophic League, undated." ;
    oa:polity id:polity-solar-dominion ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 5500 .

claim:event-world-copernicus-004 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"In 2058 the Conver Ambi arrived and set up an embassy/colony on Danzig, in the continent of Wendlant.\" Founded within the already- settled system; recorded because it names a new roster polity establishing a colony, later becoming (undated) 'the dominant force in this system'. An embassy and colony on Danzig, in the continent of Wendlant, one world of the system." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:Exact ;
    oa:recordOrder 3 ;
    oa:yearAT 2058 .

claim:event-world-copernicus-005 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/486ebb201f514> ;
    oa:about id:world-copernicus ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"At this time the Amity population were becoming increasingly attracted by the spiritual ethos of the Sophic League, and joined them in 6887.\" Amity is a local faction on Mazda (unplaced), within the Copernicus system. The Amity population, one world of the system, drawn to the League's spiritual ethos." ;
    oa:polity id:polity-sophic-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 4 ;
    oa:yearAT 6887 .

