claim:event-world-mandra-quin-si-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4b72eb926b584> ;
    oa:about id:world-mandra-quin-si ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Reached 1610\" Followed by terraforming and settlement by the megacorps K4H and TakiCorb, neither on the roster; see unplaced. By the megacorporations K4H and TakiCorb, no polities of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1610 .

claim:event-world-mandra-quin-si-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4b72eb926b584> ;
    oa:about id:world-mandra-quin-si ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In 2446 the Tsutari Ambastory , a religious confederation drawn from the habitats across the system, overthrew the Quasa'an dynasty, bringing the era of tyranny to an end.\" A revolution rather than a joining: the Ambastory overthrew the Quasa'an dynasty's Terrorlords." ;
    oa:polity id:polity-tsutari-ambastory ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2446 .

