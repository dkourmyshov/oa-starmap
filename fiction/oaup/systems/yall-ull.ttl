# Yall-Ull

id:world-yall-ull a oa:Place, oa:World ;
    skos:prefLabel "Yall-Ull" ;
    oa:article <https://www.orionsarm.com/eg-article/4fbac899f11d0> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 667 A, as the colony table has it." ;
    oa:systemName "Yall-Ull" ;
    oa:uncertain false .

claim:location-world-yall-ull a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4fbac899f11d0> ;
    oa:about id:world-yall-ull ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 667 A" .

claim:event-world-yall-ull-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4fbac899f11d0> ;
    oa:about id:world-yall-ull ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"By the time the probe reached the system two centuries later Solsys was in the nadir of a Dark Age, and the data sent back by the probe was never received.\" Probe launched in 505 AT ('An unmanned interstellar probe was launched in 505 AT to explore this system.'); arrival year computed as roughly two centuries after launch. No sending polity is named for the probe. Launched in 505; its data was never received, Solsys being in a Dark Age." ;
    oa:precision oa:Circa ;
    oa:recordOrder 0 ;
    oa:yearAT 705 .

claim:event-world-yall-ull-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4fbac899f11d0> ;
    oa:about id:world-yall-ull ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"The system was colonized by the First Federation in 1109 AT.\" Colony mission fronted by Clan Yall, a close ally of House Genen; neither Clan Yall nor House Genen is on the roster." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1109 .

