# Yin-Yang

id:world-yin-yang a oa:Place, oa:World ;
    skos:prefLabel "Yin-Yang" ;
    oa:article <https://www.orionsarm.com/eg-article/46e9ce6bb2787> ;
    oa:editorialNote "---- Cygexpa ------------------------------------------------------------\n\nA dissolved empire, and the only one here recorded for what it was rather\nthan what it holds. `affiliations` is otherwise the present holder; Cygexpa\nhas no present, so these entries mark a region with a history instead — the\nplaces it left behind, where nothing has claimed them since. Qjellto is not\namong them: the Utopia Sphere and the Zoeific Biopolity hold it now, and\nnaming the empire that used to would say the wrong thing about who is there." ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "At 6.5 ly this is the third-nearest system to Sol: the only things this map's catalogue has inside it are Alpha Centauri at 4.3 and Barnard's Star at 6.0. Yin-Yang itself is in none of the catalogues loaded here, which is why the article has to say where it is by naming what it is near rather than by giving a designation anything would resolve." ;
    oa:uncertain false .

claim:location-world-yin-yang a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46e9ce6bb2787> ;
    oa:about id:world-yin-yang ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -53.9096 ;
    oa:derivation "Luhman 16, a pair of brown dwarfs too cool for any catalogue here. The article gives two distances rather than three — 6.503 ly from Sol and 3.559 from Alpha Centauri — and two spheres meet in a circle, not a point: a ring of possible positions 3.3 ly in radius. The constellation cuts it. Only 15.5 degrees of that circle fall in Vela, an arc 0.88 ly end to end, and this is its midpoint; the error is the half-arc." ;
    oa:directionErrorDeg 4.0 ;
    oa:distance value:location-world-yin-yang-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:EditorialEstimate ;
    oa:rightAscensionDeg 162.292 .

value:location-world-yin-yang-distance a oa:QuantityValue ;
    qudt:numericValue 6.503 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-yin-yang-deeper-covenant a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46e9ce6bb2787> ;
    oa:about id:world-yin-yang ;
    oa:canonical true ;
    oa:polity id:polity-deeper-covenant ;
    oa:recordOrder 0 .

