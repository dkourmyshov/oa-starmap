@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Washington

id:world-washington a oa:Place, oa:World ;
    skos:prefLabel "Washington" ;
    oa:article <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Auriga at 5,133 ly, and settled in 10107 — among the latest dates in this file, which runs to about 10600." ;
    oa:systemName "Washington" ;
    oa:uncertain false .

claim:location-world-washington a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:about id:world-washington ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Auriga" ;
    oa:distance value:location-world-washington-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-washington-distance a oa:QuantityValue ;
    qudt:numericValue 5133.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-washington-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:about id:world-washington ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-washington-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:about id:world-washington ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 10107 .

claim:event-world-washington-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:about id:world-washington ;
    oa:canonical true ;
    oa:eventKind oa:Observed ;
    oa:note "\"By the time of Seattle's discovery in 9017AT, Terragen civilization had learned that alien life rarely resembled terrestrial life in any fashion.\" No actor is named for the discovery; the preceding paragraph credits the Argus Array with identifying the planet and a later linelayer with reaching it, but neither sentence is dated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 9017 .

claim:event-world-washington-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:about id:world-washington ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonized 10,107AT\" The panel's \"Allegiance\" field names Metasoft Version Tree separately, but does not tie it to this line directly; see holder_undated. The panel's allegiance is the Metasoft Version Tree; the article does not say who colonised it." ;
    oa:precision oa:Exact ;
    oa:recordOrder 2 ;
    oa:yearAT 10107 .

# Seattle

id:world-seattle a oa:Place, oa:World ;
    skos:prefLabel "Seattle" ;
    oa:article <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The world of Washington, in the Metasoft Version Tree." ;
    oa:systemName "Washington" ;
    oa:uncertain false .

claim:affiliation-world-seattle-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/56cee52ae55da> ;
    oa:about id:world-seattle ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .
