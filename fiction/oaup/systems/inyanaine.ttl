@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Inyanaine

id:world-inyanaine a oa:Place, oa:World ;
    skos:altLabel "Okerbart" ;
    skos:prefLabel "Inyanaine" ;
    oa:article <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Eridanus at 448 ly, and named twice — Inyanaine and Okerbart both appear for the same system." ;
    oa:systemName "Inyanaine" ;
    oa:uncertain false .

claim:location-world-inyanaine a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:about id:world-inyanaine ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:constellationName "Eridanus" ;
    oa:distance value:location-world-inyanaine-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-inyanaine-distance a oa:QuantityValue ;
    qudt:numericValue 448.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-inyanaine-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:about id:world-inyanaine ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .

claim:event-world-inyanaine-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:about id:world-inyanaine ;
    oa:canonical true ;
    oa:eventKind oa:Stewardship ;
    oa:note "Claimed by a Caretaker God." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2828 .

claim:event-world-inyanaine-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:about id:world-inyanaine ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"Reached 2789 AT\" Panel gives no polity for who reached the system; the world is later claimed by a Caretaker God in 2828, but nothing ties the 2789 arrival itself to a polity." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2789 .

# Jirayaka

id:world-jirayaka a oa:Place, oa:World ;
    skos:prefLabel "Jirayaka" ;
    oa:article <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The world a Caretaker God took stewardship of in 2828." ;
    oa:systemName "Inyanaine" ;
    oa:uncertain false .

claim:affiliation-world-jirayaka-caretaker-gods a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f285f7cb2cae> ;
    oa:about id:world-jirayaka ;
    oa:canonical true ;
    oa:polity id:polity-caretaker-gods ;
    oa:recordOrder 0 .
