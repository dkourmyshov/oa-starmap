# NoGo Solarius

id:world-nogo-solarius a oa:Place, oa:World ;
    skos:altLabel "NoGo Solarus" ;
    skos:prefLabel "NoGo Solarius" ;
    oa:article <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-nogo-solarius a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4a60f013d264d> ;
    oa:about id:world-nogo-solarius ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -36.5564075 ;
    oa:distance value:location-world-nogo-solarius-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is TYC 7405-1723-1. It has no article of its own and is named in the one cited. An industrial system with no polity recorded. See the Orange Polity's entry for the border question that covers it." ;
    oa:rightAscensionDeg 274.734429583 .

value:location-world-nogo-solarius-distance a oa:QuantityValue ;
    qudt:numericValue 423.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
