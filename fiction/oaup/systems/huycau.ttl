@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Huycau

id:world-huycau a oa:Place, oa:World ;
    skos:prefLabel "Huycau" ;
    oa:article <https://www.orionsarm.com/eg-article/51091900523ad> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Huycau and Sitr'achra, a pair the article places together in Ursa Major at 2,611 ly for epoch 6000 AT — the setting's own epoch rather than the catalogue's, which is why the figure is quoted to a thousandth. The home system of the Samaelians." ;
    oa:systemName "Huycau" ;
    oa:uncertain false .

claim:location-world-huycau a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/51091900523ad> ;
    oa:about id:world-huycau ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 56.7818 ;
    oa:distance value:location-world-huycau-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:rightAscensionDeg 148.2613 .

value:location-world-huycau-distance a oa:QuantityValue ;
    qudt:numericValue 2611.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-huycau-xenosophont a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/51091900523ad> ;
    oa:about id:world-huycau ;
    oa:canonical true ;
    oa:polity id:polity-xenosophont ;
    oa:recordOrder 0 .

claim:event-world-huycau-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/51091900523ad> ;
    oa:about id:world-huycau ;
    oa:canonical true ;
    oa:eventKind oa:Contact ;
    oa:note "Reached after this year." ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 0 ;
    oa:yearAT 6802 .

# Samael

id:world-samael a oa:Place, oa:World ;
    skos:prefLabel "Samael" ;
    oa:article <https://www.orionsarm.com/eg-article/510948dda0620> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "The Samaelians' own world, in the Huycau and Sitr'achra system in Ursa Major at 2,611 ly." ;
    oa:systemName "Huycau" ;
    oa:uncertain false .

claim:affiliation-world-samael-xenosophont a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/510948dda0620> ;
    oa:about id:world-samael ;
    oa:canonical true ;
    oa:polity id:polity-xenosophont ;
    oa:recordOrder 0 .
