# Arkab Prior A

id:world-arkab-prior-a a oa:Place, oa:World ;
    skos:prefLabel "Arkab Prior A" ;
    oa:article <https://www.orionsarm.com/eg-article/48f4b90a814b0> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Beta-1 Sagittarii A. Its companion B is a Mutual Progress Association system colonised the same year — one binary, two components, two meta-empires, and at 3,290 AU apart they are the same point on this map." ;
    oa:systemName "Arkab Prior A" ;
    oa:uncertain false .

claim:location-world-arkab-prior-a a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4b90a814b0> ;
    oa:about id:world-arkab-prior-a ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-arkab-prior-a-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Arkab Prior" .

value:location-world-arkab-prior-a-distance a oa:QuantityValue ;
    qudt:numericValue 389.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-arkab-prior-a-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4b90a814b0> ;
    oa:about id:world-arkab-prior-a ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .

claim:event-world-arkab-prior-a-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4b90a814b0> ;
    oa:about id:world-arkab-prior-a ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4311 .
