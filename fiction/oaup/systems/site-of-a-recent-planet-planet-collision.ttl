# (Site of a recent planet-planet collision)

id:inner-sphere-row-1051 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "(Site of a recent planet-planet collision)" .

claim:inner-sphere-inner-sphere-row-1051-cd5bebfd0321 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-1051 ;
    oa:canonical true ;
    oa:colonyName "(Site of a recent planet-planet collision)" ;
    oa:luminositySol "9.5" ;
    oa:massSol "2.0" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 1050 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-1051-cd5bebfd0321-source-distance ;
    oa:spectralType "A7 V" ;
    oa:starName "HD 172555" .

value:inner-sphere-inner-sphere-row-1051-cd5bebfd0321-source-distance a oa:QuantityValue ;
    qudt:numericValue 93.897 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
