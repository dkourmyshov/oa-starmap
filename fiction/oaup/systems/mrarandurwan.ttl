# Owidraramar

id:world-owidraramar a oa:Place, oa:World ;
    skos:prefLabel "Owidraramar" ;
    oa:article <https://www.orionsarm.com/eg-article/625f736f34ff0> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "AB Aurigae, in Auriga at 509 ly. The variable-star designation is not one the catalogue indexes, so the star is reached by its HD number instead." ;
    oa:systemName "Mrarandurwan" ;
    oa:uncertain false .

claim:location-world-owidraramar a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/625f736f34ff0> ;
    oa:about id:world-owidraramar ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 31293 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-owidraramar-solar-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/625f736f34ff0> ;
    oa:about id:world-owidraramar ;
    oa:canonical true ;
    oa:polity id:polity-solar-dominion ;
    oa:recordOrder 0 .
