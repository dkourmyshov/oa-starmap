# Relay 2

id:inner-sphere-row-0832 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Relay 2" .

claim:inner-sphere-inner-sphere-row-0832-fe8a726263b5 a prov:Entity, oa:InnerSphereClaim ;
