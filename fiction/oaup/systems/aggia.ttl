    oa:recordOrder 676 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0677-14e62ce69986-source-distance ;
    oa:spectralType "F2 V" ;
    oa:starName "Xi Ophiuchi A" .

value:inner-sphere-inner-sphere-row-0677-14e62ce69986-source-distance a oa:QuantityValue ;
    qudt:numericValue 57.138 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
