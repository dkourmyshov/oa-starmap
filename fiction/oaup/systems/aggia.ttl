# Aggia

id:inner-sphere-row-0677 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Aggia" .

claim:inner-sphere-inner-sphere-row-0677-14e62ce69986 a prov:Entity, oa:InnerSphereClaim ;
