# Sadalsuud

id:world-sadalsuud a oa:Place, oa:World ;
    skos:prefLabel "Sadalsuud" ;
    oa:article <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-sadalsuud a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:about id:world-sadalsuud ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -5.571175556 ;
    oa:distance value:location-world-sadalsuud-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is HIP 106278. It has no article of its own and is named in the one cited. Beta Aquarii, a real star, under its traditional name." ;
    oa:rightAscensionDeg 322.889715458 .

value:location-world-sadalsuud-distance a oa:QuantityValue ;
    qudt:numericValue 537.343 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-sadalsuud-keter-dominion a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fb5d37cbdb6> ;
    oa:about id:world-sadalsuud ;
    oa:canonical true ;
    oa:polity id:polity-keter-dominion ;
    oa:recordOrder 0 .
