claim:event-world-avanola-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/5f9b29c09ab97> ;
    oa:about id:world-avanola ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached in the thirty-eighth century." ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
