    oa:note "Arkab Prior A + B colonised; Arkab Prior A is allocated to the Negentropy Alliance, Arkab Prior B to the MPA." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:sourceDescription "Encyclopaedia timeline, The Integration" ;
    oa:yearAT 4311 .
