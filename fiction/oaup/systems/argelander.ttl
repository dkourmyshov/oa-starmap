@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Argelander

id:world-argelander a oa:Place, oa:World ;
    skos:prefLabel "Argelander" ;
    oa:article <https://www.orionsarm.com/eg-article/45f9757b533b6> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:systemName "Argelander" ;
    oa:uncertain false .

claim:location-world-argelander a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f9757b533b6> ;
    oa:about id:world-argelander ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -58.5691 ;
    oa:distance value:location-world-argelander-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "In Carina, from coordinates given to a hundredth of a second of arc. Designated JD 344111-890, or TYC 8579-870-1, neither of which this map carries, so the coordinates are what place it." ;
    oa:rightAscensionDeg 125.5458 .

value:location-world-argelander-distance a oa:QuantityValue ;
    qudt:numericValue 219.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-argelander-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f9757b533b6> ;
    oa:about id:world-argelander ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-argelander-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f9757b533b6> ;
    oa:about id:world-argelander ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2190 .
