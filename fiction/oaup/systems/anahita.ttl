# Anahita

id:world-anahita a oa:Place, oa:World ;
    skos:prefLabel "Anahita" ;
    oa:article <https://www.orionsarm.com/eg-article/45f0d621c1174> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 249, as the colony table has it." ;
    oa:systemName "Anahita" ;
    oa:uncertain false .

claim:location-world-anahita a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0d621c1174> ;
    oa:about id:world-anahita ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 249" .

claim:affiliation-world-anahita-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0d621c1174> ;
    oa:about id:world-anahita ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-anahita-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0d621c1174> ;
    oa:about id:world-anahita ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"After the war the system was awarded to Metasoft where it became an independent module; it is to a large extent the biont gateway to Metasoft today.\" The war is the Geminga Orthodoxy fleet's attack begun in 3799, whose siege 'lasted till 3805'; the award is dated only as following that war. 'After the war' of 3799-3805; the original colonisation by the Dionysan Erotocracy, and the Conver Ambi's holding, are undated." ;
    oa:polity id:polity-metasoft ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 0 ;
    oa:yearAT 3805 .

claim:event-world-anahita-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/45f0d621c1174> ;
    oa:about id:world-anahita ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Anahita was originally colonized by Dionysians during the expansion of the Erotocracy. After its dissolution it became part of the Conver Ambi, but retained extensive contacts with other Inner Sphere systems.\" Neither the Erotocracy's end nor the accession is dated; the bounds are the Ambi's establishment on the timeline (1984) and the Geminga Orthodoxy's attack of 3799." ;
    oa:polity id:polity-conver-ambi ;
    oa:precision oa:Between ;
    oa:recordOrder 1 ;
    oa:untilAT 3799 ;
    oa:yearAT 1984 .

