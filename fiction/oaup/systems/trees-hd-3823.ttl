# Trees (HD 3823)

id:world-trees-hd-3823 a oa:Place, oa:World ;
    skos:altLabel "Trees" ;
    skos:prefLabel "Trees (HD 3823)" ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-trees-hd-3823 a prov:Entity, oa:LocationClaim ;
    oa:about id:world-trees-hd-3823 ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -59.454603611 ;
    oa:distance value:location-world-trees-hd-3823-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg-article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer, which gave no coordinates itself. The add-on's designation for the primary is HD 3823, on a row the colony table already carries with no colony name. The Encyclopaedia's own Trees is HD 47186 at 121.9 ly, entered above: two different stars forty light years apart. They were probably meant as one place, but nothing establishes that, so both are drawn and each names the other. See questions.md." ;
    oa:rightAscensionDeg 10.106956875 .

value:location-world-trees-hd-3823-distance a oa:QuantityValue ;
    qudt:numericValue 81.4 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
