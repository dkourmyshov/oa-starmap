# Benes

id:world-benes a oa:Place, oa:World ;
    skos:prefLabel "Benes" ;
    oa:article <https://www.orionsarm.com/eg-article/460c3a58c388a> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "HD 17925, as the colony table has it." ;
    oa:systemName "Benes" ;
    oa:uncertain false .

claim:location-world-benes a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3a58c388a> ;
    oa:about id:world-benes ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 17925" .

claim:event-world-benes-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3a58c388a> ;
    oa:about id:world-benes ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Reached : 1699\" The body's account of the Lagrange Defenders' survey and sale of the system carries no year of its own; this panel figure is presumed to be that event but the text does not say so." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1699 .

claim:event-world-benes-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3a58c388a> ;
    oa:about id:world-benes ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In 1749 AT , the Council elected to join the Eridanus League , giving them access to a wealth of information that resulted in both local renaissances and rashes of ideological conflicts, although the Council successfully prevented these conflicts from escalating and causing widespread damage.\"" ;
    oa:polity id:polity-eridanus-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1749 .

claim:event-world-benes-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460c3a58c388a> ;
    oa:about id:world-benes ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The system joined the Taurus Nexus at the first opportunity, taking advantage of the wormhole link between Makintairas and Rana that was first opened in 2657.\" The sentence dates the wormhole's opening, not the join itself, but ties the join to it as \"the first opportunity\". The year is the wormhole's opening, at the first opportunity after which the system joined." ;
    oa:polity id:polity-taurus-nexus ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 2 ;
    oa:yearAT 2657 .

