# Rangar

id:world-rangar a oa:Place, oa:World ;
    skos:prefLabel "Rangar" ;
    oa:article <https://www.orionsarm.com/eg-article/48f73a3693b59> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "In Ophiuchus at 1,074 ly." ;
    oa:systemName "Etaran" ;
    oa:uncertain false .

claim:location-world-rangar a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f73a3693b59> ;
    oa:about id:world-rangar ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hdId 148071 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-rangar-negentropy-alliance a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f73a3693b59> ;
    oa:about id:world-rangar ;
    oa:canonical true ;
    oa:polity id:polity-negentropy-alliance ;
    oa:recordOrder 0 .

claim:event-world-rangar-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f73a3693b59> ;
    oa:about id:world-rangar ;
    oa:canonical true ;
    oa:eventKind oa:Observed ;
    oa:note "First observed, not reached. No establishment date is given at all, so this is the only year the system has." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3702 .
