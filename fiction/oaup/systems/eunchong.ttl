# Eunchong

id:world-eunchong a oa:Place, oa:World ;
    skos:prefLabel "Eunchong" ;
    oa:article <https://www.orionsarm.com/eg-article/4916fc19b5b98> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 832, as the colony table has it." ;
    oa:systemName "Eunchong" ;
    oa:uncertain false .

claim:location-world-eunchong a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4916fc19b5b98> ;
    oa:about id:world-eunchong ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 832" .

claim:affiliation-world-eunchong-zoeific-biopolity a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4916fc19b5b98> ;
    oa:about id:world-eunchong ;
    oa:canonical true ;
    oa:polity id:polity-zoeific-biopolity ;
    oa:recordOrder 0 .

claim:event-world-eunchong-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4916fc19b5b98> ;
    oa:about id:world-eunchong ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"After a quick survey of the system after arrival in 798 AT, the spacer-dominated colonists realized that Eunchong was not going to be an easy place to thrive in.\" The colonists are 'a fiercely independent splinter group of the EOCC via a GAIA Ark' per the preceding sentence; EOCC is not on the roster. Aboard the Trinity, an EOCC splinter group, no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 798 .

claim:event-world-eunchong-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4916fc19b5b98> ;
    oa:about id:world-eunchong ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The system was officially integrated into the Eridanus League in 1128.\"" ;
    oa:polity id:polity-eridanus-league ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1128 .

