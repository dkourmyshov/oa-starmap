claim:event-world-frog-s-head-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46510b2b2c317> ;
    oa:about id:world-frog-s-head ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"In 1140 a small fleet of automated Genen bioships were sent to assess the Iota system and its worlds and resources, and prepare them for the arrival of the Genetekker ark.\" The bioships belong to House Genen (later joined to the First Federation, per the preceding sentence), not explicitly the Federation itself; House Genen is not on the roster. Automated Genen bioships preparing the system for the Genetekker ark; House Genen is no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 1140 .
