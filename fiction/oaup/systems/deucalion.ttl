# Deucalion

id:world-deucalion a oa:Place, oa:World ;
    skos:prefLabel "Deucalion" ;
    oa:article <https://www.orionsarm.com/eg-article/48f4fe1ed9f27> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "HD 2071, as the colony table has it." ;
    oa:systemName "Deucalion" ;
    oa:uncertain false .

claim:location-world-deucalion a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4fe1ed9f27> ;
    oa:about id:world-deucalion ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 2071" .

claim:event-world-deucalion-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4fe1ed9f27> ;
    oa:about id:world-deucalion ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised 2603AT\" data-panel figure; the body text describes only a probe reaching the system in 2603 AT, with colonists arriving roughly six centuries later (see contradictions) The body has only an automated probe of the Phoenix Sector Terraformation Corporation, a LinnEnt venture, in 2603, with colonists some six centuries later; both readings are kept." ;
    oa:polity id:polity-linnent ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2603 .

claim:event-world-deucalion-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48f4fe1ed9f27> ;
    oa:about id:world-deucalion ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"HD 2071 was first explored in 2603 a.t. by an automated probe belonging to the Phoenix Sector Terraformation Corporation ; these probes were sent out from Audobon system in Grus as part of the Linnent Empire.\" acting agent was the Phoenix Sector Terraformation Corporation (not on the roster), operating as part of the Linnent Empire" ;
    oa:polity id:polity-linnent ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2603 .

