# Muphrid

id:inner-sphere-row-0417 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Muphrid" .

claim:inner-sphere-inner-sphere-row-0417-45d80d90d099 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0417 ;
    oa:canonical true ;
    oa:colonyName "Muphrid" ;
    oa:luminositySol "9.493" ;
    oa:massSol "1.5" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 416 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0417-45d80d90d099-source-distance ;
    oa:spectralType "G0 IV" ;
    oa:starName "Eta Boötis A" .

value:inner-sphere-inner-sphere-row-0417-45d80d90d099-source-distance a oa:QuantityValue ;
    qudt:numericValue 37.17 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
