# Sindhu

id:inner-sphere-row-0081 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Sindhu" .

claim:inner-sphere-inner-sphere-row-0081-00f082f9e206 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0081 ;
    oa:canonical true ;
    oa:colonyName "Sindhu" ;
    oa:luminositySol "0.0017 to 0.046" ;
    oa:massSol "0.35" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 80 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0081-00f082f9e206-source-distance ;
    oa:spectralType "M5.5 Ve" ;
    oa:starName "EV Lacertae" .

value:inner-sphere-inner-sphere-row-0081-00f082f9e206-source-distance a oa:QuantityValue ;
    qudt:numericValue 16.476 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
