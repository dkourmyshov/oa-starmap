    oa:colonyName "Yosunoh" ;
    oa:luminositySol "0.313" ;
    oa:massSol "0.825" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 436 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0437-f23cbd0ddac1-source-distance ;
    oa:spectralType "G8 V" ;
    oa:starName "Iota Pegasi Ab" .

value:inner-sphere-inner-sphere-row-0437-f23cbd0ddac1-source-distance a oa:QuantityValue ;
