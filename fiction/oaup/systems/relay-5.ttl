    oa:about id:inner-sphere-row-0473 ;
    oa:canonical true ;
    oa:colonyName "Relay 5" ;
    oa:luminositySol "1.01" ;
    oa:massSol "0.92" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 472 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0473-1d03b917b7fd-source-distance ;
    oa:spectralType "G5 V" ;
    oa:starName "HD 147513 A" .

value:inner-sphere-inner-sphere-row-0473-1d03b917b7fd-source-distance a oa:QuantityValue ;
    qudt:numericValue 42.049 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

