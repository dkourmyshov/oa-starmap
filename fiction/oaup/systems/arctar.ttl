# Kalii

id:world-kalii a oa:Place, oa:World ;
    skos:prefLabel "Kalii" ;
    oa:article <https://www.orionsarm.com/eg-article/46478982497db> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Not a Caretaker system any more, whatever it was between 3780 and 4323: the Caretaker sold it on, and the affiliation here is the present holder. HIP 9024 is HD 11697, in Perseus at 354 ly." ;
    oa:systemName "Arctar" ;
    oa:uncertain false .

claim:location-world-kalii a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46478982497db> ;
    oa:about id:world-kalii ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 9024 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-kalii-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46478982497db> ;
    oa:about id:world-kalii ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

claim:event-world-kalii-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46478982497db> ;
    oa:about id:world-kalii ;
    oa:canonical true ;
    oa:eventKind oa:Stewardship ;
    oa:note "Taken over by a Caretaker God. The initial colonisation attempts are undated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3780 .

claim:event-world-kalii-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46478982497db> ;
    oa:about id:world-kalii ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "Sold to a Non-Coercive Zone business." ;
    oa:polity id:polity-nocozo ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 4323 .
