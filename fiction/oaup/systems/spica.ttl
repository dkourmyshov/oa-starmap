@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Spica

id:world-spica a oa:Place, oa:World ;
    skos:prefLabel "Spica" ;
    oa:article <https://www.orionsarm.com/eg-article/66afb37911d15> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Alpha Virginis, 250 ly out — a blue giant pair, and the brightest star in Virgo, now the Panvirtuality's." ;
    oa:systemName "Spica" ;
    oa:uncertain false .

claim:location-world-spica a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66afb37911d15> ;
    oa:about id:world-spica ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Spica" .

claim:affiliation-world-spica-solipsist-panvirtuality a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66afb37911d15> ;
    oa:about id:world-spica ;
    oa:canonical true ;
    oa:polity id:polity-solipsist-panvirtuality ;
    oa:recordOrder 0 .

claim:event-world-spica-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66afb37911d15> ;
    oa:about id:world-spica ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:NotLaterThan ;
    oa:recordOrder 0 ;
    oa:yearAT 6603 .

claim:event-world-spica-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66afb37911d15> ;
    oa:about id:world-spica ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Reached 2499 AT by a solipsist transapient colony ship, codenamed Aim for the Stars.\" The map's older 'settled 6603' is the year the archailect Twin Sister emerged, not a settlement." ;
    oa:polity id:polity-solipsist-panvirtuality ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 2499 .

claim:event-world-spica-003 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66afb37911d15> ;
    oa:about id:world-spica ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"It was shortly followed by a Federation mission Kazumyu.\" No explicit year is stated for the Kazumyu mission; it is only dated relative to the 2499 AT arrival of Aim for the Stars in the preceding sentence. The Federation mission Kazumyu, 'shortly' after the solipsist ship." ;
    oa:polity id:polity-first-federation ;
    oa:precision oa:NotEarlierThan ;
    oa:recordOrder 2 ;
    oa:yearAT 2499 .
