    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/657c8d74d4ff6> ;
    oa:about id:world-resonance ;
    oa:canonical true ;
    oa:polity id:polity-iota-network ;
    oa:recordOrder 0 .

