    oa:about id:inner-sphere-row-0104 ;
    oa:canonical true ;
    oa:colonyName "Retmon" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 103 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0104-027dad4c1010-source-distance ;
    oa:spectralType "T8" ;
    oa:starName "2MASS J04151954-0935066" .

value:inner-sphere-inner-sphere-row-0104-027dad4c1010-source-distance a oa:QuantityValue ;
    qudt:numericValue 18.708 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
