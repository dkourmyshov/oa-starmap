# Xdim

id:world-xdim a oa:Place, oa:World ;
    skos:prefLabel "Xdim" ;
    oa:article <https://www.orionsarm.com/eg-article/46f1daaa9d1d4> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "GJ 1105, as the colony table has it." ;
    oa:systemName "Xdim" ;
    oa:uncertain false .

claim:location-world-xdim a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f1daaa9d1d4> ;
    oa:about id:world-xdim ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "GJ 1105" .

claim:event-world-xdim-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46f1daaa9d1d4> ;
    oa:about id:world-xdim ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Xdim was colonized in the 5500's by Xdim Euhabi, a corporation-sect maintaining the computronium habitats of uploaded bionts.\" Xdim Euhabi, a corporation-sect, no polity of this file." ;
    oa:precision oa:Circa ;
    oa:recordOrder 0 ;
    oa:yearAT 5500 .

# Xdim

id:inner-sphere-row-0283 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Xdim" .

claim:inner-sphere-inner-sphere-row-0283-09cf9337bcab a prov:Entity, oa:InnerSphereClaim ;
