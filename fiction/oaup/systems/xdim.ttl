    oa:spectralType "M3.5 Ve" ;
    oa:starName "GJ 1105" .

value:inner-sphere-inner-sphere-row-0283-09cf9337bcab-source-distance a oa:QuantityValue ;
    qudt:numericValue 28.865 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
