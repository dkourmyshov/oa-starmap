    oa:about id:inner-sphere-row-0283 ;
    oa:article <https://www.orionsarm.com/eg-article/46f1daaa9d1d4> ;
    oa:canonical true ;
    oa:colonyName "Xdim" ;
    oa:luminositySol "." ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
