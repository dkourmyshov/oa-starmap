# Hamal

id:world-hamal a oa:Place, oa:World ;
    skos:prefLabel "Hamal" ;
    oa:article <https://www.orionsarm.com/eg-article/464dd7be05218> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Alpha Arietis, and the colony table already records both holders. The article's 65.81 ly is the catalogue's figure to two decimals; its 8.386 ly to Sheratan comes out at 8.324 here, which is a later parallax moving Sheratan rather than any doubt about which stars these are. Gatewai is a world of this system." ;
    oa:systemName "Hamal" ;
    oa:uncertain false .

claim:location-world-hamal a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd7be05218> ;
    oa:about id:world-hamal ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Alpha Arietis" .

claim:affiliation-world-hamal-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd7be05218> ;
    oa:about id:world-hamal ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:affiliation-world-hamal-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/464dd7be05218> ;
    oa:about id:world-hamal ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 1 .

