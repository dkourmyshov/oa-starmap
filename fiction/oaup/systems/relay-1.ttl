# Relay 1

id:inner-sphere-row-0802 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Relay 1" .

claim:inner-sphere-inner-sphere-row-0802-307919499c76 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0802 ;
    oa:canonical true ;
    oa:colonyName "Relay 1" ;
    oa:luminositySol "3.779" ;
    oa:massSol "." ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 801 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0802-307919499c76-source-distance ;
    oa:spectralType "F5 IV-V" ;
    oa:starName "17 Cygni A" .

value:inner-sphere-inner-sphere-row-0802-307919499c76-source-distance a oa:QuantityValue ;
    qudt:numericValue 68.446 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

