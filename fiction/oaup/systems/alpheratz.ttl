# Alpheratz

id:inner-sphere-row-1089 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Alpheratz" .

claim:inner-sphere-inner-sphere-row-1089-17dd7f1d2e9c a prov:Entity, oa:InnerSphereClaim ;
