    oa:about id:inner-sphere-row-1089 ;
    oa:canonical true ;
    oa:colonyName "Alpheratz" ;
    oa:luminositySol "240" ;
    oa:massSol "3.8" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 1088 ;
