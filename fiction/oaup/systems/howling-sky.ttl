# Howling Sky

id:world-howling-sky a oa:Place, oa:World ;
    skos:prefLabel "Howling Sky" ;
    oa:article <https://www.orionsarm.com/eg-article/66ed91e548374> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Groombridge 34 A, as the colony table has it." ;
    oa:systemName "Howling Sky" ;
    oa:uncertain false .

claim:location-world-howling-sky a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66ed91e548374> ;
    oa:about id:world-howling-sky ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Groombridge 34 A" .

claim:event-world-howling-sky-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66ed91e548374> ;
    oa:about id:world-howling-sky ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"First Colonised 1120 AT\"" ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1120 .

claim:event-world-howling-sky-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66ed91e548374> ;
    oa:about id:world-howling-sky ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"The system joined the short-lived Second Federation in 3086 and that organisation managed to establish treaties providing for limited coexistence and trade between the various factions, establishing Lightways connections and re-establishing the Beamrider Network station which had been closed during the Vechon conflict.\"" ;
    oa:polity id:polity-second-federation ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 3086 .

# Howling Sky

id:inner-sphere-row-0029 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
