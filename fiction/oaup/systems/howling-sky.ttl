    oa:sourceDistance value:inner-sphere-inner-sphere-row-0029-6fec3e5e256b-source-distance ;
    oa:spectralType "M1.5 Vn" ;
    oa:starName "Groombridge 34 A" .

value:inner-sphere-inner-sphere-row-0029-6fec3e5e256b-source-distance a oa:QuantityValue ;
    qudt:numericValue 11.619 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

