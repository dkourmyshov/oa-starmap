# Byrdis

id:world-byrdis a oa:Place, oa:World ;
    skos:prefLabel "Byrdis" ;
    oa:article <https://www.orionsarm.com/eg-article/4611a0308412d> ;
    oa:kind "megastructure" ;
    oa:labelsSystem false ;
    oa:note "Gliese 109, 25 ly. The colony table gives the system as \"Byrdis & Ka Yvanti\", with one a in Ka rather than two." ;
    oa:systemName "Kaa Yvanti" ;
    oa:uncertain false .

claim:location-world-byrdis a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611a0308412d> ;
    oa:about id:world-byrdis ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 109" .

claim:affiliation-world-byrdis-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611a0308412d> ;
    oa:about id:world-byrdis ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association ;
    oa:recordOrder 0 .

claim:event-world-byrdis-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611a0308412d> ;
    oa:about id:world-byrdis ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2069 .

claim:event-world-byrdis-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4611a0308412d> ;
    oa:about id:world-byrdis ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"In 8760 the system joined the MPA, and the influx of megaengineering expertise, trade and bradyvals continued the growth of Byrdis.\"" ;
    oa:polity id:polity-mutual-progress-association ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 8760 .
