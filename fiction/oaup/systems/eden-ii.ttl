# Eden II

id:world-eden-ii a oa:Place, oa:World ;
    skos:prefLabel "Eden II" ;
    oa:article <https://www.orionsarm.com/eg-article/4911ce8f43ea3> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-eden-ii a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4911ce8f43ea3> ;
    oa:about id:world-eden-ii ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -2.427944444 ;
    oa:distance value:location-world-eden-ii-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. The add-on's designation for the primary is TYC 5224-397-1. It has no article of its own and is named in the one cited. No polity recorded." ;
    oa:rightAscensionDeg 330.468966667 .

value:location-world-eden-ii-distance a oa:QuantityValue ;
    qudt:numericValue 688.12 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
