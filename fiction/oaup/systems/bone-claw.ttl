# Bone-Claw

id:world-bone-claw a oa:Place, oa:World ;
    skos:prefLabel "Bone-Claw" ;
    oa:article <https://www.orionsarm.com/eg-article/59b11b8fe7dfd> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Eta Cephei, as the colony table has it." ;
    oa:systemName "Bone-Claw" ;
    oa:uncertain false .

claim:location-world-bone-claw a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/59b11b8fe7dfd> ;
    oa:about id:world-bone-claw ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Eta Cephei" .

claim:event-world-bone-claw-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/59b11b8fe7dfd> ;
    oa:about id:world-bone-claw ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised 1550\" Sapient Hyenas from the First Federation who, the article says, sought independence from it; no holder is named." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1550 .

