# NewRoot

id:world-newroot a oa:Place, oa:World ;
    skos:prefLabel "NewRoot" ;
    oa:article <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Nu-2 Lupi, 48 ly out." ;
    oa:uncertain false .

claim:location-world-newroot a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:about id:world-newroot ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Nu2 Lupi" .

claim:affiliation-world-newroot-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:about id:world-newroot ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:event-world-newroot-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:about id:world-newroot ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:polity id:polity-metasoft ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2019 .

# NewRoot

id:inner-sphere-row-0571 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "NewRoot" .

claim:inner-sphere-inner-sphere-row-0571-6994fa154d16 a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0571 ;
    oa:article <https://www.orionsarm.com/eg-article/49022a2c0c9be> ;
    oa:canonical true ;
    oa:colonyName "NewRoot" ;
    oa:luminositySol "1.038" ;
    oa:massSol "0.87" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 570 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0571-6994fa154d16-source-distance ;
    oa:spectralType "G4 V" ;
    oa:starName "Nu2 Lupi" .

value:inner-sphere-inner-sphere-row-0571-6994fa154d16-source-distance a oa:QuantityValue ;
    qudt:numericValue 48.073 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
