# Vaishali

id:world-vaishali a oa:Place, oa:World ;
    skos:prefLabel "Vaishali" ;
    oa:article <https://www.orionsarm.com/eg-article/48fa76119f471> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Tau Boötis A, as the colony table has it." ;
    oa:systemName "Vaishali" ;
    oa:uncertain false .

claim:location-world-vaishali a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa76119f471> ;
    oa:about id:world-vaishali ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Tau Boötis A" .

claim:event-world-vaishali-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/48fa76119f471> ;
    oa:about id:world-vaishali ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"Reached 1993\" The planet's other name, Millennium, is said to come from the arrival date of the first colonists, which the article does not give." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1993 .

