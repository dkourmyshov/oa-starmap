# Noyce

id:world-noyce a oa:Place, oa:World ;
    skos:prefLabel "Noyce" ;
    oa:article <https://www.orionsarm.com/eg-article/46dcc5b188fa3> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "In Vela at 87 ly. The star is given as Hokon's Third Purchase, probably a former name. No colonisation date, beyond its being before the Version War." ;
    oa:systemName "Noyce" ;
    oa:uncertain false .

claim:location-world-noyce a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46dcc5b188fa3> ;
    oa:about id:world-noyce ;
    oa:canonical true ;
    oa:catalogueFromSource true ;
    oa:hipparcosId 42601 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

claim:affiliation-world-noyce-nocozo a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46dcc5b188fa3> ;
    oa:about id:world-noyce ;
    oa:canonical true ;
    oa:polity id:polity-nocozo ;
    oa:recordOrder 0 .

