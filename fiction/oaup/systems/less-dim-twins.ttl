# Less Dim Twins

id:inner-sphere-row-0042 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Less Dim Twins" .

claim:inner-sphere-inner-sphere-row-0042-86e676099adf a prov:Entity, oa:InnerSphereClaim ;
    prov:hadPrimarySource src:inner-sphere-table ;
    oa:about id:inner-sphere-row-0042 ;
    oa:canonical true ;
    oa:colonyName "Less Dim Twins" ;
    oa:luminositySol "0.0004" ;
    oa:massSol "0.07" ;
    oa:method oa:DirectTranscription ;
    oa:recordOrder 41 ;
    oa:sourceDistance value:inner-sphere-inner-sphere-row-0042-86e676099adf-source-distance ;
    oa:spectralType "M8.5 V" ;
    oa:starName "SCR 1845-6357 A" .

value:inner-sphere-inner-sphere-row-0042-86e676099adf-source-distance a oa:QuantityValue ;
    qudt:numericValue 13.050 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

