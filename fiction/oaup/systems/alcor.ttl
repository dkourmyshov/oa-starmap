# Alcor

id:world-alcor a oa:Place, oa:World ;
    skos:prefLabel "Alcor" ;
    oa:article <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "An ahuman colony, already settled when Mizar was reached in 2097, and affiliated with the Solipsist Panvirtuality. Recorded separately from Mizar because the two are different holders at the same place: 81.1 ly against 81.7, which is nothing at this scale." ;
    oa:systemName "Alcor" ;
    oa:uncertain false .

claim:location-world-alcor a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-alcor ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Alcor" .

claim:affiliation-world-alcor-solipsist-panvirtuality a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-alcor ;
    oa:canonical true ;
    oa:polity id:polity-solipsist-panvirtuality ;
    oa:recordOrder 0 .

claim:event-world-alcor-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-alcor ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"In 3645 a Panvirt linelayer arrived in the Alcor System, and after some (apparently ritualized) combat proceeded to open a wormhole from there to the Solipsist wormhole nexus.\"" ;
    oa:polity id:polity-solipsist-panvirtuality ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 3645 .

claim:event-world-alcor-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4c1cb2ca8f150> ;
    oa:about id:world-alcor ;
    oa:canonical true ;
    oa:eventKind oa:Transferred ;
    oa:note "\"Although no official conformation has come out of Alcor concerning this event, it must be assumed that this system is now a part of, or at least affiliated with, the Solipsist Panvirtuality.\" The article's own hedge: no official confirmation has come out of Alcor." ;
    oa:polity id:polity-solipsist-panvirtuality ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 3645 .

