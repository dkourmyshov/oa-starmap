# Capella

id:world-capella a oa:Place, oa:World ;
    skos:prefLabel "Capella" ;
    oa:article <https://www.orionsarm.com/eg-article/4603222d0037f> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Alpha Aurigae Aa, as the colony table has it." ;
    oa:systemName "Capella" ;
    oa:uncertain false .

claim:location-world-capella a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4603222d0037f> ;
    oa:about id:world-capella ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Alpha Aurigae Aa" .

claim:event-world-capella-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4603222d0037f> ;
    oa:about id:world-capella ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Colonised: 1287 AT\"" ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 1287 .

claim:event-world-capella-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4603222d0037f> ;
    oa:about id:world-capella ;
    oa:canonical true ;
    oa:eventKind oa:Capital ;
    oa:note "\"Capella became the capital of an important regional polity in the wake of the ComEmp break-up in 5350 AT .\" The 'regional polity' is not named in this sentence; the Related Articles list links to a separate 'Capellan Federation' article, which is not on the roster and not textually confirmed as this polity. The polity is the Capellan Federation, named only in a related-articles link; no polity of this file." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 5350 .

