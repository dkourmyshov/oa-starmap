# Hermes

id:world-hermes a oa:Place, oa:World ;
    skos:prefLabel "Hermes" ;
    oa:article <https://www.orionsarm.com/eg-article/46707cc338668> ;
    oa:kind "planet" ;
    oa:labelsSystem false ;
    oa:note "Beta Canum Venaticorum I-A — Chara, 28 ly out. Loosely aligned with Metasoft and carrying Silicon Generation settlements besides, so both are recorded; loosely is the article's word and neither holds it outright." ;
    oa:uncertain false .

claim:location-world-hermes a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46707cc338668> ;
    oa:about id:world-hermes ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Beta Canum Venaticorum" .

claim:affiliation-world-hermes-metasoft a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46707cc338668> ;
    oa:about id:world-hermes ;
    oa:canonical true ;
    oa:polity id:polity-metasoft ;
    oa:recordOrder 0 .

claim:affiliation-world-hermes-silicon-generation a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46707cc338668> ;
    oa:about id:world-hermes ;
    oa:canonical true ;
    oa:polity id:polity-silicon-generation ;
    oa:recordOrder 1 .
