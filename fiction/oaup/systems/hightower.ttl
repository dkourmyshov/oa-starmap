@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Hightower

id:world-hightower a oa:Place, oa:World ;
    skos:prefLabel "Hightower" ;
    oa:article <https://www.orionsarm.com/eg-article/46709b72c8717> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "The primary world of the Realm of the Deeper Covenant, 759 ly out — nine light years beyond the Realm's own stated distance, which is well inside a structure of that size." ;
    oa:uncertain false .

claim:location-world-hightower a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46709b72c8717> ;
    oa:about id:world-hightower ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 46.166666667 ;
    oa:distance value:location-world-hightower-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "759 ly is the article's own, and the direction is now the system's own rather than the Realm of the Deeper Covenant's borrowed: the archived Wormhole Gazetteer (https://www.orionsarm.com/eg-article/4e297b0884b1a) names Hightower, and the Celestia add-on built from it (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436) gives these coordinates at exactly the 759 ly the article states. Two things recommend it over the borrowed direction. It agrees with that borrowed direction to eight degrees, which is well inside the twenty this entry used to carry — two methods landing in the same place. And its gate partner, Dam Tellion, lies 56 degrees away, so this is not one of the add-on's positions that merely copies the direction of whatever a system is linked to." ;
    oa:rightAscensionDeg 97.5 .

value:location-world-hightower-distance a oa:QuantityValue ;
    qudt:numericValue 759.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-hightower-deeper-covenant a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46709b72c8717> ;
    oa:about id:world-hightower ;
    oa:canonical true ;
    oa:polity id:polity-deeper-covenant ;
    oa:recordOrder 0 .

claim:event-world-hightower-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46709b72c8717> ;
    oa:about id:world-hightower ;
    oa:canonical true ;
    oa:eventKind oa:Observed ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 4715 .
