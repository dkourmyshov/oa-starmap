# Relay 6

id:inner-sphere-row-0762 a oa:InnerSphereSystem, oa:Place, oa:StarSystem ;
    skos:prefLabel "Relay 6" .

claim:inner-sphere-inner-sphere-row-0762-90aa697529fa a prov:Entity, oa:InnerSphereClaim ;
