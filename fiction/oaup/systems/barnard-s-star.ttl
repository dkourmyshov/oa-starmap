# Barnard's Star

id:world-barnard-s-star a oa:Place, oa:World ;
    skos:prefLabel "Barnard's Star" ;
    oa:article <https://www.orionsarm.com/eg-article/4609c8d6cadb4> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "Gliese 699, as the colony table has it." ;
    oa:systemName "Barnard's Star" ;
    oa:uncertain false .

claim:location-world-barnard-s-star a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c8d6cadb4> ;
    oa:about id:world-barnard-s-star ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Gliese 699" .

claim:event-world-barnard-s-star-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4609c8d6cadb4> ;
    oa:about id:world-barnard-s-star ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"Barnard's Star was one of the first systems to be reached by refugee ships after the Great Expulsion, when the Skylark of Valeron arrived there in 761 AT.\" Refugees of the Great Expulsion; the article names no polity, then or since, its later holders being local factions." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 761 .

