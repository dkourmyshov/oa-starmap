# Excelsior

id:world-excelsior a oa:Place, oa:World ;
    skos:prefLabel "Excelsior" ;
    oa:article <https://www.orionsarm.com/eg-article/66649fe342b45> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "HD 217107, 65 ly. No polity of this file is named as holding it at any date; the article's actors are a transapient administrator and, later, Corona's warships." ;
    oa:systemName "Excelsior" ;
    oa:uncertain false .

claim:location-world-excelsior a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66649fe342b45> ;
    oa:about id:world-excelsior ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "HD 217107" .

claim:event-world-excelsior-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66649fe342b45> ;
    oa:about id:world-excelsior ;
    oa:canonical true ;
    oa:eventKind oa:Settled ;
    oa:note "\"A splinter group of heterodox Centauri Vehicle Buddhists under the patronage of the then-S:1 Gone/Semiote/Gone had taken the risk of attempting to settle\" the inner system, in 2031." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2031 .

claim:event-world-excelsior-002 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/66649fe342b45> ;
    oa:about id:world-excelsior ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "\"The hyperturing linelayer Oholiab II arrived on schedule in 3499\", collapsed its wormhole payload and fled: the Excelsior Incident." ;
    oa:precision oa:Exact ;
    oa:recordOrder 1 ;
    oa:yearAT 3499 .

