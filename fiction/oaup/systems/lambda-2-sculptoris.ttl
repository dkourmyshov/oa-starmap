# Lambda-2 Sculptoris

id:world-lambda-2-sculptoris a oa:Place, oa:World ;
    skos:prefLabel "Lambda-2 Sculptoris" ;
    oa:article <https://www.orionsarm.com/eg-article/52fa35d455d56> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:note "No dates. The catalogue puts it at 331 ly against the article's 338." ;
    oa:systemName "Lambda-2 Sculptoris" ;
    oa:uncertain false .

claim:location-world-lambda-2-sculptoris a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52fa35d455d56> ;
    oa:about id:world-lambda-2-sculptoris ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:distance value:location-world-lambda-2-sculptoris-distance ;
    oa:hipparcosId 3456 ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription .

value:location-world-lambda-2-sculptoris-distance a oa:QuantityValue ;
    qudt:numericValue 338.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-lambda-2-sculptoris-communion-of-worlds a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/52fa35d455d56> ;
    oa:about id:world-lambda-2-sculptoris ;
    oa:canonical true ;
    oa:polity id:polity-communion-of-worlds ;
    oa:recordOrder 0 .
