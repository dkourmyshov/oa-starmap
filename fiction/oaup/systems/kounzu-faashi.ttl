    oa:note "\"This system was first reached in 2096 AT by the autonomous exploration craft Waryu\" reached by an uncrewed autonomous exploration craft; no polity is named for it The autonomous probe Waryu; the later colonisation, 'during the Age of Expansion', is not dated." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 2096 .

