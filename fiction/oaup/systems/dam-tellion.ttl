# Dam Tellion

id:world-dam-tellion a oa:Place, oa:World ;
    skos:prefLabel "Dam Tellion" ;
    oa:article <https://www.orionsarm.com/eg-article/4aaed32f4b1e3> ;
    oa:kind "system" ;
    oa:labelsSystem false ;
    oa:uncertain false .

claim:location-world-dam-tellion a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/4aaed32f4b1e3> ;
    oa:about id:world-dam-tellion ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 2.016666667 ;
    oa:distance value:location-world-dam-tellion-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From the archived Wormhole Gazetteer (https://www.orionsarm.com/eg- article/4e297b0884b1a), an Encyclopaedia page removed in the Wormhole Nexus revision and kept under sources/ as a Wayback capture of November 2017, which names this system as the end of a route. Its superseded topology is not drawn. The position is the Celestia wormhole-nexus add-on's (https://celestiaproject.space/forum/viewtopic.php?f=23&t=17436), built from that same gazetteer and endorsed by Steve Bowers; the gazetteer itself gave no coordinates. It has no article of its own and is named in the one cited. No polity recorded. The Realm's article puts it \"some fifty light-years distant\" from that system, and this position cannot be reconciled with that: the two directions are 48 degrees apart as seen from Sol, so no distance along this line of sight brings them within 559 ly of each other. Drawn where the add-on puts it, because that is the only position either source gives, and the contradiction recorded rather than split. See questions.md." ;
    oa:rightAscensionDeg 57.879166667 .

value:location-world-dam-tellion-distance a oa:QuantityValue ;
    qudt:numericValue 1080.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .
