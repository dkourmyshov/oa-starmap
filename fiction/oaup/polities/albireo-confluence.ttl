# Albireo Confluence

id:polity-albireo-confluence a oa:Polity ;
    skos:prefLabel "Albireo Confluence" ;
    oa:ambiguousName false ;
    oa:color "#B06FA0" ;
    oa:editorialNote "Capital at Albireo, 363 ly out, and that is the whole of what is known\nabout where it reaches. The Albireo Plexus around it is a sector rather\nthan this polity's territory: most of what lies there owes it nothing." ;
    oa:hasSource src:eg-system-articles ;
    oa:kind "polity" ;
    oa:polityId "albireo-confluence" ;
    oa:recordOrder 40 ;
    oa:uncertain false .
