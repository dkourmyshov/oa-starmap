# Cygexpa

id:polity-cygexpa a oa:Polity ;
    skos:prefLabel "Cygexpa" ;
    oa:ambiguousName false ;
    oa:color "#4FC3F7" ;
    oa:dissolvedAT 7247 ;
    oa:editorialNote "Encyclopaedia timeline, 7247: \"The Cygexpa Sale. With no warning Lohengrin disbands the\nCygexpa empire.\" Kept, as the comment below says; from this year its places\nread as held by whoever the sources name since.\nDissolved, and kept anyway. Its volume is still a region with a history,\nand its places are tagged for it wherever nothing has claimed them since —\nso `affiliations` here reads \"was\", not \"is\". Where a successor does hold\na place, the successor is named instead: Qjellto is Utopia's and Zoeific's." ;
    oa:hasSource src:political-maps-8000at ;
    oa:kind "meta-empire" ;
    oa:polityId "cygexpa" ;
    oa:recordOrder 2 ;
    oa:uncertain false .
