# Solar Dominion

id:polity-solar-dominion a oa:Polity ;
    skos:prefLabel "Solar Dominion" ;
    oa:ambiguousName false ;
    oa:color "#FFEE58" ;
    oa:editorialNote "Its own page, data panel: \"Founded: The God-Emperor Borde-Tiphareth\nannounced the Greater Solar Dominion in 2217 AT\". The timeline has no\nline for its forming." ;
    oa:foundedAT 2217 ;
    oa:hasSource src:political-maps-8000at ;
    oa:kind "meta-empire" ;
    oa:polityId "solar-dominion" ;
    oa:recordOrder 16 ;
    oa:uncertain false .
