# Vela

id:polity-vela a oa:Polity ;
    skos:prefLabel "Vela" ;
    oa:ambiguousName true ;
    oa:color "#EF5350" ;
    oa:editorialNote "Also a constellation, and the first half of Neu Vela. The history scan\nskips it rather than reporting the Vela polity in centuries that are\ntalking about the sky or about somewhere else entirely." ;
    oa:hasSource src:political-maps-8000at ;
    oa:kind "meta-empire" ;
    oa:polityId "vela" ;
    oa:recordOrder 10 ;
    oa:uncertain false .
