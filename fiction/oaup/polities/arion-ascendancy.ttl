# Arion Ascendancy

id:polity-arion-ascendancy a oa:Polity ;
    skos:prefLabel "Arion Ascendancy" ;
    oa:ambiguousName false ;
    oa:color "#A3A072" ;
    oa:editorialNote "Its own page, saved under sources/polities: data panel \"Established: 7610 AT, after the clade Shar underwent\na collective ascension\".\nEstablished 7610 and nowhere in particular: its article places it only in\nthe \"NoCoZo Periphery\", which is a relation rather than a direction. No\nentry in worlds.yaml until something says where." ;
    oa:foundedAT 7610 ;
    oa:hasSource src:eg-system-articles ;
    oa:kind "polity" ;
    oa:polityId "arion-ascendancy" ;
    oa:recordOrder 42 ;
    oa:uncertain false .
