# Ambi Limis

id:polity-ambi-limis a oa:Polity ;
    skos:prefLabel "Ambi Limis" ;
    oa:ambiguousName false ;
    oa:color "#B2EBF2" ;
    oa:editorialNote "\"Historic polity, successor to the Conver Ambi.\" The timeline names the\nConver Limis as a party to the Conver Wars from 3842, so it predates the\ndivision of 3943; no founding or ending year is stated." ;
    oa:hasSource src:eg-historical-polities ;
    oa:kind "meta-empire" ;
    oa:polityId "ambi-limis" ;
    oa:recordOrder 53 ;
    oa:uncertain false .
