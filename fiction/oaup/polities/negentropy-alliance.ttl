# Negentropy Alliance

id:polity-negentropy-alliance a oa:Polity ;
    skos:prefLabel "Negentropy Alliance" ;
    oa:ambiguousName false ;
    oa:color "#26C6DA" ;
    oa:editorialNote "Its own page, data panel: \"Founded: 2465 a.t.\" — \"The Precepts of\nNegentropy were first announced through the Research Brotherhood of\nOmegarete in 2465 a.t.\"; the alliance proper \"established\" in 2738\n\"following their linkage through wormholes\". The earlier year is taken,\nas the page's own panel does." ;
    oa:foundedAT 2465 ;
    oa:hasSource src:political-maps-8000at ;
    oa:kind "meta-empire" ;
    oa:polityId "negentropy-alliance" ;
    oa:recordOrder 6 ;
    oa:uncertain false .
