# NeoCygexpa

id:polity-neocygexpa a oa:Polity ;
    skos:prefLabel "NeoCygexpa" ;
    oa:ambiguousName false ;
    oa:color "#D84315" ;
    oa:editorialNote "The NeoCygexpa Regnum, named on the Historical Polities page only as what\nthe Cassiopeia Federation was a client of. Distinct from Cygexpa above, which\nthe timeline disbands in 7247." ;
    oa:hasSource src:eg-historical-polities ;
    oa:kind "meta-empire" ;
    oa:polityId "neocygexpa" ;
    oa:recordOrder 71 ;
    oa:uncertain false .
