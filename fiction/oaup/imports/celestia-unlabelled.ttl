# Arkab Prior Necklace

id:star-arkab-prior-necklace a oa:CelestiaStar, oa:Place, oa:Star ;
    skos:prefLabel "Arkab Prior Necklace" ;
    oa:sourceName "Arkab Prior Necklace" .

claim:celestia-star-arkab-prior-necklace-4c1894374fd9 a prov:Entity, oa:CelestiaLocationClaim, oa:LocationClaim ;
    prov:hadPrimarySource src:celestia-addons ;
    oa:about id:star-arkab-prior-necklace ;
    oa:canonical true ;
    oa:declinationDeg -44.45887 ;
    oa:distance value:celestia-star-arkab-prior-necklace-4c1894374fd9-distance ;
    oa:method oa:ImportedValue ;
    oa:rightAscensionDeg 290.6596 ;
    oa:sourceArchive "OAAddons11.zip" ;
    oa:sourceFile "abishopring.stc" .

value:celestia-star-arkab-prior-necklace-4c1894374fd9-distance a oa:QuantityValue ;
    qudt:numericValue 378.335 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-star-arkab-prior-necklace-mutual-progress-association a prov:Entity, oa:AffiliationClaim ;
    oa:about id:star-arkab-prior-necklace ;
    oa:canonical true ;
    oa:polity id:polity-mutual-progress-association .

claim:curation-star-arkab-prior-necklace a prov:Entity, oa:SystemCuration ;
    oa:about id:star-arkab-prior-necklace ;
    oa:editorialLabel "Arkab Prior Necklace" ;
    oa:hidden true ;
    oa:note "A megastructure of Arkab Prior B, declared in the add-on as though it were a star of its own and sharing that entry's position exactly. Hidden here because it is not a sun; it is recorded in worlds.yaml instead, bound with the rest of the system to the real catalogue star, which is where a structure orbiting a real object belongs." ;
    oa:uncertain false .

