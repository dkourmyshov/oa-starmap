@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Blackbody Cluster

id:world-blackbody-cluster a oa:Place, oa:World ;
    skos:prefLabel "Blackbody Cluster" ;
    oa:article <https://www.orionsarm.com/eg-article/460e786400389> ;
    oa:kind "volume" ;
    oa:labelsSystem false ;
    oa:note "Only loosely aligned with the Iota Network, and recorded as the Network's because for a polity that small the connection is most of what is known about either. Better described in the Network's own article, https://www.orionsarm.com/eg-article/657f880b851e1, than in its own." ;
    oa:uncertain false .

claim:location-world-blackbody-cluster a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460e786400389> ;
    oa:about id:world-blackbody-cluster ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg 35.2126 ;
    oa:derivation "Interpolated from the transcription of Anders Sandberg's maps, and extrapolated beyond the anchors around it. The article locates it as some 3,000 ly from Corona rather than from Sol, which this map cannot yet use: Corona is not among the places it holds. Two named objects and a separation would place this properly, as they did Sk'iiws'nnii." ;
    oa:directionErrorDeg 30.0 ;
    oa:distance value:location-world-blackbody-cluster-distance ;
    oa:distanceError value:location-world-blackbody-cluster-distance-error ;
    oa:knownDistanceConflict false ;
    oa:method oa:EditorialEstimate ;
    oa:rightAscensionDeg 67.307 .

value:location-world-blackbody-cluster-distance a oa:QuantityValue ;
    qudt:numericValue 2640.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

value:location-world-blackbody-cluster-distance-error a oa:QuantityValue ;
    qudt:numericValue 1200.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-blackbody-cluster-iota-network a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460e786400389> ;
    oa:about id:world-blackbody-cluster ;
    oa:canonical true ;
    oa:polity id:polity-iota-network ;
    oa:recordOrder 0 .

claim:event-world-blackbody-cluster-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/460e786400389> ;
    oa:about id:world-blackbody-cluster ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Arrived at." ;
    oa:precision oa:Exact ;
    oa:recordOrder 0 ;
    oa:yearAT 9167 .
