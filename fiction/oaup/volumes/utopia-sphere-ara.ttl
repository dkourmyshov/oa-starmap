@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Utopia Sphere (Ara)

id:world-utopia-sphere-ara a oa:Place, oa:World ;
    skos:prefLabel "Utopia Sphere (Ara)" ;
    oa:kind "polity_extent" ;
    oa:labelsSystem false ;
    oa:note "The only label the add-on writes for this polity. Named for Ara, where it falls, the polity's own name being taken by the polity." ;
    oa:uncertain false .

claim:location-world-utopia-sphere-ara a prov:Entity, oa:LocationClaim ;
    oa:about id:world-utopia-sphere-ara ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -55.3 ;
    oa:distance value:location-world-utopia-sphere-ara-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From OAEMPIRES.dsc, one of the Orion's Arm Celestia add-ons' location catalogues (OAAddons9, OALocationsv4; extracted to sources/derived/oa_dsc_locations.tsv). The label states a position and no extent: it carries the token radius of 2 that the add-on gives every empire label, so nothing here says how far the volume reaches." ;
    oa:rightAscensionDeg 261.75 .

value:location-world-utopia-sphere-ara-distance a oa:QuantityValue ;
    qudt:numericValue 700.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-utopia-sphere-ara-utopia-sphere a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-utopia-sphere-ara ;
    oa:canonical true ;
    oa:polity id:polity-utopia-sphere ;
    oa:recordOrder 0 .
