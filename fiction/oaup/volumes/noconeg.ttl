@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# NoCoNeg

id:world-noconeg a oa:Place, oa:World ;
    skos:prefLabel "NoCoNeg" ;
    oa:kind "volume" ;
    oa:labelsSystem false ;
    oa:note "Not a polity but a meme-set, and recorded as a region for that reason: Rufus \"remains nominally independent, although the hybrid NoCoNeg meme-set is gradually gaining ground there\", and Gritwald's leadership \"has more in common with NoCoNeg and even NoCoZo ideology\" while still a nominal member of the Negentropist Alliance. The anchor marks where the add-on draws that culture, not a border. Drawn with no affiliation, since it is by definition the ground between two of them. It is coloured as a variation on the Negentropy Alliance's own, which is where Krantor sat until this entry gave the meme-set somewhere to belong.\nThe two are 0.7 degrees apart on the sky and 1,680 ly apart in depth. That is not the usual objection to a shared colour: this is a memeticity rather than a territory, and it is expected to turn up at both ranges. What it does sit oddly with is the start -- the meme-set dates from the end of the Version War, when the Terragen Bubble did not reach as far as 2,800 ly." ;
    oa:uncertain false .

claim:location-world-noconeg a prov:Entity, oa:LocationClaim ;
    oa:about id:world-noconeg ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -58.5 ;
    oa:distance value:location-world-noconeg-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "The NOCONEG anchor in southOAEMPIRES.dsc, one of the Orion's Arm Celestia add-ons' location catalogues (OAAddons9, OALocationsv4; extracted to sources/derived/oa_dsc_locations.tsv). It sits 1.2 degrees from the Locality of Wolfra and 400 ly nearer, which is the part of the sky the add-on gives the Disarchy's neighbours generally." ;
    oa:rightAscensionDeg 207.0 .

value:location-world-noconeg-distance a oa:QuantityValue ;
    qudt:numericValue 2800.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-noconeg-noconeg a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-noconeg ;
    oa:canonical true ;
    oa:polity id:polity-noconeg ;
    oa:recordOrder 0 .
