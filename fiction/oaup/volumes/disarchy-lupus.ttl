@prefix claim: <https://dkourmyshov.github.io/oa-starmap/claim/> .
@prefix id: <https://dkourmyshov.github.io/oa-starmap/id/> .
@prefix oa: <https://dkourmyshov.github.io/oa-starmap/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix value: <https://dkourmyshov.github.io/oa-starmap/value/> .

# Disarchy (Lupus)

id:world-disarchy-lupus a oa:Place, oa:World ;
    skos:prefLabel "Disarchy (Lupus)" ;
    oa:kind "polity_extent" ;
    oa:labelsSystem false ;
    oa:note "The only label the add-on writes for this polity. Named for Lupus, where it falls, the polity's own name being taken by the polity." ;
    oa:uncertain false .

claim:location-world-disarchy-lupus a prov:Entity, oa:LocationClaim ;
    oa:about id:world-disarchy-lupus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:declinationDeg -45.5 ;
    oa:distance value:location-world-disarchy-lupus-distance ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:note "From OAEMPIRES.dsc, one of the Orion's Arm Celestia add-ons' location catalogues (OAAddons9, OALocationsv4; extracted to sources/derived/oa_dsc_locations.tsv). The label states a position and no extent: it carries the token radius of 2 that the add-on gives every empire label, so nothing here says how far the volume reaches." ;
    oa:rightAscensionDeg 214.5 .

value:location-world-disarchy-lupus-distance a oa:QuantityValue ;
    qudt:numericValue 3200.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

claim:affiliation-world-disarchy-lupus-disarchy a prov:Entity, oa:AffiliationClaim ;
    oa:about id:world-disarchy-lupus ;
    oa:canonical true ;
    oa:polity id:polity-disarchy ;
    oa:recordOrder 0 .
