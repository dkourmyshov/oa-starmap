    oa:nearName "Southern Coalsack" ;
    oa:rightAscensionDeg 192.5 .

value:location-world-googlehertz-virchdrome-distance a oa:QuantityValue ;
    qudt:numericValue 587.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

