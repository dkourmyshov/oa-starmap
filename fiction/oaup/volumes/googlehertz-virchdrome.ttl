# Googlehertz Virchdrome

id:world-googlehertz-virchdrome a oa:Place, oa:World ;
    skos:prefLabel "Googlehertz Virchdrome" ;
    oa:article <https://www.orionsarm.com/eg-article/46f96a821bb69> ;
    oa:extent value:world-googlehertz-virchdrome-extent ;
    oa:kind "volume" ;
    oa:labelsSystem false ;
    oa:note "Several thousand processing megastructures in and around the Southern Coalsack — the dark nebula in Crux, southern to distinguish it from the Northern Coalsack in Cygnus. So this is a volume and not a point: the nebula is at 12h 50m, -62d 30' and 180 pc, which is 587 ly, and 30 to 35 ly in radius, and the complex is drawn across the whole of it. In and around is the article's phrase, so 65 ly across is the nebula's own figure and may understate the reach of the thing built in it." ;
    oa:uncertain false .

value:world-googlehertz-virchdrome-extent a oa:QuantityValue ;
    qudt:numericValue 65.0 ;
    qudt:unit unit:LY ;
    oa:lexicalPrecision oa:ExactAsPrinted .

