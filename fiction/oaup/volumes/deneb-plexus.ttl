# Deneb Plexus

id:world-deneb-plexus a oa:Place, oa:World ;
    skos:prefLabel "Deneb Plexus" ;
    oa:article <https://www.orionsarm.com/eg-article/46490c433d4b1> ;
    oa:kind "volume" ;
    oa:labelsSystem false ;
    oa:note "518 star systems beyond the Aquila Rift, named for the brightest of them — Deneb, Alpha Cygni, at 1,412 ly. Bound to that star because it is what the volume is named and reckoned from, not because the Plexus is one system; the marker is a landmark for a region far larger than itself." ;
    oa:uncertain false .

claim:location-world-deneb-plexus a prov:Entity, oa:LocationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46490c433d4b1> ;
    oa:about id:world-deneb-plexus ;
    oa:canonical true ;
    oa:catalogueFromSource false ;
    oa:knownDistanceConflict false ;
    oa:method oa:DirectTranscription ;
    oa:starName "Deneb" .

claim:affiliation-world-deneb-plexus-cygexpa a prov:Entity, oa:AffiliationClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46490c433d4b1> ;
    oa:about id:world-deneb-plexus ;
    oa:canonical true ;
    oa:polity id:polity-cygexpa ;
    oa:recordOrder 0 .

claim:event-world-deneb-plexus-001 a prov:Entity, oa:EventClaim ;
    prov:hadPrimarySource <https://www.orionsarm.com/eg-article/46490c433d4b1> ;
    oa:about id:world-deneb-plexus ;
    oa:canonical true ;
    oa:eventKind oa:Visited ;
    oa:note "Reached by von Neumann probes in the early Age of Expansion." ;
    oa:precision oa:Between ;
    oa:recordOrder 0 ;
    oa:untilAT 2600 ;
    oa:yearAT 2100 .
