# Downloaded source catalogs — rebuild with `uv run oastarmap fetch`
raw/

# Orion's Arm source material, downloaded by hand. Untracked for the same reason
# as raw/ above: it is bulk upstream material the repo does not need to carry.
# Original URLs are recorded in the pipeline so the files can be fetched again.
sources/

# Text pulled out of anything in sources/ for reading. Untracked for the same
# reason as sources/ itself, and more so: an extraction is still somebody else's
# document, and one committed by accident is the easiest kind to leave lying
# around.
pipeline/*.txt

# Generated datasets — rebuild with `uv run oastarmap build`
web/public/data/*
!web/public/data/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
*.local

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
